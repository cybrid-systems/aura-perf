#!/bin/sh
# aura-perf - an optimization runtime for agents.
#
#   aura-perf [verb]
#
# The default verb is autotune. The command works from any directory: the
# repository root is resolved from this script's own path (symlinks are
# followed), so an installed copy in ~/.local/bin runs exactly the code a
# checkout runs.
#
# autotune and recheck take an optional spec path. Without one the
# built-in sum-scan example runs. With one, that file is the spec and
# the run stays in the caller's directory, so the spec can name the
# target program's own files (lib/..., out/...). The spec requires the
# runtime as (require "lib/perf/loop" all:); the repository root is put
# on AURA_PATH for the run.
#
# Needs an Aura nightly binary: the one installed by ./install.sh or
# `aura-perf install`, or AURA_BIN pointing at it. No virtualenv, no config
# file. No API key: the rule proposer is the default; LLM_API_KEY,
# LLM_BASE_URL and LLM_MODEL only add the optional model proposer.
set -eu

# ── where is the repository? ─────────────────────────────────────────
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname "$self")/$link ;;
  esac
done
ROOT=$(cd "$(dirname "$self")/.." && pwd)

usage() {
  cat <<'EOF'
aura-perf - an optimization runtime for agents

  aura-perf [verb] [spec]

  autotune   measure the target, mine hotspots, trial candidates in isolated
             worldlines, gate them, write out/report.txt and out/evidence.json
             (the default verb; exits 0 only when the intend is met).
             With a spec path, that file is the spec and the run stays in
             the caller's directory.
  recheck    re-apply the current intend and strategy genes to the saved run -
             no perf, no rebuild
  sysinfo    export this machine's inventory to out/sysinfo.txt and .json
  check      CPU, memory, disk, network and interrupt deltas (1 s sample)
  use        USE method: CPU/memory utilization and saturation, scheduler
             queues, PSI; reads /proc only (AURA_PERF_USE_SEC, default 1)
  sched      scheduler wakeup latency as values
             aura-perf sched --file out/sched-latency.txt
             aura-perf sched -- COMMAND [ARGS...]  (perf + permission)
  test       run the value-level tests, then the round tests (python3)
  judge      read a live bus round's result metrics as a judge peer
             AURA_PERF_BUS_WORKSPACE=N AURA_PERF_JUDGE_PCT=20 aura-perf judge
             AURA_PERF_JUDGE_APPLY=1 + AURA_PERF_JUDGE_AUTHORIZED=1
             also calls bus:keep / bus:rollback (attach-only)
  doctor     which evidence sources this machine can give, what is missing,
             and the exact install / permission command.  --install runs the
             missing package groups after a sudo -n precheck (never a prompt); --strict
             exits 4 unless the PMU tier is ready.
  profile    native perf profile of ANY process; needs no Aura and no LLM
             aura-perf profile --pid PID [--seconds N] [--out DIR]
             aura-perf profile --seconds N -- COMMAND [ARGS...]
  help       this text
  install    install the pinned Aura nightly if needed, then link this
             command into ~/.local/bin (or $PREFIX/bin)

Environment:
  AURA_BIN        the aura executable (default: the installed nightly,
                   then aura on PATH)
  AURA_PATH       where std/* lives (default: <aura prefix>/lib)
  AURA_PERF_CHECK_SEC   lengthen the check sample (default 1)
  PERF_BIN        a perf binary that can count task-clock (optional)
  LLM_API_KEY      the model proposer's key. With LLM_BASE_URL and
                   LLM_MODEL set too, autotune asks the model for
                   candidates from the profile; the same gate judges
                   them, and the model never keeps one. Unset, no call is
                   made. The key is written to no report and no file.
  LLM_BASE_URL     an OpenAI-compatible base, e.g. https://api.minimax.cn/v1
  LLM_MODEL        the model id, e.g. MiniMax-M3.1-Flash
  LLM_TIMEOUT      seconds per call (default 120)

An external spec is a normal Aura file. It names the target program, the
regions to time, the inputs, the oracle, the protected defines and the
catalog, and it calls (perf:autotune spec). It requires the runtime as
(require "lib/perf/loop" all:); the repository root is on AURA_PATH for
the run, and the worker is at $AURA_PERF_WORKER.
EOF
}

# ── find aura ────────────────────────────────────────────────────────
aura_bin() {
  if [ -n "${AURA_BIN:-}" ]; then printf '%s\n' "$AURA_BIN"; return 0; fi
  if [ -z "${AURA_PERF_NO_INSTALLED:-}" ] && [ -x "$ROOT/.aura/bin/aura" ]; then
    printf '%s\n' "$ROOT/.aura/bin/aura"; return 0
  fi
  if [ -z "${AURA_PERF_NO_INSTALLED:-}" ] && [ -f "$ROOT/.aura-bin" ]; then
    recorded=$(sed -n '1p' "$ROOT/.aura-bin")
    if [ -n "$recorded" ] && [ -x "$recorded" ]; then printf '%s\n' "$recorded"; return 0; fi
  fi
  if command -v aura >/dev/null 2>&1; then command -v aura; return 0; fi
  if [ -z "${AURA_PERF_NO_INSTALLED:-}" ] && [ -x "$HOME/.local/share/aura-perf/.aura/bin/aura" ]; then
    printf '%s\n' "$HOME/.local/share/aura-perf/.aura/bin/aura"; return 0
  fi
  if [ -x "$HOME/aura/bin/aura" ]; then printf '%s\n' "$HOME/aura/bin/aura"; return 0; fi
  return 1
}

install_nightly() {
  [ -n "${AURA_BIN:-}" ] && return 0
  if command -v aura >/dev/null 2>&1; then
    case "$(aura --version 2>/dev/null || true)" in
      *nightly*) return 0 ;;
    esac
  fi
  [ -x "$ROOT/.aura/bin/aura" ] && return 0
  printf 'installing pinned Aura nightly...\n' >&2
  cache_bin=$(AURA_VERSION=nightly sh "$ROOT/scripts/install-aura.sh") || {
    echo "aura-perf: nightly install failed" >&2
    exit 1
  }
  cache_root=$(dirname "$cache_bin")
  rm -rf "$ROOT/.aura"
  ln -sfn "$cache_root" "$ROOT/.aura"
  printf 'installed Aura: %s\n' "$ROOT/.aura/bin/aura" >&2
}

install_self() {
  install_nightly
  if [ -n "${AURA_BIN:-}" ] && [ -x "$AURA_BIN" ]; then
    printf '%s\n' "$AURA_BIN" > "$ROOT/.aura-bin"
  fi
  dest="${PREFIX:-$HOME/.local/bin}"
  mkdir -p "$dest"
  ln -sf "$ROOT/bin/aura-perf" "$dest/aura-perf"
  printf 'installed %s -> %s\n' "$dest/aura-perf" "$ROOT/bin/aura-perf"
  case ":$PATH:" in
    *":$dest:"*) ;;
    *) printf 'add %s to PATH to run aura-perf from anywhere\n' "$dest" ;;
  esac
}

cmd="${1:-autotune}"
[ $# -gt 0 ] && shift

# The optional spec path. autotune and recheck take one.
spec=""
case "$cmd" in
  autotune|run|recheck)
    if [ $# -gt 0 ]; then
      case "$1" in
        -*) ;;
        *) spec="$1"; shift ;;
      esac
    fi
    ;;
esac

case "$cmd" in
  help|-h|--help)
    usage
    exit 0
    ;;
  install)
    install_self
    exit 0
    ;;
  profile)
    exec sh "$ROOT/scripts/native-profile.sh" "$@"
    ;;
esac

AURA=$(aura_bin) || {
  echo "aura-perf: Aura nightly not found. Run 'aura-perf install' or set AURA_BIN." >&2
  exit 1
}
export AURA_BIN="$AURA"
# A source build keeps std/ in <repo>/lib; a release package in <prefix>/lib.
if [ -z "${AURA_PATH:-}" ]; then
  lib=$(dirname "$(dirname "$AURA")")/lib
  if [ -d "$lib" ]; then AURA_PATH="$lib"; export AURA_PATH; fi
fi
# The runtime is on the module search path, so an external spec can
# require it as (require "lib/perf/loop" all:).
AURA_PATH="$ROOT${AURA_PATH:+:$AURA_PATH}"
export AURA_PATH
AURA_PERF_WORKER="$ROOT/examples/sum-scan/worker.aura"
export AURA_PERF_WORKER
export AURA_SANDBOX=off

case "$cmd" in
  autotune|run)
    if [ -z "${PERF_BIN:-}" ]; then
      PERF_BIN="$(sh "$ROOT/scripts/find-perf.sh" 2>/dev/null || true)"
      if [ -n "$PERF_BIN" ]; then export PERF_BIN; fi
    fi
    if [ -n "$spec" ]; then
      # An external project: stay in the caller's directory, so the spec
      # can name the target program's own files.
      [ -f "$spec" ] || {
        echo "aura-perf: no such spec: $spec" >&2
        exit 1
      }
      mkdir -p out
      export AURA_EVO_LOG="${AURA_EVO_LOG:-$PWD/out/evo.jsonl}"
      exec "$AURA" --preset dev --grant exec "$spec"
    fi
    cd "$ROOT"
    mkdir -p out/jobs out/trials
    export AURA_EVO_LOG="${AURA_EVO_LOG:-$PWD/out/evo.jsonl}"
    exec "$AURA" --preset dev --grant exec examples/sum-scan/main.aura
    ;;
  recheck)
    if [ -n "$spec" ]; then
      mkdir -p out
      exec "$AURA" --preset dev --grant exec "$spec"
    fi
    cd "$ROOT"
    mkdir -p out
    exec "$AURA" --preset dev examples/sum-scan/recheck.aura
    ;;
  sysinfo)
    cd "$ROOT"
    mkdir -p out
    exec "$AURA" --preset dev --grant exec examples/sum-scan/sysinfo.aura
    ;;
  check)
    cd "$ROOT"
    mkdir -p out
    exec "$AURA" --preset dev --grant exec examples/sum-scan/check.aura
    ;;
  judge)
    cd "$ROOT"
    exec "$AURA" --preset dev "$ROOT/scripts/bus-judge.aura"
    ;;
  use)
    cd "$ROOT"
    exec "$AURA" --preset dev --grant exec "$ROOT/scripts/use.aura"
    ;;
  sched)
    exec sh "$ROOT/scripts/native-sched.sh" "$@"
    ;;
  doctor)
    cd "$ROOT"
    case "${1:-}" in
      --install) export AURA_PERF_DOCTOR_EXEC=1 ;;
      --strict) export AURA_PERF_DOCTOR_STRICT=1 ;;
      --install-strict) export AURA_PERF_DOCTOR_EXEC=1 AURA_PERF_DOCTOR_STRICT=1 ;;
    esac
    exec "$AURA" --preset dev --grant exec "$ROOT/scripts/doctor.aura"
    ;;
  test)
    cd "$ROOT"
    # Probe first so a named-let regression is named, then run every
    # test anyway. A real assertion failure is still a failure.
    set +e
    "$AURA" --preset dev tests/runtime_probe.aura >/tmp/aura-perf-probe.out 2>/tmp/aura-perf-probe.err
    probe=$?
    "$AURA" test
    rc=$?
    sh tests/exit_test.sh
    exit_rc=$?
    # aura-perf#28: the post-round host linger window. Self-skips when the
    # resolved Aura has no std/bus (the pinned nightly CI).
    linger_rc=0
    attach_rc=0
    llm_rc=0
    checksum_rc=0
    auto_probe_rc=0
    type_gate_rc=0
    candidate_set_rc=0
    headroom_rc=0
    screen_site_rc=0
    headroom_memory_rc=0
    engine_metrics_rc=0
    doctor_rc=0
    methodology_rc=0
    sched_cli_rc=0
    joint_rc=0
    if command -v python3 >/dev/null 2>&1; then
      python3 tests/bus_linger_test.py
      linger_rc=$?
      # aura-perf#27: attach-only mode against an external host bus.
      # Self-skips when the resolved Aura has no std/bus.
      python3 tests/bus_attach_test.py
      attach_rc=$?
      # aura-perf#29: the model proposer in a real round, against a
      # fake provider on localhost. No network, no key.
      python3 tests/llm_proposer_test.py
      llm_rc=$?
      # A fresh round whose first candidates fail (a checksum that does
      # not match, a slower pass) goes on to its next round.
      python3 tests/checksum_round_test.py
      checksum_rc=$?
      # A target that never wrote perf-worldline-measure gets a tree from
      # the runtime's auto-probe, in the trial and in the base measurement.
      python3 tests/auto_probe_worker_test.py
      auto_probe_rc=$?
      # A candidate that cannot typecheck is rejected in the parent; no
      # worker, no job file, no held-out sample.
      python3 tests/type_gate_round_test.py
      type_gate_rc=$?
      # One candidate may rewrite several defines; the set is one
      # worldline and the site floor sums its sites.
      python3 tests/candidate_set_round_test.py
      candidate_set_rc=$?
      # Each hot site's upper bound, measured by a stub in its own
      # worldline before the round spends its trial budget.
      python3 tests/headroom_round_test.py
      headroom_rc=$?
      # A site with no headroom is remembered; the next run skips its probe.
      python3 tests/headroom_memory_round_test.py
      headroom_memory_rc=$?
      # The cheap screen reads the candidate's site tree, not only the
      # whole kernel; a slow site is pruned without a held-out sample.
      python3 tests/screen_site_round_test.py
      screen_site_rc=$?
      # Every trial carries its compile/mutate/jit/arena delta as evidence.
      python3 tests/engine_metrics_round_test.py
      engine_metrics_rc=$?
      # Readiness is a value: missing perf degrades to the workspace probes,
      # and install / permission are explicit asks rather than prompts.
      python3 tests/doctor_test.py
      doctor_rc=$?
      # Scheduler wait and the held-out latency distribution ride on a
      # real round; both are evidence, neither changes the verdict.
      python3 tests/methodology_round_test.py
      methodology_rc=$?
      # perf sched latency parsing and the permission gate.
      python3 tests/sched_cli_test.py
      sched_cli_rc=$?
      # aura-perf#30: an agent that cannot boot leaves a report with
      # its log, not a cleanup traceback.
      python3 tests/joint_agent_absent_test.py
      joint_rc=$?
    fi
    set -e
    if [ "$rc" -ne 0 ]; then
      echo "aura-perf: aura test failed." >&2
      echo "aura build: ${AURA_PERF_BUILD:-unknown}" >&2
      echo "supported: Aura nightly (pinned by baseline/aura-baseline.json)" >&2
      if [ "$probe" -ne 0 ]; then
        echo "named-let reentrancy probe failed. Upstream: https://github.com/cybrid-systems/aura/issues/5116" >&2
        echo "An index-out-of-bounds error or a parser golden mismatch on this build is that regression, not an aura-perf parser bug." >&2
        cat /tmp/aura-perf-probe.err >&2 || true
        cat /tmp/aura-perf-probe.out >&2 || true
      fi
    fi
    if [ "$rc" -ne 0 ]; then
      exit "$rc"
    fi
    if [ "$linger_rc" -ne 0 ]; then
      exit "$linger_rc"
    fi
    if [ "$attach_rc" -ne 0 ]; then
      exit "$attach_rc"
    fi
    if [ "$llm_rc" -ne 0 ]; then
      exit "$llm_rc"
    fi
    if [ "$checksum_rc" -ne 0 ]; then
      exit "$checksum_rc"
    fi
    if [ "$auto_probe_rc" -ne 0 ]; then
      exit "$auto_probe_rc"
    fi
    if [ "$type_gate_rc" -ne 0 ]; then
      exit "$type_gate_rc"
    fi
    if [ "$candidate_set_rc" -ne 0 ]; then
      exit "$candidate_set_rc"
    fi
    if [ "$headroom_rc" -ne 0 ]; then
      exit "$headroom_rc"
    fi
    if [ "$headroom_memory_rc" -ne 0 ]; then
      exit "$headroom_memory_rc"
    fi
    if [ "$screen_site_rc" -ne 0 ]; then
      exit "$screen_site_rc"
    fi
    if [ "$engine_metrics_rc" -ne 0 ]; then
      exit "$engine_metrics_rc"
    fi
    if [ "$doctor_rc" -ne 0 ]; then
      exit "$doctor_rc"
    fi
    if [ "$methodology_rc" -ne 0 ]; then
      exit "$methodology_rc"
    fi
    if [ "$sched_cli_rc" -ne 0 ]; then
      exit "$sched_cli_rc"
    fi
    if [ "$joint_rc" -ne 0 ]; then
      exit "$joint_rc"
    fi
    exit "$exit_rc"
    ;;
  *)
    echo "unknown verb: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
