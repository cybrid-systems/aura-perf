; Target program and the strategy that tunes it.
; perf-strategy is workspace code. It does not read a report. It calls
; perf:mine on the CCT value the runtime just measured.
; Query procedures arrive in ctx. Naming perf:mine inside this
; workspace makes the trial typecheck reject the define, because
; that check does not see host bindings.

(define (k-length xs)
  (length xs))

(define (k-ref xs i)
  (list-ref xs i))

(define (bench-kernel xs)
  (let ((n (k-length xs)))
    (let loop ((i 0) (acc 0))
      (if (>= i n)
          acc
          (loop (+ i 1) (+ acc (k-ref xs i)))))))

; The worldline measurement. The runtime asks the target program for the
; tree of one worldline: the seed knows the arity of its own defines, so
; it can count the calls of the hot leaf and of its sibling, and it
; reports the rows. A target that does not implement this has no
; worldline tree, and the report says so.
;
; The rows carry the stack of each define, so the tree is the target's
; own calling shape and not a name the runtime guessed.
(define saved-k-ref k-ref)
(define saved-k-length k-length)

(define (perf-worldline-measure kernel xs)
  (let ((box (hash "k-ref" 0 "k-length" 0 "k-ref-ms" 0 "k-length-ms" 0)))
    (set! k-ref
      (lambda (a i)
        (let ((t0 (monotonic-ms)))
          (let ((v (saved-k-ref a i)))
            (hash-set! box "k-ref" (+ (hash-ref box "k-ref" 0) 1))
            (hash-set! box "k-ref-ms"
                           (+ (hash-ref box "k-ref-ms" 0) (- (monotonic-ms) t0)))
            v))))
    (set! k-length
      (lambda (a)
        (let ((t0 (monotonic-ms)))
          (let ((v (saved-k-length a)))
            (hash-set! box "k-length" (+ (hash-ref box "k-length" 0) 1))
            (hash-set! box "k-length-ms"
                           (+ (hash-ref box "k-length-ms" 0) (- (monotonic-ms) t0)))
            v))))
    (try (kernel xs) (catch (e) #f))
    (set! k-ref saved-k-ref)
    (set! k-length saved-k-length)
    (list (hash "name" "k-ref"
                "calls" (hash-ref box "k-ref" 0)
                "task-clock" (hash-ref box "k-ref-ms" 0)
                "stack" (list "bench-kernel" "k-ref"))
          (hash "name" "k-length"
                "calls" (hash-ref box "k-length" 0)
                "task-clock" (hash-ref box "k-length-ms" 0)
                "stack" (list "bench-kernel" "k-length")))))

(define (perf-strategy ctx)
  (let* ((mine (hash-ref ctx "mine"))
         (hotfn (hash-ref ctx "hot-child-fn"))
         (profile (hash-ref ctx "profile" (hash)))
         (mined (mine profile))
         (class (hash-ref mined "class" ""))
         (hot (let ((h (hash-ref mined "hot-node" "")))
                (if (string=? h "")
                    (hotfn profile)
                    h))))
    (hash "rank" "task-clock"
          "hotspot" hot
          "class" class
          "site" (hash-ref mined "site" "")
          "prefix" (hash-ref mined "prefix" '())
          "order" (if (or (string=? class "repeated-index-walk")
                          (string=? hot "k-ref"))
                      (list "specialize-k-ref" "wrong-scale"
                            "redundant-pass" "linear-scan")
                      (list "linear-scan"))
          "per-round" 2)))
