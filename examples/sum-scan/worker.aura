; One candidate, one process.
; AURA_PERF_JOB is a JSON file. The trial runs in a forked worldline
; (evo:trial). This process must be started with AURA_SANDBOX=off or the
; child workspace refuses mutate:rebind.

(require "std/evo-core" all:)
(require "std/string" all:)
(require "lib/perf/util" all:)
(require "lib/perf/score" all:)
(require "lib/perf/cct" all:)
(require "lib/perf/profile" all:)
(require "lib/perf/gate" all:)

(define (worker-fail why)
  (display why)
  (newline)
  (error why))

(define job-path (getenv "AURA_PERF_JOB"))

(if (or (not (string? job-path)) (string=? job-path ""))
    (worker-fail "AURA_PERF_JOB is unset")
    #t)

(define job (json-parse (perf:read-text job-path)))

(if (not (hash? job))
    (worker-fail "job json is not a hash")
    #t)

(define seed (perf:read-text (hash-ref job "seed" "")))
(if (string=? seed "")
    (worker-fail "seed text is empty")
    #t)

(set-code seed)
(eval-current)

(define target (hash-ref job "target" "bench-kernel"))
(define kernel-name (hash-ref job "kernel" target))
(define genome (hash-ref job "genome" ""))
(define ident (hash-ref job "id" "candidate"))
(define role (hash-ref job "role" "candidate"))
(define repeats (hash-ref job "repeats" 3))

; An empty genome is the un-rebound baseline: same child shape as a
; candidate, but mutate:rebind is not applied. The null candidate passes
; the target's own define text and does rebind.
(define (apply-candidate c)
  (let ((g (hash-ref c "genome" "")))
    (if (or (string=? role "baseline")
            (not (string? g))
            (string=? g ""))
        #t
        (let ((rb (mutate:rebind target g "perf-trial")))
          (if (eq? rb #t)
              (begin (eval-current) #t)
              rb)))))

(define (run-kernel xs)
  (let ((fn (try (eval (string->symbol kernel-name)) (catch (e) #f))))
    (if (procedure? fn)
        (fn xs)
        'perf-error)))

(define (baked-oracle cases)
  (lambda (xs)
    (let loop ((cs (if (list? cases) cases '())))
      (if (null? cs)
          'perf-missing
          (if (equal? (hash-ref (car cs) "input" #f) xs)
              (hash-ref (car cs) "expected" #f)
              (loop (cdr cs)))))))

(define (case-inputs cases)
  (let loop ((cs (if (list? cases) cases '())) (acc '()))
    (if (null? cs)
        (reverse acc)
        (loop (cdr cs) (cons (hash-ref (car cs) "input" '()) acc)))))

(define cand
  (evo:candidate genome
                 (hash "target" target "thought" ident)))

; Count callee entries on this worldline, then put the originals back
; so the held-out timing is the candidate itself.
(define (worldline-cct kernel xs root-ms)
  (let ((box (hash "k-ref" 0 "k-length" 0 "k-ref-ms" 0 "k-length-ms" 0))
        (saved-ref k-ref)
        (saved-len k-length))
    (set! k-ref (lambda (a i)
                  (let ((t0 (monotonic-ms)))
                    (let ((v (saved-ref a i)))
                      (hash-set! box "k-ref" (+ (hash-ref box "k-ref" 0) 1))
                      (hash-set! box "k-ref-ms"
                                 (+ (hash-ref box "k-ref-ms" 0) (- (monotonic-ms) t0)))
                      v))))
    (set! k-length (lambda (a)
                     (let ((t0 (monotonic-ms)))
                       (let ((v (saved-len a)))
                         (hash-set! box "k-length" (+ (hash-ref box "k-length" 0) 1))
                         (hash-set! box "k-length-ms"
                                    (+ (hash-ref box "k-length-ms" 0) (- (monotonic-ms) t0)))
                         v))))
    (try (kernel xs) (catch (e) #f))
    (set! k-ref saved-ref)
    (set! k-length saved-len)
    (perf:cct-build
      (perf:count-rows "bench-kernel" root-ms
                       (list (hash "name" "k-ref"
                                   "calls" (hash-ref box "k-ref" 0)
                                   "task-clock" (hash-ref box "k-ref-ms" 0)
                                   "stack" (list "bench-kernel" "k-ref"))
                             (hash "name" "k-length"
                                   "calls" (hash-ref box "k-length" 0)
                                   "task-clock" (hash-ref box "k-length-ms" 0)
                                   "stack" (list "bench-kernel" "k-length")))))))

(define (screen-result screen-ms cct fidelity heldout-ms mismatches samples)
  (hash "objectives" (hash "heldout-ms" heldout-ms)
        "constraints" (hash "checksum" mismatches)
        "behavior" (hash "mismatches" mismatches
                         "samples" samples
                         "fidelity" fidelity
                         "screen-ms" screen-ms
                         "cct" cct)))

(define (heldout-of)
  (let ((baked (hash-ref job "heldout" #f)))
    (if (and (hash? baked) (not (eq? (hash-ref baked "input" 'missing) 'missing)))
        (hash "input" (hash-ref baked "input" '())
              "oracle" (lambda (ys) (hash-ref baked "expected" #f)))
        (hash "input" (perf:range (hash-ref job "heldout-n" 0))
              "oracle" perf:sum-ref))))

(define (screen-of)
  (let ((baked (hash-ref job "screen" #f)))
    (if (and (hash? baked) (not (eq? (hash-ref baked "input" 'missing) 'missing)))
        (hash "input" (hash-ref baked "input" '())
              "oracle" (lambda (ys) (hash-ref baked "expected" #f)))
        (let ((n (hash-ref job "screen-n" 0)))
          (if (and (number? n) (> n 0))
              (hash "input" (perf:range n) "oracle" perf:sum-ref)
              #f)))))

(define (check-of)
  (let ((baked (hash-ref job "checks" #f)))
    (if (and (list? baked) (pair? baked))
        (perf:check-kernel run-kernel (case-inputs baked) (baked-oracle baked))
        (perf:check-kernel run-kernel (perf:check-inputs)))))

(define tr
  (evo:trial cand
             (hash "apply" apply-candidate
                   "timeout-ms" (hash-ref job "timeout-ms" 60000)
                   "evaluate"
                   (lambda (c)
                     (let ((chk (check-of)))
                       (if (> (hash-ref chk "mismatches" 1) 0)
                           (screen-result -1
                                          (hash "kind" "perf-cct" "nodes" '())
                                          "checksum" -1
                                          (hash-ref chk "mismatches")
                                          '())
                           (let* ((screen-spec (screen-of))
                                  (screen (if (not screen-spec)
                                              (hash "median" -1)
                                              (perf:time-checked 1 run-kernel
                                                                 (hash-ref screen-spec "input" '())
                                                                 (hash-ref screen-spec "oracle" perf:sum-ref))))
                                  (screen-ms (hash-ref screen "median" -1))
                                  (screen-xs (if screen-spec (hash-ref screen-spec "input" '()) '()))
                                  (cct (if (or (not screen-spec)
                                               (not (= (hash-ref job "count-defines" 0) 1)))
                                           (hash "kind" "perf-cct" "nodes" '())
                                           (worldline-cct run-kernel screen-xs screen-ms)))
                                  (hold (and (not (string=? role "null"))
                                             (not (string=? role "baseline"))
                                             (perf:screen-prune?
                                               (hash-ref job "screen-baseline-ms" -1)
                                               screen-ms
                                               (hash-ref job "screen-slack-ms" 5)))))
                             (if hold
                                 (screen-result screen-ms cct "screen-pruned" -1 0 '())
                                 (let* ((ho (heldout-of))
                                        (tm (perf:time-checked repeats run-kernel
                                                               (hash-ref ho "input" '())
                                                               (hash-ref ho "oracle" perf:sum-ref))))
                                   (screen-result screen-ms cct "held-out"
                                                  (hash-ref tm "median")
                                                  (hash-ref tm "mismatches")
                                                  (hash-ref tm "samples" '())))))))))))

(define objs (hash-ref tr "objectives" (hash)))
(define beh (hash-ref tr "behavior" (hash)))
(define constraints (hash-ref tr "constraints" (hash)))
(define mismatches (hash-ref beh "mismatches" (hash-ref constraints "checksum" -1)))
(define status (hash-ref tr "status" "error"))
(define checksum-ok
  (if (and (string=? status "ok") (number? mismatches) (= mismatches 0)) 1 0))

(define result
  (hash "id" ident
        "status" status
        "checksum-ok" checksum-ok
        "live-unchanged" (if (eq? (hash-ref tr "live-unchanged" #f) #t) 1 0)
        "trial-applied" (if (eq? (hash-ref tr "trial-applied" #f) #t) 1 0)
        "mismatches" (if (number? mismatches) mismatches -1)
        "heldout-ms" (hash-ref objs "heldout-ms" -1)
        "samples" (hash-ref beh "samples" '())
        "fidelity" (hash-ref beh "fidelity" "")
        "screen-ms" (hash-ref beh "screen-ms" -1)
        "cct" (hash-ref beh "cct" (hash "kind" "perf-cct" "nodes" '()))
        "dur-ms" (hash-ref tr "dur-ms" 0)
        "error" (let ((e (hash-ref tr "error" #f)))
                  (if (string? e) e ""))))

(perf:write-text (hash-ref job "result" "") (json-encode result))
(display ident)
(display " ")
(display status)
(newline)
