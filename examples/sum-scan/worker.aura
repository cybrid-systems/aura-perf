; One candidate, one process.
; AURA_PERF_JOB is a JSON file. The trial runs in a forked worldline
; (evo:trial). This process must be started with AURA_SANDBOX=off or the
; child workspace refuses mutate:rebind.

(require "std/evo-core" all:)
(require "std/string" all:)
(require "lib/perf/util" all:)
(require "lib/perf/score" all:)
(require "lib/perf/cct" all:)
(require "lib/perf/profile" all:)
(require "lib/perf/gate" all:)
(require "lib/perf/probe" all:)

(define (worker-fail why)
  (display why)
  (newline)
  (error why))

(define job-path (getenv "AURA_PERF_JOB"))

(if (or (not (string? job-path)) (string=? job-path ""))
    (worker-fail "AURA_PERF_JOB is unset")
    #t)

(define job (json-parse (perf:read-text job-path)))

(if (not (hash? job))
    (worker-fail "job json is not a hash")
    #t)

(define seed (perf:read-text (hash-ref job "seed" "")))
(if (string=? seed "")
    (worker-fail "seed text is empty")
    #t)

(set-code seed)
(eval-current)

(define target (hash-ref job "target" "bench-kernel"))
(define kernel-name (hash-ref job "kernel" target))
(define genome (hash-ref job "genome" ""))
(define ident (hash-ref job "id" "candidate"))
(define role (hash-ref job "role" "candidate"))
(define repeats (hash-ref job "repeats" 3))

; The defines the auto-probe may wrap. The spec's count-names wins; without
; one, every top-level define in the seed except the kernel and the runtime's
; own perf- helpers. The target's perf-worldline-measure, when present, is
; still the measurement that runs.
(define (probe-name? n)
  (and (not (string=? n kernel-name))
       (not (string-prefix? n "perf-"))
       (not (string-prefix? n "perf:"))))

(define probe-names
  (let ((named (hash-ref job "count-names" '())))
    (let loop ((xs (if (pair? named) named (perf:define-names seed)))
               (acc '()))
      (if (null? xs)
          (reverse acc)
          (loop (cdr xs)
                (if (and (string? (car xs)) (probe-name? (car xs)))
                    (cons (car xs) acc)
                    acc))))))

; Which measurement produced the worldline tree. "target" is the seed's own
; perf-worldline-measure; "auto-probe" is the runtime-generated fallback.
(define cct-source "none")

; An empty genome is the un-rebound baseline: same child shape as a
; candidate, but mutate:rebind is not applied. The null candidate passes
; the target's own define text and does rebind.
;
; The base of the site floor is measured HERE, before the rebind, in
; this process: the two sides of the site comparison then differ by the
; candidate and by nothing else. Two processes are two histories, and
; the histories move the numbers (the region timer is sensitive to the
; allocation history), so a base measured in another process can make a
; candidate that changes nothing look like a win on its own site.
;
; The base is measured with the target rebound to its OWN body, not
; un-rebound: a rebound define is called through a faster path, so an
; un-rebound base flatters every candidate (on the aura-redis GET path
; the same define measured 14 ms un-rebound and 5 ms rebound).
(define base-cct (hash "kind" "perf-cct" "nodes" '()))
(define null-genome (hash-ref job "null-genome" ""))

; A candidate may rewrite several defines. The job carries the full list;
; the single-target fields are the one-entry case, kept for older jobs and
; for the report.
(define mutations
  (let ((ms (hash-ref job "mutations" '())))
    (if (pair? ms)
        ms
        (list (hash "target" target "genome" genome)))))

(define null-mutations
  (let ((ms (hash-ref job "null-mutations" '())))
    (if (pair? ms)
        ms
        (if (and (string? null-genome) (> (string-length null-genome) 0))
            (list (hash "target" target "genome" null-genome))
            '()))))

(define (nonempty-mutations? ms)
  (let loop ((xs ms))
    (if (null? xs)
        #f
        (let ((g (hash-ref (car xs) "genome" "")))
          (if (and (string? g) (> (string-length g) 0))
              #t
              (loop (cdr xs)))))))

; Apply every mutation in one workspace edit. The caller evaluates once
; after the last rebind, so the worldline sees the set atomically.
(define (rebind-all ms tag)
  (let loop ((xs ms))
    (if (null? xs)
        #t
        (let* ((m (car xs))
               (t (hash-ref m "target" ""))
               (g (hash-ref m "genome" "")))
          (if (or (not (string? t)) (string=? t "")
                  (not (string? g)) (string=? g ""))
              (loop (cdr xs))
              (let ((rb (mutate:rebind t g tag)))
                (if (eq? rb #t)
                    (loop (cdr xs))
                    rb))))))) 

(define (measure-tree screen-xs screen-ms)
  (if (or (not (= (hash-ref job "count-defines" 0) 1))
          (null? screen-xs))
      (hash "kind" "perf-cct" "nodes" '())
      (worldline-cct run-kernel screen-xs screen-ms
                    (hash-ref job "kernel" "bench-kernel"))))

(define (screen-measure)
  (let* ((spec (screen-of))
         (xs (if spec (hash-ref spec "input" '()) '()))
         (screen (if (not spec)
                     (hash "median" -1)
                     (perf:time-checked 1 run-kernel
                                        (hash-ref spec "input" '())
                                        (hash-ref spec "oracle" perf:sum-ref))))
         (ms (hash-ref screen "median" -1)))
    (list xs ms)))

(define null-heldout-ms -1)

(define (measure-base)
  ; The null: the target rebound to its own body, measured in this
  ; process, so the gate's two numbers - the null's and the candidate's -
  ; come from the same process, in the same shape, and differ by the
  ; candidate and by nothing else. Across processes they differ by the
  ; machine's load and by the allocation history, which is worth more
  ; than the floor.
  ;
  ; The null is measured FIRST, before the candidate is applied. On a
  ; build with the LLVM JIT the first measurement in a process pays the
  ; warm-up (the JIT tiers up), so the null reads slower than the same
  ; code measured later and the floor flatters the candidate. The
  ; reference that does not have that bias is the null job's own
  ; measurement (a separate process, measured on its own); the runtime
  ; reports both: "null-candidate heldout-ms" (the job) and the
  ; candidate's "ref-ms" (this one).
  (if (null? null-mutations)
      #f
      (let ((rb (rebind-all null-mutations "perf-null-base")))
        (if (not (eq? rb #t))
            #f
            (begin
              (eval-current)
              (let* ((m (screen-measure))
                     (ho (heldout-of))
                     (tm (perf:time-checked repeats run-kernel
                                            (hash-ref ho "input" '())
                                            (hash-ref ho "oracle" perf:sum-ref))))
                (set! base-cct (measure-tree (car m) (cadr m)))
                (set! null-heldout-ms (hash-ref tm "median" -1))
                null-heldout-ms))))))

(define (apply-candidate c)
  (if (or (string=? role "baseline")
          (not (nonempty-mutations? mutations)))
      #t
      (begin
        ; The base of the site floor, in this process, in the same
        ; shape as the candidate's own measurement: every target is
        ; rebound to its own body first, then the candidate set is
        ; applied on top. One eval after the set, not one per define.
        (measure-base)
        (let ((rb (rebind-all mutations "perf-trial")))
          (if (eq? rb #t)
              (begin (eval-current) #t)
              rb)))))

(define (run-kernel xs)
  (let ((fn (try (eval (string->symbol kernel-name)) (catch (e) #f))))
    (if (procedure? fn)
        (fn xs)
        'perf-error)))

(define (baked-oracle cases)
  (lambda (xs)
    (let loop ((cs (if (list? cases) cases '())))
      (if (null? cs)
          'perf-missing
          (if (equal? (hash-ref (car cs) "input" #f) xs)
              (hash-ref (car cs) "expected" #f)
              (loop (cdr cs)))))))

(define (case-inputs cases)
  (let loop ((cs (if (list? cases) cases '())) (acc '()))
    (if (null? cs)
        (reverse acc)
        (loop (cdr cs) (cons (hash-ref (car cs) "input" '()) acc)))))

(define cand
  (evo:candidate genome
                 (hash "target" target "thought" ident)))

; The tree of one worldline. The target program measures it: the seed
; knows the arity of its own defines, so it can count the calls of the
; defines it wants in the tree and report the rows. The runtime only
; adds the root (the kernel it measured) and builds the tree.
;
; A seed that does not implement perf-worldline-measure has no worldline
; tree. The report then says measured=0, which is the truth: nothing was
; measured in that worldline.
(define (worldline-rows kernel xs)
  (let ((measure (try (eval (string->symbol "perf-worldline-measure"))
                      (catch (e) #f))))
    (if (procedure? measure)
        (begin
          (set! cct-source "target")
          (let ((rows (try (measure kernel xs) (catch (e) '()))))
            (if (list? rows) rows '())))
        (if (pair? probe-names)
            (let ((rows (try (perf:auto-worldline-measure kernel xs probe-names kernel-name)
                             (catch (e) '()))))
              (set! cct-source (if (and (list? rows) (pair? rows)) "auto-probe" "none"))
              (if (list? rows) rows '()))
            '()))))

; The spec may name the defines that belong in the tree. Without a
; list every row the seed reports is kept.
(define (count-row? row names)
  (if (pair? names)
      (perf:member? names (hash-ref row "name" ""))
      #t))

(define (worldline-cct kernel xs root-ms root-name)
  (let ((rows (let loop ((xs (worldline-rows kernel xs)) (acc '()))
                (if (null? xs)
                    (reverse acc)
                    (loop (cdr xs)
                          (if (count-row? (car xs) (hash-ref job "count-names" '()))
                              (cons (car xs) acc)
                              acc))))))
    (if (null? rows)
        (hash "kind" "perf-cct" "nodes" '())
        (perf:cct-build (perf:count-rows root-name root-ms rows)))))

(define (screen-result screen-ms cct fidelity heldout-ms mismatches samples)
  (hash "objectives" (hash "heldout-ms" heldout-ms)
        "constraints" (hash "checksum" mismatches)
        "behavior" (hash "mismatches" mismatches
                         "samples" samples
                         "fidelity" fidelity
                         "screen-ms" screen-ms
                         "cct" cct
                         ; The tree of the same process before the
                         ; rebind: the base of the site floor.
                         "base-cct" base-cct
                         ; The null's held-out, in the same process:
                         ; the reference the gate compares with.
                         "null-heldout-ms" null-heldout-ms)))

(define (heldout-of)
  (let ((baked (hash-ref job "heldout" #f)))
    (if (and (hash? baked) (not (eq? (hash-ref baked "input" 'missing) 'missing)))
        (hash "input" (hash-ref baked "input" '())
              "oracle" (lambda (ys) (hash-ref baked "expected" #f)))
        (hash "input" (perf:range (hash-ref job "heldout-n" 0))
              "oracle" perf:sum-ref))))

(define (screen-of)
  (let ((baked (hash-ref job "screen" #f)))
    (if (and (hash? baked) (not (eq? (hash-ref baked "input" 'missing) 'missing)))
        (hash "input" (hash-ref baked "input" '())
              "oracle" (lambda (ys) (hash-ref baked "expected" #f)))
        (let ((n (hash-ref job "screen-n" 0)))
          (if (and (number? n) (> n 0))
              (hash "input" (perf:range n) "oracle" perf:sum-ref)
              #f)))))

(define (check-of)
  (let ((baked (hash-ref job "checks" #f)))
    (if (and (list? baked) (pair? baked))
        (perf:check-kernel run-kernel (case-inputs baked) (baked-oracle baked))
        (perf:check-kernel run-kernel (perf:check-inputs)))))

(define tr
  (evo:trial cand
             (hash "apply" apply-candidate
                   "timeout-ms" (hash-ref job "timeout-ms" 60000)
                   "evaluate"
                   (lambda (c)
                     (let ((chk (check-of)))
                       (if (> (hash-ref chk "mismatches" 1) 0)
                           (screen-result -1
                                          (hash "kind" "perf-cct" "nodes" '())
                                          "checksum" -1
                                          (hash-ref chk "mismatches")
                                          '())
                           (let* ((screen-spec (screen-of))
                                  (screen (if (not screen-spec)
                                              (hash "median" -1)
                                              (perf:time-checked 1 run-kernel
                                                                 (hash-ref screen-spec "input" '())
                                                                 (hash-ref screen-spec "oracle" perf:sum-ref))))
                                  (screen-ms (hash-ref screen "median" -1))
                                  (screen-xs (if screen-spec (hash-ref screen-spec "input" '()) '()))
                                  (hold (and (not (string=? role "null"))
                                             (not (string=? role "baseline"))
                                             (perf:screen-prune?
                                               (hash-ref job "screen-baseline-ms" -1)
                                               screen-ms
                                               (hash-ref job "screen-slack-ms" 5)))))
                             ; The worldline tree is measured after the
                             ; timing, never between the checksum and
                             ; the timing: the target's own measurement
                             ; installs its wrappers around the hot
                             ; defines, and a program that has been
                             ; measured that way must not be the program
                             ; whose result is compared.
                             (if hold
                                 (let ((cct (if (or (not screen-spec)
                                                   (not (= (hash-ref job "count-defines" 0) 1)))
                                               (hash "kind" "perf-cct" "nodes" '())
                                               (worldline-cct run-kernel screen-xs screen-ms
                                                             (hash-ref job "kernel" "bench-kernel")))))
                                   (screen-result screen-ms cct "screen-pruned" -1 0 '()))
                                 (let* ((ho (heldout-of))
                                        (tm (perf:time-checked repeats run-kernel
                                                               (hash-ref ho "input" '())
                                                               (hash-ref ho "oracle" perf:sum-ref)))
                                        (cct (if (or (not screen-spec)
                                                     (not (= (hash-ref job "count-defines" 0) 1)))
                                                 (hash "kind" "perf-cct" "nodes" '())
                                                 (worldline-cct run-kernel screen-xs screen-ms
                                                                   (hash-ref job "kernel" "bench-kernel")))))
                                   (screen-result screen-ms cct "held-out"
                                                  (hash-ref tm "median")
                                                  (hash-ref tm "mismatches")
                                                  (hash-ref tm "samples" '())))))))))))

(define objs (hash-ref tr "objectives" (hash)))
(define beh (hash-ref tr "behavior" (hash)))
(define constraints (hash-ref tr "constraints" (hash)))
(define mismatches (hash-ref beh "mismatches" (hash-ref constraints "checksum" -1)))
(define status (hash-ref tr "status" "error"))
(define checksum-ok
  (if (and (string=? status "ok") (number? mismatches) (= mismatches 0)) 1 0))

(define result
  (hash "id" ident
        "status" status
        "checksum-ok" checksum-ok
        "live-unchanged" (if (eq? (hash-ref tr "live-unchanged" #f) #t) 1 0)
        "trial-applied" (if (eq? (hash-ref tr "trial-applied" #f) #t) 1 0)
        "mismatches" (if (number? mismatches) mismatches -1)
        "heldout-ms" (hash-ref objs "heldout-ms" -1)
        "samples" (hash-ref beh "samples" '())
        "fidelity" (hash-ref beh "fidelity" "")
        "screen-ms" (hash-ref beh "screen-ms" -1)
        "cct" (hash-ref beh "cct" (hash "kind" "perf-cct" "nodes" '()))
        "cct-source" cct-source
        "base-cct" (hash-ref beh "base-cct" (hash "kind" "perf-cct" "nodes" '()))
        "null-heldout-ms" (hash-ref beh "null-heldout-ms" -1)
        "dur-ms" (hash-ref tr "dur-ms" 0)
        "error" (let ((e (hash-ref tr "error" #f)))
                  (if (string? e) e ""))))

(perf:write-text (hash-ref job "result" "") (json-encode result))
(display ident)
(display " ")
(display status)
(newline)
