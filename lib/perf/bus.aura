; bus.aura — aura-perf on the Aura bus (#5128, aura-perf#10).
;
; The perf parent owns the seed workspace, so it HOSTS the bus (#5121's
; process model: the coordinator is the workspace owner, not a daemon)
; and attaches as the perf peer (role 1). CCT, hotspots, hypotheses and
; verdicts go to the bus channels and the shared audit; KEEP runs the
; coordinator's constraint gate — a rejection downgrades the verdict to
; ROLLBACK, there is no local bypass. Workers stay on the internal job
; exchange (that is one tool's own mechanics); the bus is the inter-tool
; main path: after perf detaches, the host keeps serving for a linger
; window (default 60s, AURA_PERF_BUS_LINGER_S or the spec's "bus" hash
; "linger-s"), so harness or maintainer can attach and query the same
; audit and image. The coordinator lives in this process: when the window
; closes (or stdin reaches EOF) the host unhosts and the round exits.
;
; Enabled by the spec's "bus" hash ("workspace" N) or the environment
; AURA_PERF_BUS_WORKSPACE=N. Without either, every function is a no-op
; and the round runs exactly as before.
;
; Channel mapping (the image carries immediates, not text):
;   cct      one record per profile name, published in stack order so
;            parent indices point backward; mid = the rolling name hash
;            below (31-multiplier, mod 999999937, fits the low 62 bits);
;            node = -1 (no node index); samples = calls;
;            self-ns = self-ms * 1e6. A hypothesis adds a mark record
;            with mid = hash(candidate id), samples = 1.
;   metrics  hypothesis key K (1, 2, ... per round) -> the base-ms the
;            candidate must beat; the report line names K <-> id.
;            Summary keys: 900001 -> before-ms, 900002 -> after-ms.
;   worldlines  one bus:trial per trialable candidate; the gate verdict
;            is bus:keep (value = heldout-ms) or bus:rollback.
;   patches  at finish, bus:project-patches then bus:project-worldlines
;            project the round's real committed mutations (order matters:
;            patches first, so worldline records carry patch ranges).

(require "std/bus" all:)
(require "std/string" all:)
(require "lib/perf/query" all:)

; Self-contained reporter: the bus module must not depend on loop.aura
; (loop requires this module). Same buf shape perf:say uses.
(define (perf:bus-say buf line)
  (if (hash? buf)
      (hash-set! buf "lines" (cons line (hash-ref buf "lines" '())))
      #f))

(export perf:bus-start perf:bus-publish-profile perf:bus-hypothesis
        perf:bus-trial perf:bus-verdict perf:bus-finish perf:bus-mid
        perf:bus-workspace perf:bus-linger-seconds perf:bus-linger
        perf:bus-host-enabled? perf:bus-propose perf:bus-propose-multi
        perf:bus-subscribe-signals perf:bus-define-nodes)

(define (perf:bus-workspace spec)
  (let ((cfg (hash-ref spec "bus" (hash))))
    (let ((ws (hash-ref cfg "workspace" 0)))
      (if (and (number? ws) (> ws 0))
          ws
          (let ((env (getenv "AURA_PERF_BUS_WORKSPACE")))
            (if (and (string? env) (> (string-length env) 0))
                (let ((n (string->number env)))
                  (if (and (number? n) (> n 0)) n 0))
                0))))))

; The CCT mid: a rolling hash of the define name. Small enough to stay
; a legal immediate, stable across tools and rounds.
(define (perf:bus-mid name)
  (let ((h 0) (i 0) (n (string-length name)))
    (while (lambda () (< i n))
      (lambda ()
        (set! h (modulo (+ (* h 31) (string-ref name i)) 999999937))
        (set! i (+ i 1))))
    h))

; Attach-only (aura-perf#27): the workspace is hosted by an external tool
; (aura-redis). Enabled when the spec's "bus" hash "host" is #f OR
; AURA_PERF_BUS_HOST=0. perf then only ATTACHES, with caps read|publish|
; trial (7): it mines signals and proposes candidates, it never holds
; keep/rollback/constraint-write — the judge decides.
(define (perf:bus-host-enabled? spec)
  (let ((env (getenv "AURA_PERF_BUS_HOST")))
    (if (and (string? env) (string=? env "0"))
        #f
        (not (eq? (hash-ref (hash-ref spec "bus" (hash)) "host" #t) #f)))))

; Host + attach + project the workspace nodes, or attach-only to the
; external host. Returns the bus handle (a hash) or #f; says why on
; failure. Self-host caps: read|publish|trial|keep|rollback (31) — perf
; ACCEPTS constraints, it does not write them. Attach-only caps: 7.
(define (perf:bus-start spec buf)
  (let ((ws (perf:bus-workspace spec)))
    (if (<= ws 0)
        #f
        (let ((host? (perf:bus-host-enabled? spec)))
          (let ((h (if host? (bus:host ws) (list "ok"))))
            (if (not (bus:ok? h))
                (begin
                  (perf:bus-say buf (string-append "bus host-failed " (bus:message h)))
                  #f)
                (let ((s (bus:attach "" ws 1 (if host? 31 7) 255)))
                  (if (not (bus:ok? s))
                      (begin
                        (perf:bus-say buf (string-append "bus attach-failed " (bus:message s)))
                        #f)
                      (let ((sid (car (cdr s))))
                        (if host? (bus:project-nodes sid) #f)
                        (perf:bus-say buf (string-append "bus attached ws=" (number->string ws)
                                                     " role=perf session=" (number->string sid)
                                                     " mode=" (if host? "self-host" "attach-only")
                                                     " caps=" (number->string (list-ref s 3))))
                        (hash "session" sid "workspace" ws "key" 1
                              "host" host? "caps" (list-ref s 3) "buf" buf
                              ; The workspace generation the host reported.
                              ; A fresh host has KEPT nothing: baseline 0;
                              ; each live KEEP advances it by one. The host
                              ; may publish its current value under the
                              ; spec's "bus" hash "baseline" key.
                              "baseline" (hash-ref (hash-ref spec "bus" (hash))
                                                   "baseline" 0)))))))))))

; Unique names in stack order (callers before callees), so a parent's
; batch index is always backward.
(define (perf:bus-stack-order spots)
  (let loop ((xs spots) (acc '()))
    (if (null? xs)
        acc
        (loop (cdr xs)
              (let inner ((ys (hash-ref (car xs) "stack" '())) (a acc))
                (if (null? ys)
                    a
                    (inner (cdr ys)
                           (if (member (car ys) a) a (append a (list (car ys)))))))))))

; Publish the profile's CCT, one record per name in stack order.
; Returns the number of accepted records.
(define (perf:bus-publish-profile bus profile)
  (if (not bus)
      0
      (let* ((sid (hash-ref bus "session"))
             (spots (perf:hotspots profile))
             (names (perf:bus-stack-order spots))
             (index (lambda (name)
                      (let loop ((xs names) (i 0))
                        (cond ((null? xs) -1)
                              ((string=? (car xs) name) i)
                              (else (loop (cdr xs) (+ i 1)))))))
             (spot-of (lambda (name)
                        (let loop ((xs spots))
                          (cond ((null? xs) (hash))
                                ((string=? (hash-ref (car xs) "name" "") name) (car xs))
                                (else (loop (cdr xs))))))))
        (let loop ((xs names) (ok 0))
          (if (null? xs)
              ok
              (let* ((name (car xs))
                     (h (spot-of name))
                     (stack (hash-ref h "stack" '()))
                     (parent-name (if (>= (length stack) 2)
                                      (list-ref stack (- (length stack) 2))
                                      ""))
                     (parent (if (string=? parent-name "") -1 (index parent-name)))
                     (r (bus:publish-cct sid parent (perf:bus-mid name) -1
                                         (hash-ref h "calls" 0)
                                         (* (hash-ref h "self-ms" 0) 1000000))))
                (loop (cdr xs) (+ ok (if (bus:ok? r) 1 0)))))))))

; One hypothesis: metric key K -> base-ms to beat, plus a CCT mark for
; the candidate id. Returns K (or -1).
(define (perf:bus-hypothesis bus cand base-ms)
  (if (not bus)
      -1
      (let* ((sid (hash-ref bus "session"))
             (key (hash-ref bus "key"))
             (id (hash-ref cand "id" "?"))
             (v (if (and (number? base-ms) (>= base-ms 0)) base-ms 0))
             (r (bus:publish sid key v)))
        (hash-set! bus "key" (+ key 1))
        (bus:publish-cct sid -1 (perf:bus-mid id) -1 1 0)
        (if (bus:ok? r) key -1))))

; Open a worldline for one candidate trial. Returns the id or -1.
(define (perf:bus-trial bus)
  (if (not bus)
      -1
      (let ((r (bus:trial (hash-ref bus "session") 1)))
        (if (bus:ok? r) (car (cdr r)) -1))))

; Report a failed bus step without crashing (aura-perf#27): loan-exhausted,
; image-full, constraint-rejected and host disconnects are records, not
; exceptions. Returns the record's code (or "no-bus").
(define (perf:bus-report bus buf what r)
  ; A string result is a local refusal ("unknown target ..."): show it,
  ; do not collapse it into the old opaque "no-bus" line.
  (if (bus:record? r)
      (let ((code (bus:code r))
            (msg (bus:message r)))
        (perf:bus-say buf (string-append "bus " what " failed: "
                                     (if (string? code) code "?")
                                     (if (and (string? msg) (> (string-length msg) 0))
                                         (string-append " (" msg ")") "")))
        code)
      (let ((text (if (string? r) r "no-bus")))
        (perf:bus-say buf (string-append "bus " what " failed: " text))
        "no-bus")))

; Propose a pure-policy candidate to the host's judge (aura-perf#27,
; aura#5378/#5379). Opens a trial on the patches channel, publishes the
; candidate define source as a source-carrier patch naming the target
; define node, computes the coordinator's candidate digest and binds the
; five-tuple evidence: baseline = the workspace generation the host
; reported (0 for a fresh host that has KEPT nothing), candidate = digest,
; workload/seed/verifier nonzero. perf does NOT keep: the loan stays
; outstanding with the pending worldline and the judge decides; a
; disconnect (or crash) lets the coordinator roll it back. Returns the
; worldline id, or -1 with a report line on failure.
(define (perf:bus-propose bus node source workload seed verifier)
  (if (not bus)
      -1
      (let* ((sid (hash-ref bus "session"))
             (buf (hash-ref bus "buf" #f))
             (tr (bus:trial sid 3)))
        (if (not (bus:ok? tr))
            (begin (perf:bus-report bus buf "trial" tr) -1)
            (let ((wl (car (cdr tr))))
              (let ((src (bus:publish-source sid source)))
                (if (not (bus:ok? src))
                    (begin (perf:bus-report bus buf "publish-source" src)
                           ; caps 7 holds no rollback bit: detach/exit lets
                           ; the coordinator withdraw the pending trial.
                           -1)
                    (let ((patch (bus:publish-patch sid node bus:source-field
                                                    (car (cdr src)) wl 0)))
                      (if (not (bus:ok? patch))
                          (begin (perf:bus-report bus buf "publish-patch" patch)
                                 ; no rollback bit (caps 7); coordinator reclaims
                                 -1)
                          (let ((d (bus:candidate-digest sid wl)))
                            (if (not (bus:ok? d))
                                (begin (perf:bus-report bus buf "candidate-digest" d)
                                       ; no rollback bit (caps 7); coordinator reclaims
                                       -1)
                                (let ((ev (bus:bind-evidence sid wl
                                                             (hash-ref bus "baseline" 0)
                                                             (car (cdr d))
                                                             workload seed verifier)))
                                  (if (not (bus:ok? ev))
                                      (begin (perf:bus-report bus buf "bind-evidence" ev)
                                             ; no rollback bit (caps 7); coordinator reclaims
                                             -1)
                                      (begin
                                        (perf:bus-say buf (string-append
                                                            "bus-proposed wl=" (number->string wl)
                                                            " node=" (number->string node)
                                                            " pending (judge decides)"))
                                        wl))))))))))))))

; The host's live define names and their node ids (aura#5397). The node
; ids belong to the host's own workspace AST, so a peer that wants to
; rewrite a named function asks the host instead of guessing an id.
; Returns a hash of name -> node, or #f when the host does not publish
; them (an older host).
(define (perf:bus-define-nodes bus)
  (if (not bus)
      #f
      (let* ((sid (hash-ref bus "session"))
             (d (bus:defines sid)))
        (if (not (bus:ok? d))
            #f
            (let ((rows (list-ref d 3)))
              (let loop ((xs rows) (acc (hash)))
                (if (null? xs)
                    acc
                    (begin
                      (hash-set! acc (car (car xs)) (car (cdr (car xs))))
                      (loop (cdr xs) acc)))))))))

; Propose a candidate that rewrites SEVERAL pure policy functions at once
; (aura#5397): the target set is a list of (name body) pairs, and every
; function becomes one source-carrier patch in the SAME worldline. The
; host's KEEP applies the set atomically: one broken body anywhere in
; the set leaves every function byte-identical.
;
; The node ids come from the host (bus:defines), so the proposer never
; guesses a host-local id. Returns the worldline id, or -1 with a report
; line on failure.
(define (perf:bus-propose-multi bus targets workload seed verifier)
  (if (not bus)
      -1
      (if (null? targets)
          -1
          (let* ((sid (hash-ref bus "session"))
                 (buf (hash-ref bus "buf" #f))
                 (nodes (perf:bus-define-nodes bus))
                 (tr (bus:trial sid 3)))
            (if (not (bus:ok? tr))
                (begin (perf:bus-report bus buf "trial" tr) -1)
                (if (not nodes)
                    (begin (perf:bus-report bus buf "defines" "the host does not publish its define names")
                           -1)
                    (let ((wl (car (cdr tr))))
                      (let loop ((xs targets) (ok #t))
                        (if (or (not ok) (null? xs))
                            (if (not ok) -1 wl)
                            (let* ((name (car (car xs)))
                                   (body (car (cdr (car xs))))
                                   (node (hash-ref nodes name -1)))
                              (if (< node 0)
                                  (begin (perf:bus-report bus buf "publish-patch"
                                                         (string-append "unknown target " name))
                                         (loop (cdr xs) #f))
                                  (let ((src (bus:publish-source sid body)))
                                    (if (not (bus:ok? src))
                                        (begin (perf:bus-report bus buf "publish-source" src)
                                               (loop (cdr xs) #f))
                                        (let ((patch (bus:publish-patch sid node bus:source-field
                                                                (car (cdr src)) wl 0)))
                                          (if (not (bus:ok? patch))
                                              (begin (perf:bus-report bus buf "publish-patch" patch)
                                                     (loop (cdr xs) #f))
                                              (loop (cdr xs) #t))))))))))))))))

; Consume the host's signals (aura-perf#27): subscribe the metrics
; channel, query its latest rows, and read the CCT hotspots aggregate.
; Returns the metrics rows ((key value) ...), or '() with a report line
; when the host is gone or the read fails.
(define (perf:bus-subscribe-signals bus buf)
  (if (not bus)
      '()
      (let* ((sid (hash-ref bus "session"))
             (sub (bus:subscribe sid 1)))
        (if (not (bus:ok? sub))
            (begin (perf:bus-report bus buf "subscribe" sub) '())
            (let ((q (bus:query sid 1 0 0)))
              (if (not (bus:ok? q))
                  (begin (perf:bus-report bus buf "query-metrics" q) '())
                  (let ((rows (list-ref q 4))
                        (hs (bus:hotspots sid 5)))
                    (if (bus:ok? hs)
                        (perf:bus-say buf (string-append
                                            "bus signals metrics=" (number->string (length rows))
                                            " hotspots=" (number->string (car (cdr hs)))))
                        (perf:bus-report bus buf "hotspots" hs))
                    rows)))))))

; The verdict. In self-host mode KEEP runs the coordinator's current
; constraint set; a rejection is reported, never bypassed. Returns
; "kept", "rolled", "constraint-rejected: <why>", or "no-bus". In
; attach-only mode (caps 7) perf holds no keep/rollback bit: the verdict
; is the judge's, so the worldline is left pending and "proposed" is
; returned (aura-perf#27).
(define (perf:bus-verdict bus wl pass heldout-ms)
  (if (or (not bus) (< wl 0))
      "no-bus"
      (if (not (hash-ref bus "host" #t))
          "proposed"
          (let ((sid (hash-ref bus "session")))
            (if pass
                (let ((r (bus:keep sid wl 0
                                   (if (and (number? heldout-ms) (>= heldout-ms 0))
                                       heldout-ms 0))))
                  (if (bus:ok? r)
                      "kept"
                      (string-append "constraint-rejected: " (bus:message r))))
                (begin (bus:rollback sid wl) "rolled"))))))

; Summary metrics, the real mutation projections, then detach. The
; coordinator rolls back whatever this session left pending (the delivered
; disconnect semantics). In self-host mode the host lives in this process
; and keeps serving until perf:bus-linger's window closes (aura-perf#28);
; in attach-only mode the external host keeps serving and the judge keeps
; the pending proposals perf left (aura-perf#27).
(define (perf:bus-finish bus buf before-ms after-ms)
  (if (not bus)
      #f
      (let ((sid (hash-ref bus "session")))
        (let ((p1 (bus:publish sid 900001 (if (and (number? before-ms) (>= before-ms 0)) before-ms 0)))
              (p2 (bus:publish sid 900002 (if (and (number? after-ms) (>= after-ms 0)) after-ms 0))))
          ; A gone host (disconnect) or a full image is reported, not fatal:
          ; the round's file report is already the human-facing evidence.
          (if (not (bus:ok? p1)) (perf:bus-report bus buf "publish-summary" p1) #f)
          (if (not (bus:ok? p2)) (perf:bus-report bus buf "publish-summary" p2) #f))
        (bus:project-patches sid)
        (bus:project-worldlines sid)
        (let ((a (bus:audit sid 0)))
          (perf:bus-say buf (string-append "bus audit-events "
                                       (number->string (if (bus:ok? a) (car (cdr a)) -1))
                                       " ws=" (number->string (hash-ref bus "workspace")))))
        (bus:detach sid)
        (perf:bus-say buf (if (hash-ref bus "host" #t)
                              "bus detached (host lingers for harness/maintainer)"
                              "bus detached (external host keeps serving; pending proposals await the judge)")))))

; The post-round serve window (aura-perf#28). The coordinator is this
; process, so the bus only outlives the round while the process stays up.
; Precedence: AURA_PERF_BUS_LINGER_S, then the spec's "bus" hash "linger-s",
; then 60 seconds. 0 disables the window (the round exits right after the
; report, the pre-#28 behavior).
(define (perf:bus-linger-seconds spec)
  (let* ((env (getenv "AURA_PERF_BUS_LINGER_S"))
         (n (if (and (string? env) (> (string-length env) 0))
                (string->number env)
                #f)))
    (if (and (number? n) (>= n 0))
        n
        (let ((cfg (hash-ref spec "bus" (hash))))
          (let ((s (hash-ref cfg "linger-s" 60)))
            (if (and (number? s) (>= s 0)) s 60))))))

; Serve the bus after the report is written: harness/maintainer attach and
; query the round's committed evidence. Returns when the window expires or
; stdin reaches EOF (a supervising runner closes stdin to end the window
; early); then unhosts. A bus-less round is a no-op. The poll granularity is
; ~50ms; char-ready? sees hangup as readable, and read-line then reports EOF.
(define (perf:bus-linger bus spec buf)
  (if (or (not bus) (not (hash-ref bus "host" #t)))
      ; Attach-only (aura-perf#27): the host is another process; perf has
      ; already detached and there is nothing here to serve or unhost.
      #f
      (let ((secs (perf:bus-linger-seconds spec))
            (ws (hash-ref bus "workspace")))
        (if (<= secs 0)
            (begin
              (bus:unhost ws)
              (perf:bus-say buf "bus host closed (linger 0s, exit after report)")
              (display "bus host closed (linger 0s, exit after report)") (newline)
              #f)
            (let ((deadline (+ (monotonic-ms) (* secs 1000))))
              (perf:bus-say buf (string-append "bus host serving ws=" (number->string ws)
                                               " linger-s=" (number->string secs)
                                               " (EOF on stdin ends the window)"))
              (display "bus host serving ws=") (display ws)
              (display " linger-s=") (display secs)
              (display " (EOF on stdin ends the window)") (newline)
              (let loop ()
                (if (char-ready?)
                    (if (eof-object? (read-line))
                        #f
                        (loop))
                    (if (< (monotonic-ms) deadline)
                        (begin (shell "sleep 0.05") (loop))
                        #f)))
              (bus:unhost ws)
              (perf:bus-say buf "bus host closed (linger window ended)")
              (display "bus host closed (linger window ended)") (newline))))))
