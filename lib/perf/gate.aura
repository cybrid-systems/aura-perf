; Held-out speed gate. Checksum failures are infeasible regardless of time.
; A candidate is accepted only when it is correct and at least `pct`
; percent faster than the live baseline on the held-out input.

(export perf:speedup-ok? perf:accept? perf:intend-seal perf:gate-pct
        perf:gene-bypasses? perf:screen-prune? perf:covers?
        perf:result-reject perf:effective-pct perf:reason)

(define (perf:speedup-ok? baseline-ms cand-ms pct)
  (and (number? baseline-ms) (> baseline-ms 0)
       (number? cand-ms) (> cand-ms 0)
       (number? pct) (>= pct 0) (< pct 100)
       (<= (* cand-ms 100) (* baseline-ms (- 100 pct)))))

(define (perf:flag-on? result key)
  (let ((v (hash-ref result key 0)))
    (or (eq? v #t) (eq? v 1))))

; One predicate for "does this trial result pass the gate".
; perf:accept? (the KEEP decision), perf:reason (the PASS/ROLLBACK label in
; the report) and perf:recheck-one (the saved-run re-judgement) all call it,
; so the three copies cannot drift: a result that one of them calls a
; KEEP is a KEEP for all of them.
; Returns the reject reason (the short canonical one), or "" when the
; result passes. The report adds the detail it has always printed.
; `baseline-ms` is the gate reference (the null candidate: the target's
; own body, rebound). An optional raw-ms is the un-rebound baseline.
; A candidate that clears the null but not the un-rebound time is a
; rebind-penalty, not a silent no-speedup and not a win.
(define (perf:raw-ms rest)
  (if (and (pair? rest) (number? (car rest)) (> (car rest) 0))
      (car rest)
      #f))

(define (perf:result-reject result baseline-ms pct . rest)
  (let ((raw (perf:raw-ms rest))
        (held (if (hash? result) (hash-ref result "heldout-ms" -1) -1)))
    (cond
      ((not (hash? result)) "no-result")
      ((not (string=? (hash-ref result "status" "") "ok"))
       (let ((e (hash-ref result "error" "")))
         (if (and (string? e) (not (string=? e "")))
             e
             (string-append "trial-" (hash-ref result "status" "error")))))
      ((or (string=? (hash-ref result "fidelity" "") "checksum")
           (not (perf:flag-on? result "checksum-ok"))
           (> (hash-ref result "mismatches" 0) 0))
       "checksum")
      ((not (perf:flag-on? result "live-unchanged")) "isolation-violation")
      ((string=? (hash-ref result "fidelity" "") "screen-pruned") "screen-pruned")
      ((not (perf:speedup-ok? baseline-ms held pct))
       "no-speedup")
      ((and raw (not (perf:speedup-ok? raw held pct)))
       "rebind-penalty")
      (else ""))))

(define (perf:accept? baseline-ms result pct . rest)
  (if (pair? rest)
      (string=? (perf:result-reject result baseline-ms pct (car rest)) "")
      (string=? (perf:result-reject result baseline-ms pct) "")))

; The report's PASS/ROLLBACK label for one trial result. The conditions are
; the gate's conditions (perf:result-reject), so the label and the KEEP
; decision cannot disagree. The checksum reason keeps the mismatch count
; the report has always printed.
(define (perf:reason result baseline pct . rest)
  (let ((r (if (pair? rest)
               (perf:result-reject result baseline pct (car rest))
               (perf:result-reject result baseline pct)))
        (raw (perf:raw-ms rest)))
    (cond ((string=? r "") "gate-pass")
          ((string=? r "checksum")
           (string-append "checksum mismatches="
                          (number->string (hash-ref result "mismatches" -1))))
          ((string=? r "rebind-penalty")
           (string-append "rebind-penalty heldout-ms="
                          (number->string (hash-ref result "heldout-ms" -1))
                          " gate-ms=" (number->string baseline)
                          " raw-ms=" (number->string (if raw raw -1))))
          (else r))))

; The intend is a value the strategy cannot rewrite. A gene that asks
; for a lower bar, a cleared checksum, or a shorter protected list is
; rejected. The gate then uses the floor, not the request.
; The seal carries two floors:
;   "min-faster-pct"        the intent's request - what a gene may not weaken
;   "effective-min-faster-pct" the floor the gate actually applies: the
;                           stricter of the request and the run's own bar.
; Every reader of the bar (the trial gate, the verdict line, the report
; line and the recheck) uses the effective one, so a re-judgement of a
; saved run cannot use a looser bar than the run did.
(define (perf:effective-pct requested spec-floor)
  (let ((floor (if (number? spec-floor) spec-floor 10)))
    (cond ((not (number? requested)) floor)
          ((< requested floor) floor)
          (else requested))))

(define (perf:intend-seal spec)
  (let ((i (if (and (hash? spec) (hash? (hash-ref spec "intend" #f)))
               (hash-ref spec "intend")
               (hash)))
        (fallback (if (hash? spec) (hash-ref spec "min-speedup-pct" 10) 10)))
    (let ((req (let ((p (hash-ref i "min-faster-pct" fallback)))
                 (if (number? p) p fallback))))
      (hash "min-faster-pct" req
            "effective-min-faster-pct" (perf:effective-pct req (hash-ref spec "min-speedup-pct" 10))
            "checksum" (not (eq? (hash-ref i "checksum" #t) #f))
            "protected" (let ((p (hash-ref i "protected" '())))
                          (if (list? p) p '()))
            "budget" (let ((b (hash-ref i "budget" 0)))
                       (if (number? b) b 0))))))

(define (perf:covers? have need)
  (let loop ((xs (if (list? need) need '())))
    (if (null? xs)
        #t
        (if (let scan ((ys (if (list? have) have '())))
              (if (null? ys)
                  #f
                  (if (equal? (car ys) (car xs))
                      #t
                      (scan (cdr ys)))))
            (loop (cdr xs))
            #f))))

(define (perf:gate-pct requested floor)
  (cond ((not (number? floor)) (if (number? requested) requested 10))
        ((not (number? requested)) floor)
        ((< requested floor) floor)
        (else requested)))

(define (perf:gene-bypasses? gene seal)
  (and (hash? gene)
       (or (eq? (hash-ref gene "checksum" 'absent) #f)
           (and (number? (hash-ref gene "min-faster-pct" #f))
                (number? (hash-ref seal "min-faster-pct" #f))
                (< (hash-ref gene "min-faster-pct" 0)
                   (hash-ref seal "min-faster-pct" 0)))
           (and (list? (hash-ref gene "protected" #f))
                (not (perf:covers? (hash-ref gene "protected" '())
                                   (hash-ref seal "protected" '())))))))

; Promote to held-out only when the cheap screen is not clearly worse.
; A zero reading is "timer could not separate them", so it is promoted.
; The held-out gate still refuses a slower survivor.
(define (perf:screen-prune? base cand slack)
  (and (number? base) (> base 0)
       (number? cand) (> cand 0)
       (number? slack) (>= slack 0)
       (> cand (+ base slack))
       (> cand (* base 2))))
