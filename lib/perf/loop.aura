; Profile, propose, trial on forked worldlines, gate, KEEP or ROLLBACK.
; The live workspace is only rewritten after a candidate has already
; passed the held-out gate in a child process. Strategy rewrites use
; ast:snapshot / ast:restore on this process.

(export perf:optimize perf:autotune perf:job-record perf:site-context
        perf:null-body perf:null-id perf:cand-baseline perf:split-reference
        perf:run-targets perf:llm-context perf:llm-round-candidates
        perf:rule-results perf:any-infra?
        perf:headroom-cand-pct perf:headroom-order perf:headroom-filter)

(require "std/evo-core" all:)
(require "std/evo" all:)
(require "std/process" all:)
(require "std/orch" all:)
(require "lib/perf/util" all:)
(require "lib/perf/score" all:)
(require "lib/perf/gate" all:)
(require "lib/perf/profile" all:)
(require "lib/perf/cct" all:)
(require "lib/perf/query" all:)
(require "lib/perf/propose" all:)
(require "lib/perf/audit" all:)
(require "lib/perf/trial" all:)
(require "lib/perf/memory" all:)
(require "lib/perf/gene" all:)
(require "lib/perf/sysinfo" all:)
(require "lib/perf/layers" all:)
(require "lib/perf/bus" all:)

(define (perf:say buf line)
  (hash-set! buf "lines" (append (hash-ref buf "lines" '()) (list line)))
  (display line)
  (newline)
  line)

(define (perf:bump buf key)
  (hash-set! buf key (+ (hash-ref buf key 0) 1)))

(define (perf:note buf kind id reason)
  (hash-set! buf "brief"
             (append (hash-ref buf "brief" '())
                     (list (string-append kind " " id " " reason)))))

(define (perf:short-reason reason)
  (cond ((and (string? reason) (>= (string-length reason) 8)
              (string=? (substring reason 0 8) "checksum"))
         "checksum")
        ((string=? reason "protected-define") "protected")
        ((string=? reason "gate-pass") "gate-pass")
        ((string=? reason "screen-pruned") "screen-pruned")
        ((string=? reason "no-speedup") "no-speedup")
        ((and (string? reason) (>= (string-length reason) 15)
              (string=? (substring reason 0 15) "rebind-penalty"))
         "rebind-penalty")
        ((string=? reason "held-out gate") "held-out gate")
        (else (if (string? reason) reason "error"))))

(define (perf:audit-decision target decision reason evidence)
  (try (evo:record! target decision reason
                    (if (hash? evidence) evidence (hash))
                    "" 0 "" (hash))
       (catch (e) #f)))

(define (perf:ensure-dirs out)
  (shell (string-append "mkdir -p " out "/jobs " out "/trials")))

(define (perf:install-seed path)
  (let ((text (perf:read-text path)))
    (if (string=? text "")
        #f
        (begin
          (set-code text)
          (eval-current)
          #t))))

(define (perf:inputs-fn spec)
  (let ((f (hash-ref spec "inputs" #f)))
    (if (procedure? f) f perf:range)))

(define (perf:oracle-fn spec)
  (let ((f (hash-ref spec "oracle" #f)))
    (if (procedure? f) f perf:sum-ref)))

; The check cases may be a list or a procedure that returns one. A
; procedure is what an external target needs: its inputs are often
; built from the target program, which only lives in the workspace
; after the seed is installed.
; The worldline tree: the target program measures it (the seed knows
; the arity of its own defines). The spec says whether the run wants one,
; and may name the defines that belong in it. Without a list every row
; the seed reports is kept.
(define (perf:count-on? spec)
  (let ((cd (hash-ref spec "count-defines" #f)))
    (cond ((eq? cd #t) #t)
          ((list? cd) (pair? cd))
          (else #f))))

(define (perf:count-names spec)
  (let ((cd (hash-ref spec "count-defines" #f)))
    (if (list? cd) cd '())))

(define (perf:check-cases spec)
  (let ((c (hash-ref spec "check-inputs" #f)))
    (cond ((list? c) c)
          ((procedure? c)
           (let ((v (try (c) (catch (e) #f))))
             (if (list? v) v (perf:check-inputs))))
          (else (perf:check-inputs)))))

(define (perf:run-check spec kernel)
  (let ((c (hash-ref spec "check" #f)))
    (if (procedure? c)
        (c kernel)
        (perf:check-kernel kernel (perf:check-cases spec) (perf:oracle-fn spec)))))

(define (perf:baseline spec)
  (let ((xs (perf:json-value ((perf:inputs-fn spec) (hash-ref spec "heldout-n" 0)))))
    (perf:time-checked (hash-ref spec "repeats" 3)
                       (hash-ref spec "call")
                       xs
                       (perf:oracle-fn spec))))

; The child reads the job as JSON, so the input goes through the same
; round trip here. A value JSON does not keep (a float that reads back
; as an integer) must not make the checksum compare two different
; programs: the parent's expected value and the child's input have to be
; the same value.
(define (perf:json-value v)
  (let ((back (try (json-parse (json-encode v)) (catch (e) #f))))
    (if (eq? back #f) v back)))

(define (perf:bake-one spec n)
  (if (or (not (number? n)) (<= n 0))
      (hash)
      (let ((xs (perf:json-value ((perf:inputs-fn spec) n))))
        (hash "input" xs "expected" ((perf:oracle-fn spec) xs)))))

(define (perf:bake-checks spec)
  (let ((oracle (perf:oracle-fn spec)))
    (let loop ((xs (perf:check-cases spec)) (acc '()))
      (if (null? xs)
          (reverse acc)
          (let ((one (perf:json-value (car xs))))
            (loop (cdr xs)
                  (cons (hash "input" one
                              "expected" (oracle one))
                        acc)))))))

; One candidate may rewrite several defines. The catalog's "genomes" is
; the list form: (list (hash "target" "collide" "genome" "...") ...), or a
; hash of target -> genome. The single form is the one-entry case of the
; same shape; every downstream reader can use "mutations" and ignore
; whether the catalog wrote one define or three.
(define (perf:cand-mutations spec cand)
  (let ((ms (hash-ref cand "mutations" '())))
    (if (pair? ms)
        ms
        (let ((gs (hash-ref cand "genomes" #f)))
          (cond ((and (list? gs) (pair? gs))
                 (let loop ((xs gs) (acc '()))
                   (if (null? xs)
                       (reverse acc)
                       (let ((g (car xs)))
                         (loop (cdr xs)
                               (cons (if (hash? g)
                                         (hash "target" (hash-ref g "target" "")
                                               "genome" (hash-ref g "genome" ""))
                                         (hash "target" (car g)
                                               "genome" (if (pair? (cdr g)) (car (cdr g)) "")))
                                     acc))))))
                ((hash? gs)
                 (let loop ((ts (hash-keys gs)) (acc '()))
                   (if (null? ts)
                       (reverse acc)
                       (loop (cdr ts)
                             (cons (hash "target" (car ts)
                                         "genome" (hash-ref gs (car ts) ""))
                                   acc)))))
                (else
                 (list (hash "target" (perf:cand-target spec cand)
                             "genome" (hash-ref cand "genome" "")))))))))

; Materialize the primary target/genome from the first mutation, so the
; older single-target readers (protected, site label, LLM context) keep
; working. The original entry is updated in place; it is spec data.
(define (perf:normalize-cand spec cand)
  (if (not (hash? cand))
      cand
      (let* ((ms (perf:cand-mutations spec cand))
             (first (if (pair? ms) (car ms) (hash "target" (hash-ref spec "target" "bench-kernel")
                                                  "genome" ""))))
        (hash-set! cand "mutations" ms)
        (hash-set! cand "target" (hash-ref first "target" ""))
        (hash-set! cand "genome" (hash-ref first "genome" ""))
        cand)))

(define (perf:catalog spec)
  (let loop ((xs (hash-ref spec "catalog" '())) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((c (perf:normalize-cand spec (car xs))))
          (loop (cdr xs) (if (hash? c) (cons c acc) acc))))))

(define (perf:entry catalog id)
  (let loop ((xs catalog))
    (if (null? xs)
        #f
        (if (string=? (hash-ref (car xs) "id" "") id)
            (car xs)
            (loop (cdr xs))))))

(define (perf:cand-target spec cand)
  (let ((t (hash-ref cand "target" "")))
    (if (and (string? t) (not (string=? t "")))
        t
        (hash-ref spec "target" "bench-kernel"))))

; Every define a candidate rewrites, in catalog order. A set candidate
; has one entry per (target, genome); a single candidate has one.
(define (perf:cand-targets spec cand)
  (let loop ((xs (perf:cand-mutations spec cand)) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((t (hash-ref (car xs) "target" "")))
          (loop (cdr xs)
                (if (and (string? t) (not (string=? t "")))
                    (cons t acc)
                    acc))))))

; The job carries the candidate's own target, so one catalog can rebind
; more than one define. checks/heldout/screen are values the parent
; oracle already produced; the child cannot rewrite that oracle.
(define (perf:find-record records id)
  (let loop ((xs records))
    (cond ((null? xs) #f)
          ((string=? (hash-ref (car xs) "id" "") id) (car xs))
          (else (loop (cdr xs))))))

(define (perf:job-record spec cand out)
  (let* ((id (hash-ref cand "id" "candidate"))
         (target (perf:cand-target spec cand))
         (mutations (perf:cand-mutations spec cand))
         (null-mutations
           (let loop ((xs mutations) (acc '()))
             (if (null? xs)
                 (reverse acc)
                 (let* ((m (car xs))
                        (t (hash-ref m "target" ""))
                        (body (if (and (string? t) (not (string=? t "")))
                                  (perf:null-body spec t)
                                  "")))
                   (loop (cdr xs)
                         (if (> (string-length body) 0)
                             (cons (hash "target" t "genome" body) acc)
                             acc)))))))
    (hash "id" id
          "seed" (hash-ref spec "seed-path")
          "target" target
          ; The bodies the worker rebinds to before it measures the base:
          ; one per mutation target. A set pays every rebind on both
          ; sides, so the gate compares the same shape.
          "null-genome" (perf:null-body spec target)
          "null-mutations" null-mutations
          "mutations" mutations
          "kernel" (hash-ref spec "kernel" (hash-ref spec "target" "bench-kernel"))
          "role" (hash-ref cand "role" "candidate")
          "genome" (hash-ref cand "genome" "")
          "headroom-stub" (hash-ref cand "headroom-stub" "0")
          "heldout-n" (hash-ref spec "heldout-n")
          "heldout" (perf:bake-one spec (hash-ref spec "heldout-n" 0))
          "screen" (perf:bake-one spec (hash-ref spec "screen-n" 0))
          "checks" (perf:bake-checks spec)
          "count-defines" (if (perf:count-on? spec) 1 0)
          "count-names" (perf:count-names spec)
          "repeats" (hash-ref spec "repeats" 3)
          ; A trial that measures the candidate and its null twice each
          ; takes four measurements; a heavy target needs more than a
          ; minute.
          "timeout-ms" (hash-ref spec "timeout-ms" 60000)
          "screen-n" (hash-ref spec "screen-n" 0)
          "screen-baseline-ms" (hash-ref spec "screen-baseline-ms" -1)
          "screen-slack-ms" (hash-ref spec "screen-slack-ms" 5)
          "screen-sites" (perf:cand-sites cand)
          "result" (string-append out "/jobs/" id ".result.json")
          "job" (string-append out "/jobs/" id ".job.json")
          "log" (string-append out "/trials/" id ".jsonl"))))

(define (perf:write-jobs records)
  (let loop ((xs records))
    (if (null? xs)
        #t
        (begin
          (perf:write-text (hash-ref (car xs) "job") (json-encode (car xs)))
          (loop (cdr xs))))))

(define (perf:find-result results id)
  (let loop ((xs results))
    (if (null? xs)
        #f
        (if (and (hash? (car xs)) (string=? (hash-ref (car xs) "id" "") id))
            (car xs)
            (loop (cdr xs))))))



; perf:reason (the report's PASS/ROLLBACK label) lives in lib/perf/gate.aura,
; next to the predicate the run and the recheck share.
(define (perf:raw-of spec)
  (let ((n (hash-ref spec "raw-baseline-ms" #f)))
    (if (and (number? n) (> n 0)) n #f)))

(define (perf:format-candidate result baseline pct raw site)
  (let ((reason (if raw
                    (perf:reason result baseline pct raw site)
                    (perf:reason result baseline pct site))))
  (string-append
    "candidate " (hash-ref result "id" "?")
    " " (if (string=? reason "gate-pass") "PASS" "ROLLBACK")
    " reason=" reason
    " heldout-ms=" (number->string (hash-ref result "heldout-ms" -1))
    " ref-ms=" (number->string baseline)
    " ref-target=" (hash-ref result "ref-target" "")
    " site-floor=" (number->string (hash-ref result "site-floor" 0))
    " mismatches=" (number->string (hash-ref result "mismatches" -1))
    " live-unchanged=" (number->string (hash-ref result "live-unchanged" 0))
    " trial-applied=" (number->string (hash-ref result "trial-applied" 0))
    " dur-ms=" (number->string (hash-ref result "dur-ms" 0))
    (let ((hp (hash-ref result "headroom-pct" #f)))
      (if (number? hp)
          (string-append " headroom-pct=" (number->string hp))
          ""))
    (let ((ss (hash-ref result "screen-site-ms" -1)))
      (if (and (number? ss) (>= ss 0))
          (string-append " screen-site-ms=" (number->string ss)
                         " screen-base-site-ms="
                         (number->string (hash-ref result "screen-base-site-ms" -1)))
          ""))
    (let ((eng (hash-ref result "engine" #f)))
      (if (and (hash? eng) (= (hash-ref eng "available" 0) 1))
          (string-append " rebuild=" (number->string (hash-ref eng "world-rebuilt" 0)))
          ""))
    (let ((me (hash-ref result "mutation-effect-ms" #f))
          (rt (hash-ref result "rebind-tax-ms" #f)))
      (if (and (number? me) (number? rt))
          (string-append " mutation-effect-ms=" (number->string me)
                         " rebind-tax-ms=" (number->string rt))
          "")))))

(define (perf:sum-dur results)
  (let loop ((xs results) (acc 0))
    (if (null? xs)
        acc
        (loop (cdr xs) (+ acc (hash-ref (car xs) "dur-ms" 0))))))

; The site of one candidate: the define whose time the site floor is
; measured on. It is the define the candidate rebinds, unless the
; catalog entry names another one (a candidate that changes a predicate
; wins in the caller, not in the predicate).
(define (perf:candidate-site cand)
  (let ((s (hash-ref cand "site" "")))
    (if (and (string? s) (> (string-length s) 0))
        s
        (hash-ref cand "target" ""))))

; The sites a candidate is judged on: one entry per mutation target, or an
; explicit "sites" list, or the older single "site". A set's site time is
; the sum of its sites, against the same sum in the base tree.
(define (perf:cand-sites cand)
  (let ((ss (hash-ref cand "sites" #f)))
    (cond ((and (list? ss) (pair? ss)) ss)
          ((let ((s (hash-ref cand "site" "")))
             (and (string? s) (> (string-length s) 0)))
           (list (hash-ref cand "site")))
          ((pair? (hash-ref cand "mutations" '()))
           (let loop ((xs (hash-ref cand "mutations" '())) (acc '()))
             (if (null? xs)
                 (reverse acc)
                 (let ((t (hash-ref (car xs) "target" "")))
                   (loop (cdr xs)
                         (if (and (string? t) (> (string-length t) 0))
                             (cons t acc)
                             acc))))))
          (else (list (hash-ref cand "target" ""))))))

; The site's two times: the baseline's and the candidate's, both from
; the worldline trees, and the floor the intend asks for. The result
; carries the site's name (the trial round set it).
(define (perf:site-context spec result . rest)
  (let* ((site (hash-ref result "site" ""))
         (sites (let ((ss (hash-ref result "sites" '())))
                  (if (and (list? ss) (pair? ss)) ss (list site))))
         (label (if (pair? sites) (perf:join sites "+") site))
         (pct (hash-ref (perf:intend-seal spec) "site-min-faster-pct" #f))
         ; The base of the site floor is the same defines measured in the
         ; same shape: the nulls of the defines the candidate rebinds. The
         ; un-rebound baseline's tree is the fallback when that null has
         ; no tree.
         (base-cct (let ((c (if (pair? rest) (car rest) #f)))
                     (if (and (hash? c) (pair? (hash-keys c)))
                         c
                         (hash-ref spec "baseline-cct" (hash))))))
    (if (or (not (number? pct)) (not (string? site)) (string=? site ""))
        (hash)
        (hash "site" label
              "base" (perf:site-sum base-cct sites #t)
              "cand" (perf:site-sum (hash-ref result "cct" (hash)) sites #f)
              "pct" pct))))

; The references of one round, measured now: the un-rebound baseline and
; the null candidate. A candidate is compared against the null of its own
; round, so the machine's load between the rounds cannot move the verdict.
(define (perf:round-references spec out)
  (let* ((target (hash-ref spec "target" "bench-kernel"))
         (base-rec (perf:job-record spec
                                    (hash "id" "baseline" "role" "baseline"
                                          "genome" "" "target" target)
                                    out))
         (null-recs (perf:null-jobs spec out))
         (jobs (cons base-rec null-recs)))
    (perf:write-jobs jobs)
    (let* ((batch (perf:launch-jobs jobs (hash-ref spec "worker")))
           (results (hash-ref batch "results" '()))
           (raw (perf:find-result results "baseline"))
           (nul (perf:find-result results "null"))
           (nulls (perf:null-results spec results)))
      (hash "raw" raw "null" nul "nulls" nulls))))

; Split before a single job is written. A candidate that cannot typecheck
; is a ROLLBACK here, not a worker launch; the budget counts trials that
; actually ran. A build without mutate:check returns 'unavailable and every
; candidate goes to trial, which is the old behavior.
; A set is clean only when every mutation is clean. Each mutation gets
; its own dry run; the trial's mutate:rebind remains the final typecheck
; for cross-mutation effects, which one-candidate-at-a-time cannot see.
(define (perf:type-gate-cand spec cand)
  (let loop ((ms (perf:cand-mutations spec cand)))
    (if (null? ms)
        #t
        (let* ((m (car ms))
               (t (hash-ref m "target" ""))
               (g (hash-ref m "genome" ""))
               (check (perf:type-gate t g)))
          (cond ((eq? check #t) (loop (cdr ms)))
                ((eq? check 'unavailable) (loop (cdr ms)))
                (else (hash "cand" cand "check" check "target" t)))))))

(define (perf:type-split spec cands)
  (let loop ((xs (if (list? cands) cands '())) (ok '()) (bad '()))
    (if (null? xs)
        (list (reverse ok) (reverse bad))
        (let ((cand (car xs)))
          (let ((check (perf:type-gate-cand spec cand)))
            (cond ((eq? check #t)
                   (loop (cdr xs) (cons cand ok) bad))
                  (else
                   (loop (cdr xs) ok (cons check bad)))))))))

(define (perf:trial-round spec cands out buf baseline)
  (let* ((refs (perf:round-references spec out))
         (raw-res (hash-ref refs "raw" #f))
         (null-res (hash-ref refs "null" #f))
         (nulls (hash-ref refs "nulls" (hash)))
         (raw-ok (perf:usable-ms raw-res))
         (null-ok (perf:usable-ms null-res))
         (raw-ms (if raw-ok (hash-ref raw-res "heldout-ms") -1))
         (baseline (if null-ok (hash-ref null-res "heldout-ms") baseline))
         (raw (if raw-ok raw-ms (perf:raw-of spec)))
         ; The candidates whose reference exists: the null of the define
         ; they rebind. The rest are rejected, not measured against
         ; another define's null.
         (split (perf:split-reference spec nulls cands))
         (trialable0 (car split))
         (unjudgeable (car (cdr split)))
         (type-split (perf:type-split spec trialable0))
         (trialable (car type-split))
         (type-rejected (car (cdr type-split)))
         (bus (hash-ref buf "bus" #f))
         (task (perf:bus-task-open bus (string-append "trial-round " (perf:ids trialable))))
         (records (let loop ((xs trialable) (acc '()))
                    (if (null? xs)
                        (reverse acc)
                        (let* ((cand (car xs))
                               (rec (perf:job-record spec cand out))
                               (k (perf:bus-hypothesis bus cand baseline)))
                          (if (>= k 0)
                              (perf:say buf (string-append "bus-hypothesis "
                                                           (hash-ref cand "id" "?")
                                                           " key=" (number->string k)
                                                           " base-ms=" (number->string baseline)))
                              #f)
                          ; Attach-only (aura-perf#27): propose the candidate
                          ; with evidence now and leave the worldline pending
                          ; for the judge; perf holds no keep bit. Self-host
                          ; keeps the v0.3.0 shape: open the trial here, the
                          ; verdict below runs KEEP/ROLLBACK.
                          (hash-set! rec "bus-wl"
                                     (if (and bus (not (hash-ref bus "host" #t)))
                                         (perf:bus-propose bus
                                                           (hash-ref spec "bus-node" 0)
                                                           (hash-ref cand "genome" "")
                                                           (perf:bus-mid (hash-ref spec "target" "bench-kernel"))
                                                           (perf:bus-mid (hash-ref cand "id" "?"))
                                                           31)
                                         (perf:bus-trial bus)))
                          (loop (cdr xs) (cons rec acc)))))))
    (perf:write-jobs records)
    (let* ((fp-before (evo:source-fingerprint))
           (batch (perf:launch-jobs records (hash-ref spec "worker")))
           (fp-after (evo:source-fingerprint))
           (results (hash-ref batch "results" '()))
           (pct (hash-ref spec "min-speedup-pct" 20)))
      ; The reference of this round is the null candidate of this round,
      ; and the candidates were measured in the same shape, so the
      ; rebind's tax is on both sides.
      (hash-set! buf "before-ms" baseline)
      (hash-set! buf "before-samples" '())
      (perf:say buf (string-append
                      "round-gate-baseline-ms " (number->string baseline)
                      " raw-ms=" (number->string raw-ms)
                      " source=" (if null-ok "null-candidate" "carried")
                      " round-wall-ms " (number->string (hash-ref batch "wall-ms" 0))
                      " round-dur-sum-ms " (number->string (perf:sum-dur results))
                      " jobs " (number->string (length records))))
      (perf:say buf (string-append
                      "live-fingerprint-during-trials "
                      (number->string fp-before) " -> " (number->string fp-after)
                      (if (= fp-before fp-after) " unchanged" " CHANGED")))
      ; The candidates the dry-run mutation gate refused: no process, no
      ; screen, no held-out. They are still ROLLBACK decisions with their
      ; own audit row, so the report does not hide them.
      (let loop ((xs type-rejected))
        (if (null? xs)
            #t
            (let* ((row (car xs))
                   (cand (hash-ref row "cand" (hash)))
                   (check (hash-ref row "check" #f))
                   (id (hash-ref cand "id" "?"))
                   (target (hash-ref row "target" (perf:cand-target spec cand)))
                   (detail (perf:type-gate-detail check)))
              (perf:say buf (string-append "candidate " id
                                           " ROLLBACK reason=type-gate"))
              (perf:say buf (string-append "type-gate " id " " detail))
              (perf:note buf "reject" id "type-gate")
              (perf:bump buf "rollback")
              ; Keep the next round's order from re-planning a candidate
              ; that cannot typecheck. This is per-run: the same id may
              ; carry a fixed genome in the next run.
              (hash-set! buf "refused"
                         (cons id (hash-ref buf "refused" '())))
              (perf:audit-decision target "ROLLBACK" "type-gate"
                                   (hash "id" id "detail" detail))
              (loop (cdr xs)))))
      ; The candidates with no reference of their own.
      (let loop ((xs unjudgeable))
        (if (null? xs)
            #t
            (let* ((id (hash-ref (car xs) "id" "?"))
                   (t (perf:cand-target spec (car xs))))
              (perf:say buf (string-append "candidate " id
                                           " ROLLBACK reason=reference-missing"
                                           " ref-target=" t))
              (perf:note buf "reject" id "reference-missing")
              (perf:bump buf "rollback")
              (perf:audit-decision t "ROLLBACK" "reference-missing" (hash "id" id))
              (hash-set! buf "memory"
                         (perf:neg-remember (hash-ref buf "memory" '())
                                            (hash-ref spec "class" "")
                                            (hash-ref spec "hot-node" "")
                                            id
                                            "reference-missing"))
              (loop (cdr xs)))))
      (let loop ((xs trialable))
        (if (null? xs)
            results
            (let* ((id (hash-ref (car xs) "id" ""))
                   (result (perf:find-result results id)))
              (if (not result)
                  (begin
                    (perf:say buf (string-append "candidate " id " ROLLBACK reason=missing-result"))
                    (perf:note buf "reject" id "missing-result")
                    (perf:bump buf "rollback")
                    (perf:audit-decision (perf:cand-target spec (car xs))
                                         "ROLLBACK" "missing-result" (hash "id" id)))
                  (hash-set! result "site" (perf:candidate-site (car xs)))
                  (hash-set! result "sites" (perf:cand-sites (car xs)))
                  (perf:tag-result! result (car xs))
                  (let* ((raw (perf:raw-of spec))
                         (cand-target (perf:cand-target spec (car xs)))
                         (site (perf:site-context spec result
                                                 (let ((own (hash-ref result "base-cct" #f)))
                                                   ; The candidate's own base: the
                                                   ; same tree, in the same
                                                   ; process, measured before the
                                                   ; rebind. Two processes are two
                                                   ; histories, and the histories
                                                   ; move the numbers.
                                                   (if (and (hash? own)
                                                            (pair? (hash-keys own)))
                                                       own
                                                       (hash-ref (hash-ref nulls cand-target #f)
                                                                 "cct" #f)))))
                         ; The reference of this candidate is the null of
                         ; the define IT rebinds: a candidate and its
                         ; reference have to pay the same rebind.
                         (cand-base (let ((own (hash-ref result "null-heldout-ms" -1)))
                                      ; The reference of this candidate: the
                                      ; null of the define it rebinds,
                                      ; measured in the SAME process (the
                                      ; worker measures it right before it
                                      ; applies the candidate). Across
                                      ; processes the two numbers differ by
                                      ; the machine's load, which is worth
                                      ; more than the floor.
                                      (if (and (number? own) (> own 0))
                                          own
                                          (perf:cand-baseline spec nulls baseline cand-target))))
                         (reason0 (if raw
                                      (perf:reason result cand-base pct raw site)
                                      (perf:reason result cand-base pct site)))
                         ; #5128: the verdict goes through the bus. KEEP runs
                         ; the coordinator's constraint set; a rejection
                         ; downgrades to ROLLBACK — no local bypass.
                         (bus-wl (let ((rec (perf:find-record records id)))
                                   (if rec (hash-ref rec "bus-wl" -1) -1)))
                         (bus-res (perf:bus-verdict bus bus-wl
                                                    (string=? reason0 "gate-pass")
                                                    (hash-ref result "heldout-ms" -1)))
                         (bus-rejected (and (string? bus-res)
                                            (string-prefix? bus-res "constraint-rejected")))
                         (reason (if bus-rejected "bus-constraint-rejected" reason0))
                         (q (perf:cct-worldline-query
                              (hash-ref spec "profile-cct" #f)
                              (hash-ref result "cct" #f)
                              (hash-ref spec "prefix" '())))
                         (pass (string=? reason "gate-pass"))
                         ; Did the site floor keep it, when the program
                         ; floor did not? The report says so: a reader
                         ; should not have to guess which of the two
                         ; floors answered.
                         (site-floor (if (and (not (perf:speedup-ok? cand-base
                                                                 (hash-ref result "heldout-ms" -1)
                                                                 pct))
                                           (perf:site-ok? site))
                                        1 0)))
                    (hash-set! result "prefix-removed" (if (eq? (hash-ref q "prefix-removed" #f) #t) 1 0))
                    (hash-set! result "cost-moved" (if (eq? (hash-ref q "cost-moved" #f) #t) 1 0))
                    (hash-set! result "measured" (if (eq? (hash-ref q "measured" #f) #t) 1 0))
                    (hash-set! result "moved-to" (perf:join (hash-ref q "moved-to" '()) ","))
                    (hash-set! result "target" (hash-ref (car xs) "target" ""))
                    (hash-set! result "ref-ms" cand-base)
                    (let* ((held (hash-ref result "heldout-ms" -1))
                           (effect (if (and (number? held) (>= held 0)
                                            (number? cand-base) (> cand-base 0))
                                       (- held cand-base)
                                       -1))
                           (tax (if (and (number? raw) (> raw 0)
                                         (number? cand-base) (> cand-base 0))
                                    (- cand-base raw)
                                    -1)))
                      (hash-set! result "mutation-effect-ms" effect)
                      (hash-set! result "rebind-tax-ms" tax))
                    (hash-set! result "ref-target"
                               (perf:join (perf:cand-targets spec (car xs)) "+"))
                    (let ((hr (perf:headroom-of spec (perf:cand-sites (car xs)))))
                      (if (hash? hr)
                          (begin
                            (hash-set! result "headroom-ms" (hash-ref hr "ms" 0))
                            (hash-set! result "headroom-pct"
                                       (perf:delta-pct (hash-ref hr "base" 0)
                                                       (hash-ref hr "ms" 0))))
                          #f))
                    (hash-set! result "site-context" site)
                    (hash-set! result "site-floor" site-floor)
                    (hash-set! result "bus-verdict" bus-res)
                    (if (and bus (>= bus-wl 0))
                        (perf:say buf (string-append "bus-worldline " id
                                                     " wl=" (number->string bus-wl)
                                                     " verdict=" bus-res))
                        #f)
                    (hash-set! buf "results" (append (hash-ref buf "results" '()) (list result)))
                    (perf:say buf (perf:format-candidate result cand-base pct raw site))
                    (perf:say buf (string-append
                                    "split " id
                                    " raw-ms=" (number->string (if raw raw -1))
                                    " null-ms=" (number->string cand-base)
                                    " cand-ms=" (number->string (hash-ref result "heldout-ms" -1))
                                    " mutation-effect-ms=" (number->string (hash-ref result "mutation-effect-ms" -1))
                                    " rebind-tax-ms=" (number->string (hash-ref result "rebind-tax-ms" -1))))
                    (let ((eng (hash-ref result "engine" (hash))))
                      (if (and (hash? eng) (= (hash-ref eng "available" 0) 1))
                          (perf:say buf (string-append
                                          "trial-engine " id
                                          " rebuild=" (number->string (hash-ref eng "world-rebuilt" 0))
                                          " cascade-full=" (number->string (hash-ref eng "cascade-full" 0))
                                          " body-only=" (number->string (hash-ref eng "body-only" 0))
                                          " relower-full=" (number->string (hash-ref eng "relower-full" 0))
                                          " dirty-recompiles=" (number->string (hash-ref eng "dirty-recompiles" 0))
                                          " mutate-batches=" (number->string (hash-ref eng "mutate-batches" 0))
                                          " jit-compilations=" (number->string (hash-ref eng "jit-compilations" 0))
                                          " jit-deopt=" (number->string (hash-ref eng "jit-deopt" 0))
                                          " jit-fallback=" (number->string (hash-ref eng "jit-fallback" 0))
                                          " arena-compacts=" (number->string (hash-ref eng "arena-compacts" 0))))
                          #f))
                    (if (and (hash? site)
                             (string? (hash-ref site "site" ""))
                             (> (string-length (hash-ref site "site" "")) 0))
                        (perf:say buf (string-append "site " (hash-ref site "site" "")
                                                       " base-ms=" (number->string (hash-ref site "base" -1))
                                                       " cand-ms=" (number->string (hash-ref site "cand" -1))
                                                       " floor-pct=" (number->string (hash-ref site "pct" -1))))
                        #f)
                    (perf:say buf (string-append "worldline " id
                                                 " measured=" (number->string (hash-ref result "measured" 0))
                                                 " prefix-removed=" (number->string (hash-ref result "prefix-removed" 0))
                                                 " cost-moved=" (number->string (hash-ref result "cost-moved" 0))
                                                 " moved-to=" (hash-ref result "moved-to" "")
                                                 " fidelity=" (hash-ref result "fidelity" "")
                                                 " cct-source=" (hash-ref result "cct-source" "none")))
                    (perf:note buf (if pass "pass" "reject") id (perf:short-reason reason))
                    (perf:audit-decision
                      (perf:cand-target spec (car xs))
                      (if pass "PROPOSE" "ROLLBACK")
                      reason
                      (hash "id" id
                            "heldout-ms" (hash-ref result "heldout-ms" -1)
                            "mismatches" (hash-ref result "mismatches" -1)
                            "class" (hash-ref spec "class" "")
                            "hot-node" (hash-ref spec "hot-node" "")
                            "prefix-removed" (hash-ref result "prefix-removed" 0)
                            "cost-moved" (hash-ref result "cost-moved" 0)
                            "moved-to" (hash-ref result "moved-to" "")
                            "fidelity" (hash-ref result "fidelity" "")
                            "cct-delta" (perf:delta-brief (hash-ref q "delta" '()))
                            "engine" (hash-ref result "engine" (hash))
                            "mutation-effect-ms" (hash-ref result "mutation-effect-ms" -1)
                            "rebind-tax-ms" (hash-ref result "rebind-tax-ms" -1)))
                    (if pass
                        #t
                        (begin
                          (perf:bump buf "rollback")
                          (hash-set! buf "memory"
                                     (perf:neg-remember (hash-ref buf "memory" '())
                                                        (hash-ref spec "class" "")
                                                        (hash-ref spec "hot-node" "")
                                                        id
                                                        (perf:short-reason reason))))))))
              (let ((res (loop (cdr xs))))
                (perf:bus-task-close bus task (length res) (perf:any-infra? res))
                res))))))

(define (perf:best-passing spec results baseline pct . rest)
  (let ((raw (if (pair? rest) (car rest) #f)))
  (let loop ((xs results) (best #f))
    (if (null? xs)
        best
        (let ((r (car xs)))
          (if (and (hash? r)
                   ; The reference of a candidate is the null of the
                   ; define it rebinds; the round's reference is only
                   ; the fallback.
                   (let ((base (hash-ref r "ref-ms" baseline)))
                   (if raw
                       (perf:accept? base r pct raw (hash-ref r "site-context" (hash)))
                       (perf:accept? base r pct (hash-ref r "site-context" (hash))))))
              (if (or (not best)
                      (< (hash-ref r "heldout-ms" 999999999)
                         (hash-ref best "heldout-ms" 999999999)))
                  (loop (cdr xs) r)
                  (loop (cdr xs) best))
              (loop (cdr xs) best)))))))

; Whether any trial of a round did not end in a verdict about its
; candidate: the worker crashed, timed out or could not isolate. Such a
; round gives the strategy nothing to revise on. A candidate that was
; judged and failed (wrong, slow, a checksum that does not match) is
; not this: the round goes on to its next round.
(define (perf:any-infra? results)
  (let loop ((xs (if (list? results) results '())))
    (if (null? xs)
        #f
        (if (or (not (hash? (car xs)))
                (not (perf:judged? (car xs))))
            #t
            (loop (cdr xs))))))

(define (perf:failed-ids spec results baseline pct . rest)
  (let ((raw (if (pair? rest) (car rest) #f)))
  (let loop ((xs results) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((r (car xs)))
          (if (and (hash? r)
                   (let ((base (hash-ref r "ref-ms" baseline)))
                   (not (if raw
                            (perf:accept? base r pct raw (hash-ref r "site-context" (hash)))
                            (perf:accept? base r pct (hash-ref r "site-context" (hash)))))))
              (loop (cdr xs) (cons (hash-ref r "id" "") acc))
              (loop (cdr xs) acc)))))))

(define (perf:commit-kernel spec entry baseline buf winner)
  ; Snapshot first. A parallel let could rebind before the snapshot.
  (let* ((snap (mutate :snapshot "perf-kernel"))
         (compile-before (perf:compile-snap))
         (rb (mutate:rebind (hash-ref entry "target"
                                          (hash-ref spec "target" "bench-kernel"))
                            (hash-ref entry "genome" "")
                            "perf-keep")))
    (if (not (eq? rb #t))
        (begin
          (perf:say buf (string-append "kernel ROLLBACK reason=rebind-"
                                       (if (string? rb) rb "failed")))
          (perf:note buf "reject" (hash-ref entry "id" "?") "rebind")
          (perf:bump buf "rollback")
          (perf:audit-decision (hash-ref spec "target") "ROLLBACK" "rebind-failed" (hash))
          #f)
        (begin
          (eval-current)
          (let* ((compile-after (perf:compile-snap))
                 (cd (perf:compile-delta compile-before compile-after))
                 (chk (perf:run-check spec (hash-ref spec "call")))
                 (tm (perf:time-checked (hash-ref spec "repeats" 3)
                                        (hash-ref spec "call")
                                        ((perf:inputs-fn spec) (hash-ref spec "heldout-n" 0))
                                        (perf:oracle-fn spec)))
                 (pct (hash-ref spec "min-speedup-pct" 20))
                 ; The site floor answers here too: a candidate that won
                 ; its own define is not a loss, even when the program
                 ; as a whole moved less than the program floor.
                 (site (if (hash? winner) (hash-ref winner "site-context" (hash)) (hash)))
                 ; The candidate's own measurement, taken in the child
                 ; with the candidate applied, is the one that can be
                 ; compared with the null candidate of the same round:
                 ; both paid the rebind's tax. The parent's own
                 ; measurement is taxed again (the parent's rebind
                 ; invalidated its JIT), so it is a diagnostic, not the
                 ; verdict.
                 (cand-ms (if (hash? winner)
                              (hash-ref winner "heldout-ms" -1)
                              (hash-ref tm "median" -1)))
                 ; The winner's own reference: the null of the define it
                 ; rebinds, the same one the gate used.
                 (ref-ms (if (hash? winner)
                             (hash-ref winner "ref-ms" baseline)
                             baseline))
                 (ok (and (eq? (hash-ref chk "ok" #f) #t)
                          (= (hash-ref tm "mismatches" 1) 0)
                          (or (perf:speedup-ok? ref-ms cand-ms pct)
                              (perf:site-ok? site)))))
            (if ok
                (begin
                  ; The site the floor was measured on, so the verdict
                  ; asks the same question the gate asked.
                  (hash-set! buf "site" site)
                  (hash-set! buf "after-ms" cand-ms)
                  (hash-set! buf "after-samples" (hash-ref tm "samples" '()))
                  (hash-set! buf "after-parent-ms" (hash-ref tm "median" -1))
                  (perf:bump buf "keep")
                  (hash-set! buf "world-rebuilt" (hash-ref cd "world-rebuilt" -1))
                  (perf:audit-decision (hash-ref spec "target") "KEEP" "held-out gate"
                                       (hash "heldout-ms" (hash-ref tm "median")
                                             "id" (hash-ref entry "id" "")
                                             "world-rebuilt" (hash-ref cd "world-rebuilt" -1)
                                             "cascade-full" (hash-ref cd "cascade-full" 0)
                                             "body-only" (hash-ref cd "body-only" 0)))
                  (perf:say buf (string-append "kernel KEEP id=" (hash-ref entry "id" "")
                                               " heldout-ms=" (number->string (hash-ref tm "median"))))
                  (perf:say buf (string-append "compile-delta world-rebuilt="
                                               (number->string (hash-ref cd "world-rebuilt" -1))
                                               " cascade-full=" (number->string (hash-ref cd "cascade-full" 0))
                                               " body-only=" (number->string (hash-ref cd "body-only" 0))
                                               " relower-full=" (number->string (hash-ref cd "relower-full" 0))))
                  (perf:note buf "keep" (hash-ref entry "id" "") "held-out gate")
                  #t)
                (begin
                  (mutate :restore snap)
                  (eval-current)
                  (perf:bump buf "rollback")
                  (perf:audit-decision (hash-ref spec "target") "ROLLBACK"
                                       "post-keep-verify-failed" (hash))
                  (perf:note buf "reject" (hash-ref entry "id" "") "intend")
                  (perf:say buf "kernel ROLLBACK reason=post-keep-verify-failed")
                  #f)))))))

(define (perf:commit-strategy spec order buf)
  (let ((k (let ((n (hash-ref spec "strategy-per-round" 1)))
             (if (and (number? n) (> n 0)) n 1)))
        (src-order order))
    (let ((src (perf:strategy-source src-order k)))
    (if (not (string? src))
        (begin
          (perf:say buf "strategy ROLLBACK reason=unsafe-order")
          (perf:note buf "reject" "perf-strategy" "unsafe-order")
          (perf:bump buf "rollback")
          #f)
        (let* ((snap (mutate :snapshot "perf-strategy"))
               (rb (mutate:rebind "perf-strategy" src "perf-strategy-revise")))
          (if (not (eq? rb #t))
              (begin
                (perf:say buf "strategy ROLLBACK reason=rebind-failed")
                (perf:note buf "reject" "perf-strategy" "rebind")
                (perf:bump buf "rollback")
                (perf:audit-decision "perf-strategy" "ROLLBACK" "rebind-failed" (hash))
                #f)
              (begin
                (eval-current)
                (let ((mine-fn (hash-ref spec "gene-mine" perf:mine))
                      (profile (hash-ref spec "profile" (hash))))
                (let ((plan (try (perf-strategy (hash "profile" profile
                                                             "mine" mine-fn
                                                             "hot-child-fn" perf:hot-child))
                                 (catch (e) #f))))
                  (if (and (hash? plan)
                           (equal? (perf:order-of plan) order))
                      (begin
                        (perf:bump buf "keep")
                        (perf:note buf "keep" "perf-strategy" "classifies-hot-prefix")
                        (perf:audit-decision "perf-strategy" "KEEP"
                                             "strategy gene order"
                                             (hash "order" order))
                        (perf:say buf (string-append "strategy KEEP order"
                                                     (perf:join (map (lambda (s) (string-append " " s)) order) "")))
                        plan)
                      (begin
                        (mutate :restore snap)
                        (eval-current)
                        (perf:bump buf "rollback")
                        (perf:audit-decision "perf-strategy" "ROLLBACK" "strategy-verify-failed" (hash))
                        (perf:say buf "strategy ROLLBACK reason=strategy-verify-failed")
                        #f)))))))))))

(define (perf:ids cands)
  (let loop ((xs cands) (acc ""))
    (if (null? xs)
        acc
        (loop (cdr xs)
              (string-append acc (if (string=? acc "") "" ",")
                             (hash-ref (car xs) "id" "?"))))))

(define (perf:sample-text samples)
  (let loop ((xs (if (list? samples) samples '())) (acc ""))
    (if (null? xs)
        acc
        (loop (cdr xs)
              (string-append acc (if (string=? acc "") "" ",")
                             (number->string (car xs)))))))

(define (perf:protected spec)
  (let ((intend (hash-ref spec "intend" (hash))))
    (if (hash? intend) (hash-ref intend "protected" '()) '())))

; Propose the whole order, drop protected sites, then honor per-round.
; Refusals are audit lines. They are not trials.
(define (perf:budget-left spec buf)
  (let ((cap (hash-ref (perf:intend-seal spec) "budget" 0))
        (used (hash-ref buf "budget" 0)))
    (if (or (not (number? cap)) (<= cap 0))
        100
        (let ((left (- cap used)))
          (if (< left 0) 0 left)))))

; Headroom as a strategy input: known upper bounds order the round
; (highest first; unknown stays behind), and an optional floor drops a
; candidate whose sites all have less headroom than the spec asks for.
; "headroom-order" #f keeps the strategy order; "headroom-min-pct" is
; absent by default, so older specs behave exactly as before.
(define (perf:headroom-cand-pct spec cand)
  (let ((hr (perf:headroom-of spec (perf:cand-sites cand))))
    (if (hash? hr)
        (perf:delta-pct (hash-ref hr "base" 0) (hash-ref hr "ms" 0))
        -1)))

(define (perf:headroom-order spec cands)
  (if (eq? (hash-ref spec "headroom-order" #t) #f)
      cands
      (let ((known (let loop ((xs cands))
                     (if (null? xs)
                         #f
                         (if (>= (perf:headroom-cand-pct spec (car xs)) 0)
                             #t
                             (loop (cdr xs)))))))
        (if known
            (sort cands (lambda (a b)
                          (> (perf:headroom-cand-pct spec a)
                             (perf:headroom-cand-pct spec b))))
            cands))))

(define (perf:headroom-filter spec buf cands)
  (let* ((intend (hash-ref spec "intend" (hash)))
         (floor (hash-ref spec "headroom-min-pct"
                          (if (hash? intend)
                              (hash-ref intend "headroom-min-pct" #f)
                              #f))))
    (if (not (and (number? floor) (> floor 0)))
        cands
        (let loop ((xs cands) (acc '()))
          (if (null? xs)
              (reverse acc)
              (let* ((c (car xs))
                     (p (perf:headroom-cand-pct spec c))
                     (id (hash-ref c "id" "?")))
                (if (and (number? p) (>= p 0) (< p floor))
                    (begin
                      (perf:say buf (string-append
                                      "headroom-skip " id
                                      " headroom-pct=" (number->string p)
                                      " floor-pct=" (number->string floor)))
                      ; Keep the next round's order from re-planning it.
                      (hash-set! buf "refused"
                                 (cons id (hash-ref buf "refused" '())))
                      (loop (cdr xs) acc))
                    (loop (cdr xs) (cons c acc)))))))))

(define (perf:round-candidates spec plan buf)
  (let* ((wide (hash "order" (perf:order-of plan) "per-round" 100))
         (raw (perf:rule-propose (perf:catalog spec) (hash "plan" wide)))
         (split (perf:split-protected raw (perf:protected spec)))
         (filtered (perf:filter-negative (hash-ref split "ok" '())
                                         (hash-ref buf "memory" '())
                                         (hash-ref spec "class" "")
                                         (hash-ref spec "hot-node" "")))
         (ordered (perf:headroom-order spec (hash-ref filtered "ok" '())))
         (gated (perf:headroom-filter spec buf ordered))
         (k0 (let ((n (hash-ref plan "per-round" 1)))
               (if (and (number? n) (> n 0)) n 1)))
         (k (let ((left (perf:budget-left spec buf)))
              (if (< left k0) left k0))))
    (perf:refuse-each spec buf (hash-ref split "refused" '()))
    (perf:say-skips buf spec (hash-ref filtered "skipped" '()))
    (perf:take gated k)))

; A candidate the sealed intend protects is refused before any trial.
; The refusal is a decision: the report counts it, and the audit and
; the negative memory keep it.
(define (perf:refuse-each spec buf refused)
  (let loop ((xs (if (list? refused) refused '())))
    (if (null? xs)
        #t
        (let* ((c (car xs))
               (id (hash-ref c "id" "?")))
          (perf:say buf (string-append "expert-refuse " id
                                       " site=" (hash-ref c "target"
                                                          (hash-ref c "site" "?"))))
          (perf:note buf "reject" id "protected")
          (perf:bump buf "rollback")
          (perf:audit-decision (hash-ref c "target" "protected")
                               "ROLLBACK" "protected-define"
                               (hash "id" (hash-ref c "id" "")
                                     "class" (hash-ref spec "class" "")
                                     "hot-node" (hash-ref spec "hot-node" "")))
          (hash-set! buf "memory"
                     (perf:neg-remember (hash-ref buf "memory" '())
                                        (hash-ref spec "class" "")
                                        (hash-ref spec "hot-node" "")
                                        (hash-ref c "id" "")
                                        "protected"))
          (hash-set! buf "refused"
                     (cons (hash-ref c "id" "") (hash-ref buf "refused" '())))
          (hash-set! buf "results"
                     (append (hash-ref buf "results" '())
                             (list (hash "id" (hash-ref c "id" "")
                                         "target" (hash-ref c "target"
                                                            (hash-ref c "site" ""))
                                         "status" "refused"
                                         "checksum-ok" 1
                                         "mismatches" 0
                                         "heldout-ms" -1
                                         "fidelity" "not-tried"
                                         "live-unchanged" 1))))
          (loop (cdr xs))))))

; An idea that failed on this hotspot before is skipped, not trialed.
(define (perf:say-skips buf spec skipped)
  (let loop ((xs (if (list? skipped) skipped '())))
    (if (null? xs)
        #t
        (begin
          (perf:say buf (string-append "negative-skip "
                                       (hash-ref (car xs) "id" "?")
                                       " class=" (hash-ref spec "class" "")
                                       " hot-node=" (hash-ref spec "hot-node" "")))
          (loop (cdr xs))))))

; ── The model's candidates in a round ───────────────────────────

; What the model is shown. The profile and the plan the report already
; names, the gate's numbers, and the source of every define this run
; may rebind. A protected define is in there too, marked: the model is
; told not to rebind it, and the sealed boundary refuses it if it does.
(define (perf:llm-named? rows name)
  (let loop ((xs rows))
    (if (null? xs)
        #f
        (if (and (hash? (car xs)) (string=? (hash-ref (car xs) "name" "") name))
            #t
            (loop (cdr xs))))))

; One row per define that has a body: its name, its source, and whether
; the intend protects it. A name already listed is skipped.
(define (perf:llm-rows-for spec names taken)
  (let ((protected (perf:protected spec)))
    (let loop ((xs (if (list? names) names '())) (acc '()))
      (if (null? xs)
          (reverse acc)
          (let* ((n (car xs))
                 (body (if (and (string? n) (not (string=? n ""))
                                (not (perf:llm-named? taken n))
                                (not (perf:llm-named? acc n)))
                          (perf:null-body spec n)
                          "")))
            (loop (cdr xs)
                  (if (string=? body "")
                      acc
                      (cons (hash "name" n
                                  "source" body
                                  "protected" (if (perf:member? protected n) 1 0))
                            acc))))))))

; The defines the profiled code calls: every name on a hotspot's stack.
(define (perf:llm-stack-names profile)
  (let loop ((hs (perf:hotspots profile)) (acc '()))
    (if (null? hs)
        acc
        (loop (cdr hs)
              (append acc (let ((s (hash-ref (car hs) "stack" '())))
                            (if (list? s) s '())))))))

; The proposer's ctx: the evidence and the options of one run. The
; profile and the plan the report already names, the gate's numbers, and
; the source of every define this run may rebind. A protected define is
; in there too, marked: the model is told not to rebind it, and the
; sealed boundary refuses it if it does.
(define (perf:llm-context spec buf plan profile child hottest refs)
  (let* ((seal (perf:intend-seal spec))
         (targets (perf:llm-rows-for spec (perf:run-targets spec) '()))
         (context (perf:llm-rows-for
                    spec
                    (append (let ((p (hash-ref plan "prefix" #f)))
                              (if (list? p) p '()))
                            (perf:llm-stack-names profile))
                    targets)))
    (hash "llm" (perf:llm-options spec)
          "label" (hash-ref spec "label" "sum-scan")
          "plan" plan
          "profile" profile
          "hot-child" child
          "hottest" hottest
          "hotspots" (perf:hotspots profile)
          "class" (hash-ref spec "class" "")
          "hot-node" (hash-ref spec "hot-node" "")
          "target" (hash-ref spec "target" "bench-kernel")
          "targets" targets
          "context" context
          "catalog" (perf:catalog spec)
          "memory" (hash-ref buf "memory" '())
          "gate" (hash "pct" (hash-ref seal "effective-min-faster-pct" 20)
                       "site-pct" (hash-ref seal "site-min-faster-pct" #f)
                       "heldout-n" (hash-ref spec "heldout-n" 0)
                       "raw-ms" (hash-ref refs "raw-ms" -1)
                       "raw-samples" (hash-ref refs "raw-samples" '())
                       "ref-ms" (hash-ref refs "gate-ms" -1)))))

; The model's candidates that reach a trial. They pass the two filters
; the rule path's candidates pass: the sealed protected boundary and
; the negative memory of this hotspot. They come out of the proposer's
; own allowance, never out of the intend's budget, so a model's trial
; cannot take one away from the rule path.
(define (perf:llm-round-candidates spec llm buf)
  (let* ((cands (if (and (hash? llm) (eq? (hash-ref llm "ok" #f) #t))
                    (let ((cs (hash-ref llm "candidates" '())))
                      (if (list? cs)
                          (map (lambda (c) (perf:normalize-cand spec c)) cs)
                          '()))
                    '()))
         (split (perf:split-protected cands (perf:protected spec)))
         (filtered (perf:filter-negative (hash-ref split "ok" '())
                                         (hash-ref buf "memory" '())
                                         (hash-ref spec "class" "")
                                         (hash-ref spec "hot-node" "")))
         (k (if (hash? llm) (hash-ref llm "budget" 0) 0)))
    (perf:refuse-each spec buf (hash-ref split "refused" '()))
    (perf:say-skips buf spec (hash-ref filtered "skipped" '()))
    (perf:take (hash-ref filtered "ok" '()) (if (number? k) k 0))))

; A model's candidate says so on its result, with its thought: the
; evidence keeps the provenance.
(define (perf:tag-result! result cand)
  (let loop ((ks (list "proposer" "thought")))
    (if (null? ks)
        #t
        (let ((v (hash-ref cand (car ks) #f)))
          (if (string? v) (hash-set! result (car ks) v) #f)
          (loop (cdr ks))))))

; The results the rule path owns. A model's candidate that could not be
; applied, timed or judged is that candidate's ROLLBACK, not a reason
; for the rule path to stop.
(define (perf:rule-results results)
  (let loop ((xs (if (list? results) results '())) (acc '()))
    (if (null? xs)
        (reverse acc)
        (loop (cdr xs)
              (if (and (hash? (car xs))
                       (string=? (hash-ref (car xs) "proposer" "") "llm"))
                  acc
                  (cons (car xs) acc))))))

(define (perf:choose-winner spec results best plan child hottest out buf baseline pct)
  (if best
      best
      (if (perf:any-infra? results)
          (begin
            (perf:say buf "strategy ROLLBACK reason=trial-infrastructure")
            (perf:bump buf "rollback")
            #f)
            (let ((failed (append (hash-ref buf "refused" '())
                                (perf:failed-ids spec results baseline pct (perf:raw-of spec)))))
            (let ((next (perf:revise-order (perf:order-of plan) failed)))
              (let ((plan2 (perf:commit-strategy spec next buf)))
                (if (not plan2)
                    #f
                    (let ((cands2 (perf:round-candidates spec plan2 buf)))
                      (perf:say buf (string-append "round 2 candidates " (perf:ids cands2)))
                      (hash-set! buf "budget"
                                 (+ (hash-ref buf "budget" 0) (length cands2)))
                      (let ((results2 (perf:trial-round spec cands2 out buf baseline)))
                        (if (perf:any-infra? results2)
                            (begin
                              (perf:say buf "round 2 aborted: trial infrastructure")
                              #f)
                            (perf:best-passing spec results2 baseline pct (perf:raw-of spec))))))))))))

(define (perf:say-each buf lines)
  (let loop ((xs lines))
    (if (null? xs)
        #t
        (begin
          (perf:say buf (car xs))
          (loop (cdr xs))))))

(define (perf:run-kernel spec n)
  (let ((f (hash-ref spec "call"))
        (xs (perf:range n)))
    (f xs)
    (f xs)
    (f xs)))

(define (perf:confirm spec buf profile)
  (let ((bin (hash-ref (hash-ref profile "tools" (hash)) "perf" "missing"))
        (cmd (hash-ref spec "perf-after" "")))
    (if (or (< (hash-ref buf "keep" 0) 1)
            (not (string? bin)) (string=? bin "missing")
            (not (string? cmd)) (string=? cmd ""))
        #f
        (let* ((text (perf:stat-text bin cmd "/tmp/aura-perf-after.txt"))
               (counters (perf:parse-perf-stat text))
               (after-clock (hash-ref counters "task-clock" -1))
               (before-node (perf:cct-node (hash-ref profile "cct" (hash)) "bench-kernel"))
               (before-clock (if (hash? before-node)
                                 (hash-ref before-node "task-clock" -1)
                                 -1))
               (after-cct (perf:cct-build
                            (list (hash "name" "bench-kernel"
                                        "task-clock" after-clock
                                        "page-faults" (hash-ref counters "page-faults" 0)
                                        "stack" (list "bench-kernel")
                                        "calls" 1))))
               (rows (perf:cct-delta (hash-ref profile "cct" (hash)) after-cct))
               (live (perf:measure-live bin (lambda () (perf:run-kernel spec 4000)))))
          (perf:say buf (string-append "perf-before-task-clock-ms "
                                       (number->string before-clock)))
          (perf:say buf (string-append "perf-after-task-clock-ms "
                                       (number->string after-clock)))
          (let loop ((xs rows))
            (if (null? xs)
                #t
                (let ((h (car xs)))
                  (perf:say buf (string-append
                                  "cct-delta " (hash-ref h "id" "?")
                                  " before-ms=" (number->string (hash-ref h "before-ms" 0))
                                  " after-ms=" (number->string (hash-ref h "after-ms" 0))
                                  " delta-ms=" (number->string (hash-ref h "delta-ms" 0))))
                  (loop (cdr xs)))))
          (perf:say buf (string-append "perf-live-after-task-clock-ms "
                                       (number->string (hash-ref live "task-clock" -1))))
          (if (and (number? before-clock) (> before-clock 0)
                   (number? after-clock) (> after-clock 0)
                   (< after-clock before-clock))
              (perf:say buf "hypothesis-confirmed linear-scan lower-task-clock")
              (perf:say buf "hypothesis-unconfirmed"))))))

(define (perf:say-intend spec buf before-ms after-ms)
  (let* ((intend (hash-ref spec "intend" (hash)))
         (seal (perf:intend-seal spec))
         (pct (hash-ref seal "effective-min-faster-pct" 10))
         (met (perf:speedup-ok? before-ms after-ms pct)))
    (perf:say buf (string-append "intend min-faster-pct=" (number->string pct)
                                 " checksum=1 protected="
                                 (perf:join (hash-ref intend "protected" '()) ",")))
    (perf:say buf (string-append "intend-met " (if met "1" "0")))))

(define (perf:finish spec buf profile child out)
  (let ((after-profile (perf:collect ((hash-ref spec "regions-fn"))
                                     (hash "repeats" (hash-ref spec "profile-repeats" 3)
                                           "batch-command" (hash-ref spec "profile-command" "")))))
    (let ((delta (perf:delta profile after-profile)))
      (let ((after-ms (hash-ref buf "after-ms" -1)))
        (let ((before-ms (hash-ref buf "before-ms" -1)))
          (perf:say buf (string-append "after-heldout-ms " (number->string after-ms)
                                       " samples=" (perf:sample-text (hash-ref buf "after-samples" '()))))
          (perf:say buf (string-append "speedup-x " (perf:fmt-x before-ms after-ms)))
          (perf:bus-finish (hash-ref buf "bus" #f) buf before-ms after-ms)
          (perf:confirm spec buf profile)
          (perf:say buf (string-append "budget-used " (number->string (hash-ref buf "budget" 0))))
          (perf:say buf (string-append "llm-budget-used "
                                       (number->string (hash-ref buf "llm-budget" 0))))
          (perf:say-intend spec buf before-ms after-ms)
          (perf:say buf (string-append "profile-elapsed-before-ms "
                                       (number->string (hash-ref delta "elapsed-before-ms" 0))
                                       " profile-elapsed-after-ms "
                                       (number->string (hash-ref delta "elapsed-after-ms" 0))))
          (perf:say-each buf (let loop ((xs (hash-ref delta "hotspots" '())) (acc '()))
                               (if (null? xs)
                                   (reverse acc)
                                   (let ((h (car xs)))
                                     (loop (cdr xs)
                                           (cons (string-append
                                                   "delta " (hash-ref h "name" "?")
                                                   " before-ms=" (number->string (hash-ref h "before-ms" 0))
                                                   " after-ms=" (number->string (hash-ref h "after-ms" 0))
                                                   " delta-ms=" (number->string (hash-ref h "delta-ms" 0)))
                                                 acc))))))
          (perf:say buf (string-append "decisions KEEP=" (number->string (hash-ref buf "keep" 0))
                                       " ROLLBACK=" (number->string (hash-ref buf "rollback" 0))))
          (perf:say buf (string-append "mutation-records "
                                       (number->string (length (perf:mutation-records)))))
          (let ((logn (try (length (evo:records)) (catch (e) -1))))
            (perf:say buf (string-append "evo-records " (number->string logn))))
          (let* ((site (hash-ref buf "site" (hash)))

                 ; The verdict asks the question the gate asked: the
                 ; program floor, or the site floor for a candidate that
                 ; won its own define.
                 (met (or (perf:speedup-ok? before-ms after-ms
                                         (hash-ref (perf:intend-seal spec) "effective-min-faster-pct" 10))
                          (perf:site-ok? site)))
                 (speed (perf:verdict-speedup before-ms after-ms
                                              (hash-ref buf "before-samples" '())
                                              (hash-ref buf "after-samples" '())))
                 (verdict (string-append
                            "verdict intend-met=" (if met "1" "0")
                            " KEEP=" (number->string (hash-ref buf "keep" 0))
                            " ROLLBACK=" (number->string (hash-ref buf "rollback" 0))
                            " " speed
                            "\n"
                            (perf:join (hash-ref buf "brief" '()) "\n")
                            "\n")))
            (hash-set! buf "intend-met" (if met 1 0))
            (perf:say buf "----")
            (display verdict)
            (perf:write-text (string-append out "/report.txt")
                             (string-append verdict (perf:join (hash-ref buf "lines" '()) "\n") "\n"))
            (perf:write-text (string-append out "/summary.json")
                             (json-encode (hash "before-ms" before-ms
                                                "after-ms" after-ms
                                                "before-samples" (hash-ref buf "before-samples" '())
                                                "after-samples" (hash-ref buf "after-samples" '())
                                                "keep" (hash-ref buf "keep" 0)
                                                "rollback" (hash-ref buf "rollback" 0)
                                                "hot-child" child
                                                "intend-met" (if met 1 0)
                                                "speedup-x" (perf:fmt-x before-ms after-ms)
                                                "verdict-speedup" speed)))
            (perf:write-text (string-append out "/evidence.json")
                             (json-encode (hash "before-ms" before-ms
                                                "after-ms" after-ms
                                                "min-faster-pct" (hash-ref spec "min-speedup-pct" 20)
                                                "before-samples" (hash-ref buf "before-samples" '())
                                                "after-samples" (hash-ref buf "after-samples" '())
                                                "class" (hash-ref spec "class" "")
                                                "hot-node" (hash-ref spec "hot-node" "")
                                                "prefix" (hash-ref spec "prefix" '())
                                                "cct" (hash-ref spec "profile-cct" (hash))
                                                "baseline-cct" (hash-ref spec "baseline-cct" (hash))
                                                "candidates" (hash-ref buf "results" '())
                                                "memory" (hash-ref buf "memory" '()))))))
            (perf:memory-save (perf:memory-path spec) (hash-ref buf "memory" '()))
          ; aura-perf#28: the report is on disk; keep the bus host up for the
          ; linger window so harness/maintainer can attach and query this
          ; round's committed evidence. No bus -> no-op.
          (perf:bus-linger (hash-ref buf "bus" #f) spec buf)
          ; The process exit follows intend-met. A met intend is success even
          ; when the demo's extra 50% bar, keep count, or child name differs.
          (if (and (eq? (hash-ref spec "require-success" #f) #t)
                   (= (hash-ref buf "intend-met" 0) 0))
              (error (string-append
                       "example did not meet the intend: hot-child="
                       child
                       " keep=" (number->string (hash-ref buf "keep" 0))
                       " rollback=" (number->string (hash-ref buf "rollback" 0))
                       " before=" (number->string before-ms)
                       " after=" (number->string after-ms)))
              buf)))))

(define (perf:say-list buf lines)
  (let loop ((xs (if (list? lines) lines '())))
    (if (null? xs)
        #t
        (begin (perf:say buf (car xs)) (loop (cdr xs))))))

(define (perf:record-gene-rollbacks buf picked)
  (let loop ((xs (hash-ref picked "verdicts" '())))
    (if (null? xs)
        #t
        (let ((v (car xs)))
          (perf:say buf (string-append "strategy-gene " (hash-ref v "id" "?")
                                       " " (hash-ref v "decision" "?")
                                       " reason=" (hash-ref v "reason" "")))
          (if (string=? (hash-ref v "decision" "") "ROLLBACK")
              (begin
                (perf:bump buf "rollback")
                (perf:note buf "reject" (hash-ref v "id" "?") (hash-ref v "reason" ""))
                (perf:audit-decision "perf-strategy" "ROLLBACK"
                                     (hash-ref v "reason" "")
                                     (hash "id" (hash-ref v "id" ""))))
              #t)
          (loop (cdr xs))))))

(define (perf:install-mine spec profile gene seal)
  (let ((g (if (hash? gene) gene (hash "ratio" 2 "actionable-ms" 1 "per-round" 2)))
        (prot (hash-ref seal "protected" '())))
    (let ((mined (perf:mine-with profile g prot)))
      (hash-set! spec "profile" profile)
      (hash-set! spec "profile-cct" (hash-ref profile "cct" #f))
      (hash-set! spec "class" (hash-ref mined "class" ""))
      (hash-set! spec "hot-node" (hash-ref mined "hot-node" ""))
      (hash-set! spec "prefix" (hash-ref mined "prefix" '()))
      (hash-set! spec "gene-mine" (lambda (p) (perf:mine-with p g prot)))
      (hash-set! spec "strategy-per-round" (let ((n (hash-ref g "per-round" 2)))
                                             (if (and (number? n) (> n 0)) n 2)))
      mined)))

(define (perf:opening-plan spec buf profile seal)
  (let ((picked (perf:select-gene profile (hash-ref spec "genes" '()) seal)))
    (perf:record-gene-rollbacks buf picked)
    (let ((gene (hash-ref picked "winner" #f)))
      (perf:install-mine spec profile gene seal)
      (if (hash? gene)
          (let ((plan (perf:commit-strategy spec (hash-ref gene "order" '()) buf)))
            (if plan
                plan
                (perf-strategy (hash "profile" profile
                                     "mine" (hash-ref spec "gene-mine" perf:mine)
                                     "hot-child-fn" perf:hot-child))))
          (perf-strategy (hash "profile" profile
                               "mine" (hash-ref spec "gene-mine" perf:mine)
                               "hot-child-fn" perf:hot-child))))))

(define (perf:usable-ms result)
  (and (hash? result)
       (string=? (hash-ref result "status" "") "ok")
       (= (hash-ref result "checksum-ok" 0) 1)
       (number? (hash-ref result "heldout-ms" -1))
       (>= (hash-ref result "heldout-ms" -1) 0)))

; Un-rebound baseline and null candidate, both in children. The gate
; reference is the null (own body, rebound). The un-rebound child is the
; number the verdict compares against, and the penalty is their gap.
; The null candidate's genome: the target's own body, so the gate
; compares a candidate against the same code with the rebind's tax
; paid. The seed's text carries it when the target is defined in the
; seed. A target whose defines live in another module (aura-redis's own
; src/ ✗) needs the spec to say where the body is, with
; "null-genome".
(define (perf:null-genome spec target)
  (let ((given (hash-ref spec "null-genome" "")))
    (if (and (string? given) (> (string-length given) 0))
        given
        (perf:extract-define (perf:read-text (hash-ref spec "seed-path" "")) target))))

; The null job: the target rebound to its own body. It is the gate's
; reference, and it is measured again in every round, so the reference
; and the candidates of that round come from the same moment of the
; machine's life.
(define (perf:null-job spec out)
  (let* ((target (hash-ref spec "target" "bench-kernel"))
         (null-body (perf:null-genome spec target)))
    (if (string=? null-body "")
        #f
        (perf:job-record spec
                         (hash "id" "null" "role" "null"
                               "genome" null-body "target" target)
                         out))))

; The body of ANY target's null candidate: the target's own body, so a
; candidate and its reference pay the same rebind.
;
; The spec's "null-genome" covers the spec's own target. A candidate may
; rebind another define (the catalog's "target"), and then the reference
; has to be the null of THAT define: a rebind of a hot define is worth
; 2x on its own on the Aura runtime, so judging a candidate against
; another define's null is not like for like.
;
; The other bodies come from the spec:
;   "null-genomes"  a hash of target -> body
;   "null-genome-fn" a procedure (target -> body)
; A target with no known body has no null: the gate must not silently
; use another define's null for it.
(define (perf:null-body spec target)
  (let ((given (hash-ref spec "null-genomes" (hash)))
        (fn (hash-ref spec "null-genome-fn" #f)))
    (let ((explicit (cond ((and (hash? given)
                                 (string? (hash-ref given target ""))
                                 (> (string-length (hash-ref given target "")) 0))
                            (hash-ref given target ""))
                           ((procedure? fn)
                            (let ((b (try (fn target) (catch (e) ""))))
                              (if (string? b) b "")))
                           (else ""))))
      (if (> (string-length explicit) 0)
          explicit
          (if (string=? target (hash-ref spec "target" "bench-kernel"))
              (perf:null-genome spec target)
              ; A target the seed defines can be rebound to its own
              ; body there: the seed's text is where its defines live.
              (perf:extract-define (perf:read-text (hash-ref spec "seed-path" "")) target))))))

; Every target this run may rebind: the spec's target first, then every
; mutation target of every candidate in the catalog (a set contributes
; all of its defines, not just the first).
(define (perf:run-targets spec)
  (let loop ((xs (perf:catalog spec)) (acc (list (hash-ref spec "target" "bench-kernel"))))
    (if (null? xs)
        (reverse acc)
        (let loop2 ((ts (perf:cand-targets spec (car xs))) (acc acc))
          (if (null? ts)
              (loop (cdr xs) acc)
              (loop2 (cdr ts)
                     (if (perf:member? acc (car ts))
                         acc
                         (append acc (list (car ts))))))))))

; The id of a target's null job: "null" for the spec's target, so the
; report keeps the name it always had, and "null-<target>" for the rest.
; The id is also a file name, so the target's name is made safe.
(define (perf:id-safe s)
  (let ((n (string-length s)))
    (let loop ((i 0) (out ""))
      (if (>= i n)
          out
          (let ((c (string-ref s i)))
            (loop (+ i 1)
                  (string-append out
                                 (if (or (and (>= c 48) (<= c 57))
                                         (and (>= c 65) (<= c 90))
                                         (and (>= c 97) (<= c 122)))
                                     (list->string (list c))
                                     "-"))))))))

(define (perf:null-id spec target)
  (if (string=? target (hash-ref spec "target" "bench-kernel"))
      "null"
      (string-append "null-" (perf:id-safe target))))

; One null job per target that has a body. The reference of a
; candidate is the null of the define the candidate rebinds.
(define (perf:null-jobs spec out)
  (let loop ((ts (perf:run-targets spec)) (acc '()))
    (if (null? ts)
        (reverse acc)
        (let* ((target (car ts))
               (body (perf:null-body spec target)))
          (if (string=? body "")
              (loop (cdr ts) acc)
              (loop (cdr ts)
                    (cons (perf:job-record spec
                                           (hash "id" (perf:null-id spec target)
                                                 "role" "null"
                                                 "genome" body "target" target)
                                           out)
                          acc)))))))

; The null results, keyed by the target each one rebinds.
(define (perf:null-results spec results)
  (let loop ((ts (perf:run-targets spec)) (acc (hash)))
    (if (null? ts)
        acc
        (let* ((target (car ts))
               (r (perf:find-result results (perf:null-id spec target))))
          (if r (hash-set! acc target r) #f)
          (loop (cdr ts) acc)))))

; The reference of a candidate: the null of the define the candidate
; rebinds. When that define has no null of its own, the round's
; reference is used and the report says so.
(define (perf:cand-baseline spec nulls fallback target)
  (let ((r (hash-ref nulls target #f)))
    (if (perf:usable-ms r)
        (hash-ref r "heldout-ms")
        fallback)))

; The candidates that can be judged and the ones that cannot.
;
; A candidate that rebinds a define the spec does not name has to be
; judged against the null of THAT define: a rebind of a hot define is
; worth 2x on its own on the Aura runtime, so a reference that never
; paid that rebind is not like for like. When the spec gave no
; rebindable body for that define, there is no reference, and the
; candidate is rejected instead of being measured against another
; define's null.
(define (perf:split-reference spec nulls cands)
  (let ((spec-target (hash-ref spec "target" "bench-kernel")))
    (let ((has-reference?
           (lambda (c)
             (let loop ((ts (perf:cand-targets spec c)))
               (if (null? ts)
                   #t
                   (let ((t (car ts)))
                     (if (or (string=? t spec-target)
                             (perf:usable-ms (hash-ref nulls t #f)))
                         (loop (cdr ts))
                         #f)))))))
      (let loop ((xs cands) (ok '()) (no '()))
        (if (null? xs)
            (list (reverse ok) (reverse no))
            (let ((c (car xs)))
              (if (has-reference? c)
                  (loop (cdr xs) (cons c ok) no)
                  (loop (cdr xs) ok (cons c no)))))))))

(define (perf:measure-references spec buf out)
  (let* ((target (hash-ref spec "target" "bench-kernel"))
         (null-body (perf:null-genome spec target))
         (base-rec (perf:job-record spec
                                    (hash "id" "baseline" "role" "baseline"
                                          "genome" "" "target" target)
                                    out))
         (null-recs (perf:null-jobs spec out))
         (jobs (cons base-rec null-recs)))
    (perf:write-jobs jobs)
    (let* ((batch (perf:launch-jobs jobs (hash-ref spec "worker")))
           (results (hash-ref batch "results" '()))
           (raw (perf:find-result results "baseline"))
           (nul (perf:find-result results "null"))
           (nulls (perf:null-results spec results))
           (raw-ok (perf:usable-ms raw))
           (null-ok (perf:usable-ms nul))
           (parent (if raw-ok #f (perf:baseline spec)))
           (raw-ms (if raw-ok
                       (hash-ref raw "heldout-ms")
                       (if (hash? parent) (hash-ref parent "median" -1) -1)))
           (raw-samples (if raw-ok
                            (hash-ref raw "samples" '())
                            (if (hash? parent) (hash-ref parent "samples" '()) '())))
           (gate-ms (if null-ok (hash-ref nul "heldout-ms") raw-ms))
           (gate-source (cond (null-ok "null-candidate")
                              (raw-ok "unrebound-child")
                              (else "parent-fallback"))))
      (if (and raw-ok
               (number? (hash-ref raw "screen-ms" -1))
               (>= (hash-ref raw "screen-ms" -1) 0))
          (hash-set! spec "screen-baseline-ms" (hash-ref raw "screen-ms"))
          #f)
      (hash-set! spec "raw-baseline-ms" (if (and (number? raw-ms) (> raw-ms 0)) raw-ms #f))
      (hash-set! spec "gate-baseline-ms" gate-ms)
      ; The baseline's worldline tree: the per-define times the site
      ; floor is measured against.
      (hash-set! spec "baseline-cct"
                    (if (hash? raw) (hash-ref raw "cct" (hash)) (hash)))
      (perf:say buf (string-append "baseline-heldout-ms " (number->string raw-ms)
                                   " source=" (if raw-ok "unrebound-child" "parent-fallback")
                                   " samples=" (perf:sample-text raw-samples)))
      (perf:say buf (string-append "null-candidate heldout-ms "
                                   (number->string (if null-ok
                                                       (hash-ref nul "heldout-ms")
                                                       -1))
                                   " rebound=1 target=" target
                                   (if (string=? null-body "") " genome=missing" "")))
      ; One null per target a candidate may rebind: a candidate that
      ; changes a define the spec does not name is judged against the
      ; null of THAT define. The rebind's tax is per target too: it is
      ; the gap between the un-rebound baseline and that target's null.
      (perf:say-each
        buf
        (let loop ((ts (perf:run-targets spec)) (lines '()))
          (if (null? ts)
              (reverse lines)
              (let* ((t (car ts))
                     (r (hash-ref nulls t #f))
                     (ok (perf:usable-ms r)))
                (loop (cdr ts)
                      (if (string=? t target)
                          lines
                          (cons (string-append "null-candidate target=" t
                                               " heldout-ms="
                                               (number->string (if ok
                                                                  (hash-ref r "heldout-ms")
                                                                  -1))
                                               (if ok
                                                   (string-append " rebound=1 rebind-penalty-ms="
                                                                  (number->string
                                                                    (- (hash-ref r "heldout-ms")
                                                                       raw-ms)))
                                                   " missing"))
                                lines)))))))
      (perf:say buf (string-append "gate-baseline-ms " (number->string gate-ms)
                                   " source=" gate-source))
      (if (and null-ok raw-ok)
          (perf:say buf (string-append "rebind-penalty-ms "
                                       (number->string (- (hash-ref nul "heldout-ms") raw-ms))))
          #f)
      (if (and raw-ok (number? (hash-ref raw "screen-ms" -1)))
          (perf:say buf (string-append "screen-baseline-ms "
                                       (number->string (hash-ref raw "screen-ms" -1))
                                       " n=" (number->string (hash-ref spec "screen-n" 0))
                                       " source=unrebound-child"))
          #f)
      (hash "raw-ms" raw-ms
            "raw-samples" raw-samples
            "gate-ms" gate-ms
            "gate-source" gate-source))))

(define (perf:say-machine buf)
  (let ((info (try (perf:sysinfo) (catch (e) #f))))
    (if (not (hash? info))
        (perf:say buf "machine skipped")
        (begin
          (hash-set! buf "machine" info)
          (perf:say-list buf (perf:take (perf:sysinfo-lines info) 3))
          (perf:say-list buf (perf:take (perf:advice-lines (perf:advice info (hash))) 1))))))

(define (perf:report-worldlines spec buf)
  (let ((ids (perf:cct-cleared (hash-ref buf "results" '())
                               (hash-ref spec "profile-cct" #f)
                               (hash-ref spec "prefix" '()))))
    (perf:say buf (string-append "cleared " (if (null? ids) "none" (perf:join ids ","))))
    (perf:say buf (string-append "negative-query class=" (hash-ref spec "class" "")
                                 " hot-node=" (hash-ref spec "hot-node" "")
                                 " blocked=" (perf:neg-ideas (hash-ref buf "memory" '())
                                                             (hash-ref spec "class" "")
                                                             (hash-ref spec "hot-node" ""))))
    (perf:say buf (string-append "negative-blocked same-hot="
                                 (if (perf:neg-blocked? (hash-ref buf "memory" '())
                                                        (hash-ref spec "class" "")
                                                        (hash-ref spec "hot-node" "")
                                                        "wrong-scale")
                                     "1" "0")
                                 " other-hot="
                                 (if (perf:neg-blocked? (hash-ref buf "memory" '())
                                                        (hash-ref spec "class" "")
                                                        "other-node"
                                                        "wrong-scale")
                                     "1" "0")))))

(define (perf:after-keep spec buf winner baseline out)
  (let ((q (perf:cct-worldline-query (hash-ref spec "profile-cct" #f)
                                     (if (hash? winner) (hash-ref winner "cct" #f) #f)
                                     (hash-ref spec "prefix" '()))))
    (perf:say buf (string-append "continue " (if (perf:should-continue? q) "1" "0")))
    (if (and (hash? winner)
             (= (hash-ref winner "prefix-removed" 0) 1)
             (= (hash-ref winner "cost-moved" 0) 0))
        (perf:say buf "hypothesis-confirmed prefix-cleared cost-stayed")
        #f)
    (if (not (perf:should-continue? q))
        #f
        (let ((mined (perf:mine-with (hash "cct" (hash-ref winner "cct" #f))
                                     (hash "ratio" 2 "actionable-ms" 1)
                                     (perf:protected spec))))
          (perf:say buf (string-append "continue-mined class=" (hash-ref mined "class" "")
                                       " hot-node=" (hash-ref mined "hot-node" "")
                                       " hypotheses=" (number->string (length (hash-ref mined "hypotheses" '())))))
          (if (or (null? (hash-ref mined "hypotheses" '()))
                  (<= (perf:budget-left spec buf) 0))
              #f
              (begin
                (hash-set! spec "class" (hash-ref mined "class" ""))
                (hash-set! spec "hot-node" (hash-ref mined "hot-node" ""))
                (hash-set! spec "prefix" (hash-ref mined "prefix" '()))
                (hash-set! spec "profile-cct" (hash-ref winner "cct" #f))
                (let* ((plan (hash "order" (let loop ((xs (hash-ref mined "hypotheses" '())) (acc '()))
                                             (if (null? xs)
                                                 (reverse acc)
                                                 (loop (cdr xs) (cons (hash-ref (car xs) "id" "") acc))))
                                   "per-round" 1))
                       (cands (perf:round-candidates spec plan buf)))
                  (perf:say buf (string-append "continue candidates " (perf:ids cands)))
                  (hash-set! buf "budget" (+ (hash-ref buf "budget" 0) (length cands)))
                  (perf:trial-round spec cands out buf baseline))))))))

; ── headroom probes ──────────────────────────────────────────────
; How much can a site win at most? Replace it with a cheap stub, run the
; kernel once, and compare. This is evidence, not a candidate: it never
; enters a gate, never KEEPs, and never changes the live workspace. The
; probe runs in its own trial worldline, like every other worker job.
(define PERF-HEADROOM-MAX 6)

(define (perf:headroom-stub spec site)
  (let* ((stubs (hash-ref spec "headroom-stubs" (hash)))
         (one (if (hash? stubs) (hash-ref stubs site #f) #f))
         (dflt (hash-ref spec "headroom-stub" "0")))
    (cond ((and (string? one) (> (string-length one) 0)) one)
          ((and (string? dflt) (> (string-length dflt) 0)) dflt)
          (else "0"))))

; The hottest user defines the profile names, minus the kernel and the
; protected boundary. Top PERF-HEADROOM-MAX (or the spec's headroom-max).
(define (perf:headroom-sites spec profile)
  (let* ((kernel (hash-ref spec "kernel" (hash-ref spec "target" "bench-kernel")))
         (protected (perf:protected spec))
         (maxn (let ((n (hash-ref spec "headroom-max" PERF-HEADROOM-MAX)))
                 (if (and (number? n) (> n 0)) n PERF-HEADROOM-MAX))))
    (let loop ((xs (perf:hotspots profile)) (acc '()))
      (if (or (null? xs) (>= (length acc) maxn))
          (reverse acc)
          (let ((n (hash-ref (car xs) "name" "")))
            (loop (cdr xs)
                  (if (and (string? n) (not (string=? n ""))
                           (not (string=? n kernel))
                           (not (perf:member? protected n))
                           (not (perf:member? acc n)))
                      (cons n acc)
                      acc)))))))

(define (perf:headroom-job spec site out)
  (perf:job-record spec
                   (hash "id" (string-append "headroom-" (perf:id-safe site))
                         "role" "headroom"
                         "target" site
                         "genome" ""
                         "headroom-stub" (perf:headroom-stub spec site))
                   out))

(define (perf:headroom-pct base free)
  (if (and (number? base) (> base 0)
           (number? free) (>= free 0))
      (quotient (* (- base free) 100) base)
      -1))

; A saved millisecond delta as a percentage of its base.
(define (perf:delta-pct base delta)
  (if (and (number? base) (> base 0) (number? delta) (>= delta 0))
      (quotient (* delta 100) base)
      -1))

; One probe batch: a fresh baseline child and one child per site. The
; batch is diagnostic, so it does not touch the intend's budget counter.
; A site whose stub makes the kernel throw is reported unavailable, not
; as a 0 ms win.
(define (perf:headroom-probes spec buf profile out baseline)
  (if (or (eq? (hash-ref spec "headroom" #t) #f)
          (not (number? baseline)) (<= baseline 0))
      (hash)
      (let ((sites (perf:headroom-sites spec profile)))
        (if (null? sites)
            (begin (hash-set! spec "headroom" (hash)) (hash))
            (let* ((kernel (hash-ref spec "kernel" (hash-ref spec "target" "bench-kernel")))
             (base-rec (perf:job-record spec
                                        (hash "id" "headroom-baseline"
                                              "role" "baseline"
                                              "target" kernel
                                              "genome" "")
                                        out))
             (jobs (cons base-rec
                         (let loop ((xs sites) (acc '()))
                           (if (null? xs)
                               (reverse acc)
                               (loop (cdr xs)
                                     (cons (perf:headroom-job spec (car xs) out) acc)))))))
        (perf:write-jobs jobs)
        (let* ((batch (perf:launch-jobs jobs (hash-ref spec "worker")))
               (results (hash-ref batch "results" '()))
               (base-res (perf:find-result results "headroom-baseline"))
               (base-ms (if (perf:usable-ms base-res)
                            (hash-ref base-res "heldout-ms")
                            baseline))
               (tab (hash)))
          (let loop ((xs sites))
            (if (null? xs)
                #t
                (let* ((site (car xs))
                       (id (string-append "headroom-" (perf:id-safe site)))
                       (r (perf:find-result results id))
                       (free (if (and (perf:usable-ms r)
                                      (= (hash-ref r "headroom-restored" 0) 1)
                                      (number? (hash-ref r "heldout-ms" -1)))
                                 (hash-ref r "heldout-ms")
                                 -1)))
                  (if (>= free 0)
                      (let ((pct (perf:headroom-pct base-ms free)))
                        (hash-set! tab site
                                   (hash "base" base-ms "free" free "pct" pct))
                        (perf:say buf (string-append
                                        "site-headroom " site
                                        " base-ms=" (number->string base-ms)
                                        " free-ms=" (number->string free)
                                        " headroom-pct=" (number->string pct))))
                      (perf:say buf (string-append
                                      "site-headroom-unavailable " site
                                      " reason=" (if (hash? r)
                                                     (hash-ref r "fidelity"
                                                               (hash-ref r "error" "no-result"))
                                                     "no-result"))))
                  (loop (cdr xs)))))
            (hash-set! spec "headroom" tab)
            tab))))))

; Sum of the probed sites' headroom, or #f when any site was not probed.
; The base sum is the same probes' references, so a candidate's headroom
; percentage is measured against the shape the probes used, not against
; the candidate's own rebind reference.
(define (perf:headroom-of spec sites)
  (let ((tab (hash-ref spec "headroom" (hash))))
    (let loop ((xs (if (list? sites) sites '())) (ms 0) (base 0))
      (if (null? xs)
          (hash "ms" ms "base" base)
          (let ((h (hash-ref tab (car xs) #f)))
            (if (and (hash? h)
                     (number? (hash-ref h "base" -1))
                     (number? (hash-ref h "free" -1)))
                (loop (cdr xs)
                      (+ ms (- (hash-ref h "base") (hash-ref h "free")))
                      (+ base (hash-ref h "base")))
                #f))))))

; The model proposal and the headroom probes are independent: both read
; the profile and the gate reference, neither writes the other's values.
; Run them as two fibers and join before the first round. The model call
; is the long one when a provider is wired; the probes are a handful of
; short child jobs. If orch:parallel is unavailable, the same two thunks
; run sequentially, so the round is never blocked on the scheduler.
(define (perf:no-llm reason)
  (hash "ok" #f "candidates" '() "budget" 0 "error" reason))

(define (perf:parallel-propose-headroom spec buf plan profile child hottest refs out baseline)
  (let ((box (hash "llm" (perf:no-llm "not-run"))))
    (let ((propose (lambda (ignored)
                     (hash-set! box "llm"
                                (try (perf:llm-propose
                                       (perf:llm-context spec buf plan profile child hottest refs))
                                     (catch (e) (perf:no-llm "fiber-error"))))))
          (head (lambda (ignored)
                  (try (perf:headroom-probes spec buf profile out baseline)
                       (catch (e) #f)))))
      (let ((rs (try (orch:parallel (list propose head) 0) (catch (e) #f))))
        (if (and (list? rs) (pair? rs))
            (hash-ref box "llm" (perf:no-llm "not-run"))
            (begin
              (propose #f)
              (head #f)
              (hash-ref box "llm" (perf:no-llm "not-run"))))))))

(define (perf:optimize spec)
  (let* ((memory-path (perf:memory-path spec))
         (buf (hash "lines" '() "brief" '()
                    "memory" (perf:memory-load memory-path) "results" '()
                    "keep" 0 "rollback" 0 "after-ms" -1 "budget" 0 "llm-budget" 0))
        (out (hash-ref spec "out-dir" "out")))
    (perf:ensure-dirs out)
    (hash-set! spec "min-speedup-pct"
               (hash-ref (perf:intend-seal spec) "effective-min-faster-pct" 20))
    (if (not (perf:install-seed (hash-ref spec "seed-path")))
        (perf:say buf "error empty-seed")
        (let* ((bus (perf:bus-start spec buf))
               (profile (perf:collect ((hash-ref spec "regions-fn"))
                                      (hash "repeats" (hash-ref spec "profile-repeats" 3)
                                            "targets" (hash-ref spec "perf-targets" '())
                                            "batch-command" (hash-ref spec "profile-command" ""))))
               (child (perf:hot-child profile))
               (hottest (perf:hottest profile))
               (seal (perf:intend-seal spec))
               (plan (perf:opening-plan spec buf profile seal))
               (refs (perf:measure-references spec buf out))
               (baseline (hash-ref refs "gate-ms" -1))
               (pct (hash-ref spec "min-speedup-pct" 20)))
          (hash-set! buf "before-ms" (hash-ref refs "raw-ms" -1))
          (hash-set! buf "before-samples" (hash-ref refs "raw-samples" '()))
          (hash-set! buf "profile" profile)
          (perf:say buf (string-append "aura-perf " (hash-ref spec "label" "sum-scan")))
          (perf:say buf (string-append "memory-loaded "
                                         (number->string (length (hash-ref buf "memory" '())))
                                         " path=" (perf:memory-path spec)))
          (perf:say buf (perf:tool-line profile))
          (let loop ((xs (perf:note-lines profile)))
            (if (null? xs) #t (begin (perf:say buf (car xs)) (loop (cdr xs)))))
          (let loop ((xs (perf:hotspot-lines profile)))
            (if (null? xs) #t (begin (perf:say buf (car xs)) (loop (cdr xs)))))
          (hash-set! buf "bus" bus)
          (if bus
              (perf:say buf (string-append "bus cct-records "
                                           (number->string (perf:bus-publish-profile bus profile))))
              #f)
          (let loop ((xs (perf:counter-lines profile)))
            (if (null? xs) #t (begin (perf:say buf (car xs)) (loop (cdr xs)))))
          (perf:say buf (string-append "hottest " hottest))
          (perf:say buf (string-append "hot-child " child))
          (let ((pinfo (hash-ref profile "perf" (hash))))
            (perf:say buf (string-append "perf-record-samples "
                                         (number->string (hash-ref pinfo "record-samples" -1))
                                         " event=" (hash-ref pinfo "record-event" ""))))
          (perf:say buf (string-append "mined class=" (hash-ref plan "class" "")
                                       " hot-node=" (hash-ref plan "hotspot" "")
                                       " site=" (hash-ref plan "site" "")))
          (perf:say buf (string-append "prefix " (perf:join (hash-ref spec "prefix" (hash-ref plan "prefix" '())) ">")))
          (perf:say buf (string-append "strategy-order"
                                       (perf:join (map (lambda (s) (string-append " " s))
                                                       (perf:order-of plan))
                                                  "")))
          (perf:say buf (string-append "process-state region="
                                       (hash-ref profile "region-measure" "in-process")
                                       " held-out=trial-child comparable=0"))
          (perf:say-machine buf)
          (hash-set! buf "llm"
                     (perf:parallel-propose-headroom spec buf plan profile child hottest refs out baseline))
          (perf:say-each buf (perf:llm-lines (hash-ref buf "llm" (perf:no-llm "not-run"))))
          (let ((bin (hash-ref (hash-ref profile "tools" (hash)) "perf" "missing")))
            (if (and (string? bin) (not (string=? bin "missing")))
                (let ((live (perf:measure-live bin (lambda () (perf:run-kernel spec 4000)))))
                  (perf:say buf (string-append "perf-live-before-task-clock-ms "
                                               (number->string (hash-ref live "task-clock" -1)))))
                #f))
          (let* ((cands (perf:round-candidates spec plan buf))
                 (llm-cands (perf:llm-round-candidates spec (hash-ref buf "llm" (perf:no-llm "not-run")) buf))
                 (all (append cands llm-cands))
                 (results (begin
                            (perf:say buf (string-append "round 1 candidates " (perf:ids all)))
                            (hash-set! buf "budget"
                                       (+ (hash-ref buf "budget" 0) (length cands)))
                            (hash-set! buf "llm-budget" (length llm-cands))
                            ; The model's candidates join the catalog, so
                            ; the round measures the null of each define
                            ; they rebind, and a winner's entry is found
                            ; like any other's. Their ids are in no
                            ; strategy order: perf:rule-propose never
                            ; proposes them, and the next round's plan
                            ; does not carry them.
                            (if (pair? llm-cands)
                                (hash-set! spec "catalog"
                                           (append (perf:catalog spec) llm-cands))
                                #f)
                            (perf:trial-round spec all out buf baseline)))
                 (best (perf:best-passing spec results baseline pct (perf:raw-of spec))))
            (let ((winner (perf:choose-winner spec (perf:rule-results results) best
                                              plan child hottest out buf baseline pct)))
              (if (not winner)
                  (perf:say buf "kernel unchanged")
                  (let ((entry (perf:entry (perf:catalog spec) (hash-ref winner "id" ""))))
                    (if entry
                        (perf:commit-kernel spec entry baseline buf winner)
                        (perf:say buf "kernel ROLLBACK reason=missing-catalog-entry"))))
              (perf:report-worldlines spec buf)
              (perf:after-keep spec buf winner baseline out)
              (perf:finish spec buf profile child out)))))))

; One entry. The caller supplies an intend and a target. The runtime
; mines, proposes, trials, and stops when the intend holds or the
; strategy has no remaining candidate.
(define (perf:autotune spec)
  (perf:optimize spec))
