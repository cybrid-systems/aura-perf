; Profile, propose, trial on forked worldlines, gate, KEEP or ROLLBACK.
; The live workspace is only rewritten after a candidate has already
; passed the held-out gate in a child process. Strategy rewrites use
; ast:snapshot / ast:restore on this process.

(export perf:optimize perf:autotune)

(require "std/evo-core" all:)
(require "std/evo" all:)
(require "std/process" all:)
(require "lib/perf/util" all:)
(require "lib/perf/score" all:)
(require "lib/perf/gate" all:)
(require "lib/perf/profile" all:)
(require "lib/perf/cct" all:)
(require "lib/perf/query" all:)
(require "lib/perf/propose" all:)
(require "lib/perf/audit" all:)
(require "lib/perf/trial" all:)
(require "lib/perf/memory" all:)
(require "lib/perf/gene" all:)
(require "lib/perf/sysinfo" all:)
(require "lib/perf/layers" all:)

(define (perf:say buf line)
  (hash-set! buf "lines" (append (hash-ref buf "lines" '()) (list line)))
  (display line)
  (newline)
  line)

(define (perf:bump buf key)
  (hash-set! buf key (+ (hash-ref buf key 0) 1)))

(define (perf:note buf kind id reason)
  (hash-set! buf "brief"
             (append (hash-ref buf "brief" '())
                     (list (string-append kind " " id " " reason)))))

(define (perf:short-reason reason)
  (cond ((and (string? reason) (>= (string-length reason) 8)
              (string=? (substring reason 0 8) "checksum"))
         "checksum")
        ((string=? reason "protected-define") "protected")
        ((string=? reason "gate-pass") "gate-pass")
        ((string=? reason "screen-pruned") "screen-pruned")
        ((string=? reason "no-speedup") "no-speedup")
        ((string=? reason "held-out gate") "held-out gate")
        (else (if (string? reason) reason "error"))))

(define (perf:audit-decision target decision reason evidence)
  (try (evo:record! target decision reason
                    (if (hash? evidence) evidence (hash))
                    "" 0 "" (hash))
       (catch (e) #f)))

(define (perf:ensure-dirs out)
  (shell (string-append "mkdir -p " out "/jobs " out "/trials")))

(define (perf:install-seed path)
  (let ((text (perf:read-text path)))
    (if (string=? text "")
        #f
        (begin
          (set-code text)
          (eval-current)
          #t))))

(define (perf:baseline spec)
  (let ((xs (perf:range (hash-ref spec "heldout-n" 0))))
    (perf:time-checked (hash-ref spec "repeats" 3)
                       (hash-ref spec "call")
                       xs)))

(define (perf:catalog spec)
  (hash-ref spec "catalog" '()))

(define (perf:entry catalog id)
  (let loop ((xs catalog))
    (if (null? xs)
        #f
        (if (string=? (hash-ref (car xs) "id" "") id)
            (car xs)
            (loop (cdr xs))))))

(define (perf:job-record spec cand out)
  (let ((id (hash-ref cand "id" "candidate")))
    (hash "id" id
          "seed" (hash-ref spec "seed-path")
          "target" (hash-ref spec "target" "bench-kernel")
          "genome" (hash-ref cand "genome" "")
          "heldout-n" (hash-ref spec "heldout-n")
          "repeats" (hash-ref spec "repeats" 3)
          "timeout-ms" 60000
          "screen-n" (hash-ref spec "screen-n" 0)
          "screen-baseline-ms" (hash-ref spec "screen-baseline-ms" -1)
          "screen-slack-ms" (hash-ref spec "screen-slack-ms" 5)
          "result" (string-append out "/jobs/" id ".result.json")
          "job" (string-append out "/jobs/" id ".job.json")
          "log" (string-append out "/trials/" id ".jsonl"))))

(define (perf:write-jobs records)
  (let loop ((xs records))
    (if (null? xs)
        #t
        (begin
          (perf:write-text (hash-ref (car xs) "job") (json-encode (car xs)))
          (loop (cdr xs))))))

(define (perf:find-result results id)
  (let loop ((xs results))
    (if (null? xs)
        #f
        (if (and (hash? (car xs)) (string=? (hash-ref (car xs) "id" "") id))
            (car xs)
            (loop (cdr xs))))))

(define (perf:reason result baseline pct)
  (cond ((not (hash? result)) "no-result")
        ((not (string=? (hash-ref result "status" "") "ok"))
         (let ((e (hash-ref result "error" "")))
           (if (and (string? e) (not (string=? e "")))
               e
               (string-append "trial-" (hash-ref result "status" "error")))))
        ((or (string=? (hash-ref result "fidelity" "") "checksum")
             (not (or (eq? (hash-ref result "checksum-ok" 0) 1)
                      (eq? (hash-ref result "checksum-ok" 0) #t))))
         (string-append "checksum mismatches="
                        (number->string (hash-ref result "mismatches" -1))))
        ((not (or (eq? (hash-ref result "live-unchanged" 0) 1)
                  (eq? (hash-ref result "live-unchanged" 0) #t)))
         "isolation-violation")
        ((string=? (hash-ref result "fidelity" "") "screen-pruned") "screen-pruned")
        ((not (perf:speedup-ok? baseline (hash-ref result "heldout-ms" -1) pct))
         "no-speedup")
        (else "gate-pass")))

(define (perf:format-candidate result baseline pct)
  (string-append
    "candidate " (hash-ref result "id" "?")
    " " (if (string=? (perf:reason result baseline pct) "gate-pass") "PASS" "ROLLBACK")
    " reason=" (perf:reason result baseline pct)
    " heldout-ms=" (number->string (hash-ref result "heldout-ms" -1))
    " mismatches=" (number->string (hash-ref result "mismatches" -1))
    " live-unchanged=" (number->string (hash-ref result "live-unchanged" 0))
    " trial-applied=" (number->string (hash-ref result "trial-applied" 0))
    " dur-ms=" (number->string (hash-ref result "dur-ms" 0))))

(define (perf:sum-dur results)
  (let loop ((xs results) (acc 0))
    (if (null? xs)
        acc
        (loop (cdr xs) (+ acc (hash-ref (car xs) "dur-ms" 0))))))

(define (perf:trial-round spec cands out buf baseline)
  (let ((records (let loop ((xs cands) (acc '()))
                   (if (null? xs)
                       (reverse acc)
                       (loop (cdr xs) (cons (perf:job-record spec (car xs) out) acc))))))
    (perf:write-jobs records)
    (let* ((fp-before (evo:source-fingerprint))
           (batch (perf:launch-jobs records (hash-ref spec "worker")))
           (fp-after (evo:source-fingerprint))
           (results (hash-ref batch "results" '()))
           (pct (hash-ref spec "min-speedup-pct" 20)))
      (perf:say buf (string-append
                      "round-wall-ms " (number->string (hash-ref batch "wall-ms" 0))
                      " round-dur-sum-ms " (number->string (perf:sum-dur results))
                      " jobs " (number->string (length records))))
      (perf:say buf (string-append
                      "live-fingerprint-during-trials "
                      (number->string fp-before) " -> " (number->string fp-after)
                      (if (= fp-before fp-after) " unchanged" " CHANGED")))
      (let loop ((xs cands))
        (if (null? xs)
            results
            (let* ((id (hash-ref (car xs) "id" ""))
                   (result (perf:find-result results id)))
              (if (not result)
                  (begin
                    (perf:say buf (string-append "candidate " id " ROLLBACK reason=missing-result"))
                    (perf:note buf "reject" id "missing-result")
                    (perf:bump buf "rollback")
                    (perf:audit-decision (hash-ref spec "target" "bench-kernel")
                                         "ROLLBACK" "missing-result" (hash "id" id)))
                  (let* ((reason (perf:reason result baseline pct))
                         (q (perf:cct-worldline-query
                              (hash-ref spec "profile-cct" #f)
                              (hash-ref result "cct" #f)
                              (hash-ref spec "prefix" '())))
                         (pass (string=? reason "gate-pass")))
                    (hash-set! result "prefix-removed" (if (eq? (hash-ref q "prefix-removed" #f) #t) 1 0))
                    (hash-set! result "cost-moved" (if (eq? (hash-ref q "cost-moved" #f) #t) 1 0))
                    (hash-set! result "measured" (if (eq? (hash-ref q "measured" #f) #t) 1 0))
                    (hash-set! result "moved-to" (perf:join (hash-ref q "moved-to" '()) ","))
                    (hash-set! result "target" (hash-ref (car xs) "target" ""))
                    (hash-set! buf "results" (append (hash-ref buf "results" '()) (list result)))
                    (perf:say buf (perf:format-candidate result baseline pct))
                    (perf:say buf (string-append "worldline " id
                                                 " measured=" (number->string (hash-ref result "measured" 0))
                                                 " prefix-removed=" (number->string (hash-ref result "prefix-removed" 0))
                                                 " cost-moved=" (number->string (hash-ref result "cost-moved" 0))
                                                 " moved-to=" (hash-ref result "moved-to" "")
                                                 " fidelity=" (hash-ref result "fidelity" "")))
                    (perf:note buf (if pass "pass" "reject") id (perf:short-reason reason))
                    (perf:audit-decision
                      (hash-ref spec "target" "bench-kernel")
                      (if pass "PROPOSE" "ROLLBACK")
                      reason
                      (hash "id" id
                            "heldout-ms" (hash-ref result "heldout-ms" -1)
                            "mismatches" (hash-ref result "mismatches" -1)
                            "class" (hash-ref spec "class" "")
                            "hot-node" (hash-ref spec "hot-node" "")
                            "prefix-removed" (hash-ref result "prefix-removed" 0)
                            "cost-moved" (hash-ref result "cost-moved" 0)
                            "moved-to" (hash-ref result "moved-to" "")
                            "fidelity" (hash-ref result "fidelity" "")
                            "cct-delta" (perf:delta-brief (hash-ref q "delta" '()))))
                    (if pass
                        #t
                        (begin
                          (perf:bump buf "rollback")
                          (hash-set! buf "memory"
                                     (perf:neg-remember (hash-ref buf "memory" '())
                                                        (hash-ref spec "class" "")
                                                        (hash-ref spec "hot-node" "")
                                                        id
                                                        (perf:short-reason reason))))))))
              (loop (cdr xs)))))))

(define (perf:best-passing results baseline pct)
  (let loop ((xs results) (best #f))
    (if (null? xs)
        best
        (let ((r (car xs)))
          (if (and (hash? r) (perf:accept? baseline r pct))
              (if (or (not best)
                      (< (hash-ref r "heldout-ms" 999999999)
                         (hash-ref best "heldout-ms" 999999999)))
                  (loop (cdr xs) r)
                  (loop (cdr xs) best))
              (loop (cdr xs) best))))))

(define (perf:any-infra? results)
  (let loop ((xs (if (list? results) results '())))
    (if (null? xs)
        #f
        (if (or (not (hash? (car xs)))
                (not (string=? (hash-ref (car xs) "status" "") "ok")))
            #t
            (loop (cdr xs))))))

(define (perf:failed-ids results baseline pct)
  (let loop ((xs results) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((r (car xs)))
          (if (and (hash? r) (not (perf:accept? baseline r pct)))
              (loop (cdr xs) (cons (hash-ref r "id" "") acc))
              (loop (cdr xs) acc))))))

(define (perf:commit-kernel spec entry baseline buf)
  ; Snapshot first. A parallel let could rebind before the snapshot.
  (let* ((snap (ast:snapshot "perf-kernel"))
         (compile-before (perf:compile-snap))
         (rb (mutate:rebind (hash-ref spec "target" "bench-kernel")
                            (hash-ref entry "genome" "")
                            "perf-keep")))
    (if (not (eq? rb #t))
        (begin
          (perf:say buf (string-append "kernel ROLLBACK reason=rebind-"
                                       (if (string? rb) rb "failed")))
          (perf:note buf "reject" (hash-ref entry "id" "?") "rebind")
          (perf:bump buf "rollback")
          (perf:audit-decision (hash-ref spec "target") "ROLLBACK" "rebind-failed" (hash))
          #f)
        (begin
          (eval-current)
          (let* ((compile-after (perf:compile-snap))
                 (cd (perf:compile-delta compile-before compile-after))
                 (chk (perf:check-kernel (hash-ref spec "call") (perf:check-inputs)))
                 (tm (perf:time-checked (hash-ref spec "repeats" 3)
                                        (hash-ref spec "call")
                                        (perf:range (hash-ref spec "heldout-n"))))
                 (pct (hash-ref spec "min-speedup-pct" 20))
                 (ok (and (eq? (hash-ref chk "ok" #f) #t)
                          (= (hash-ref tm "mismatches" 1) 0)
                          (perf:speedup-ok? baseline (hash-ref tm "median" -1) pct))))
            (if ok
                (begin
                  (hash-set! buf "after-ms" (hash-ref tm "median"))
                  (hash-set! buf "after-samples" (hash-ref tm "samples" '()))
                  (perf:bump buf "keep")
                  (hash-set! buf "world-rebuilt" (hash-ref cd "world-rebuilt" -1))
                  (perf:audit-decision (hash-ref spec "target") "KEEP" "held-out gate"
                                       (hash "heldout-ms" (hash-ref tm "median")
                                             "id" (hash-ref entry "id" "")
                                             "world-rebuilt" (hash-ref cd "world-rebuilt" -1)
                                             "cascade-full" (hash-ref cd "cascade-full" 0)
                                             "body-only" (hash-ref cd "body-only" 0)))
                  (perf:say buf (string-append "kernel KEEP id=" (hash-ref entry "id" "")
                                               " heldout-ms=" (number->string (hash-ref tm "median"))))
                  (perf:say buf (string-append "compile-delta world-rebuilt="
                                               (number->string (hash-ref cd "world-rebuilt" -1))
                                               " cascade-full=" (number->string (hash-ref cd "cascade-full" 0))
                                               " body-only=" (number->string (hash-ref cd "body-only" 0))
                                               " relower-full=" (number->string (hash-ref cd "relower-full" 0))))
                  (perf:note buf "keep" (hash-ref entry "id" "") "held-out gate")
                  #t)
                (begin
                  (ast:restore snap)
                  (eval-current)
                  (perf:bump buf "rollback")
                  (perf:audit-decision (hash-ref spec "target") "ROLLBACK"
                                       "post-keep-verify-failed" (hash))
                  (perf:note buf "reject" (hash-ref entry "id" "") "intend")
                  (perf:say buf "kernel ROLLBACK reason=post-keep-verify-failed")
                  #f)))))))

(define (perf:commit-strategy spec order buf)
  (let ((k (let ((n (hash-ref spec "strategy-per-round" 1)))
             (if (and (number? n) (> n 0)) n 1)))
        (src-order order))
    (let ((src (perf:strategy-source src-order k)))
    (if (not (string? src))
        (begin
          (perf:say buf "strategy ROLLBACK reason=unsafe-order")
          (perf:note buf "reject" "perf-strategy" "unsafe-order")
          (perf:bump buf "rollback")
          #f)
        (let* ((snap (ast:snapshot "perf-strategy"))
               (rb (mutate:rebind "perf-strategy" src "perf-strategy-revise")))
          (if (not (eq? rb #t))
              (begin
                (perf:say buf "strategy ROLLBACK reason=rebind-failed")
                (perf:note buf "reject" "perf-strategy" "rebind")
                (perf:bump buf "rollback")
                (perf:audit-decision "perf-strategy" "ROLLBACK" "rebind-failed" (hash))
                #f)
              (begin
                (eval-current)
                (let ((mine-fn (hash-ref spec "gene-mine" perf:mine))
                      (profile (hash-ref spec "profile" (hash))))
                (let ((plan (try (perf-strategy (hash "profile" profile
                                                             "mine" mine-fn
                                                             "hot-child-fn" perf:hot-child))
                                 (catch (e) #f))))
                  (if (and (hash? plan)
                           (equal? (perf:order-of plan) order))
                      (begin
                        (perf:bump buf "keep")
                        (perf:note buf "keep" "perf-strategy" "classifies-hot-prefix")
                        (perf:audit-decision "perf-strategy" "KEEP"
                                             "strategy gene order"
                                             (hash "order" order))
                        (perf:say buf (string-append "strategy KEEP order"
                                                     (perf:join (map (lambda (s) (string-append " " s)) order) "")))
                        plan)
                      (begin
                        (ast:restore snap)
                        (eval-current)
                        (perf:bump buf "rollback")
                        (perf:audit-decision "perf-strategy" "ROLLBACK" "strategy-verify-failed" (hash))
                        (perf:say buf "strategy ROLLBACK reason=strategy-verify-failed")
                        #f)))))))))))

(define (perf:ids cands)
  (let loop ((xs cands) (acc ""))
    (if (null? xs)
        acc
        (loop (cdr xs)
              (string-append acc (if (string=? acc "") "" ",")
                             (hash-ref (car xs) "id" "?"))))))

(define (perf:sample-text samples)
  (let loop ((xs (if (list? samples) samples '())) (acc ""))
    (if (null? xs)
        acc
        (loop (cdr xs)
              (string-append acc (if (string=? acc "") "" ",")
                             (number->string (car xs)))))))

(define (perf:hotspot-lines profile)
  (let loop ((xs (perf:hotspots profile)) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((h (car xs)))
          (loop (cdr xs)
                (cons (string-append
                        "hotspot " (hash-ref h "name" "?")
                        " self-ms=" (number->string (hash-ref h "self-ms" 0))
                        " calls=" (number->string (hash-ref h "calls" 0))
                        " share=" (number->string (hash-ref h "share" 0))
                        " source=" (hash-ref h "source" "")
                        " stack=" (perf:join (hash-ref h "stack" '()) ">"))
                      acc))))))

(define (perf:counter-lines profile)
  (let ((c (perf:counters profile)))
    (let loop ((ks (if (hash? c) (sort (hash-keys c) string<?) '())) (acc '()))
      (if (null? ks)
          (reverse acc)
          (loop (cdr ks)
                (cons (string-append "counter " (car ks) "="
                                     (number->string (hash-ref c (car ks) 0)))
                      acc))))))

(define (perf:note-lines profile)
  (let loop ((xs (if (hash? profile) (hash-ref profile "notes" '()) '())) (acc '()))
    (if (null? xs)
        (reverse acc)
        (loop (cdr xs) (cons (string-append "note " (car xs)) acc)))))

(define (perf:tool-line profile)
  (let ((t (if (hash? profile) (hash-ref profile "tools" (hash)) (hash))))
    (string-append "tools perf=" (hash-ref t "perf" "?")
                   " gprof=" (hash-ref t "gprof" "?")
                   " gmon=" (hash-ref t "gmon" "?")
                   " paranoid=" (hash-ref t "paranoid" "?"))))

(define (perf:protected spec)
  (let ((intend (hash-ref spec "intend" (hash))))
    (if (hash? intend) (hash-ref intend "protected" '()) '())))

; Propose the whole order, drop protected sites, then honor per-round.
; Refusals are audit lines. They are not trials.
(define (perf:budget-left spec buf)
  (let ((cap (hash-ref (perf:intend-seal spec) "budget" 0))
        (used (hash-ref buf "budget" 0)))
    (if (or (not (number? cap)) (<= cap 0))
        100
        (let ((left (- cap used)))
          (if (< left 0) 0 left)))))

(define (perf:round-candidates spec plan buf)
  (let* ((wide (hash "order" (perf:order-of plan) "per-round" 100))
         (raw (perf:rule-propose (perf:catalog spec) (hash "plan" wide)))
         (split (perf:split-protected raw (perf:protected spec)))
         (filtered (perf:filter-negative (hash-ref split "ok" '())
                                         (hash-ref buf "memory" '())
                                         (hash-ref spec "class" "")
                                         (hash-ref spec "hot-node" "")))
         (k0 (let ((n (hash-ref plan "per-round" 1)))
               (if (and (number? n) (> n 0)) n 1)))
         (k (let ((left (perf:budget-left spec buf)))
              (if (< left k0) left k0))))
    (let loop ((xs (hash-ref split "refused" '())))
      (if (null? xs)
          #t
          (begin
            (perf:say buf (string-append "expert-refuse "
                                         (hash-ref (car xs) "id" "?")
                                         " site="
                                         (hash-ref (car xs) "target"
                                                   (hash-ref (car xs) "site" "?"))))
            (perf:note buf "reject" (hash-ref (car xs) "id" "?") "protected")
            (perf:bump buf "rollback")
            (perf:audit-decision (hash-ref (car xs) "target" "protected")
                                 "ROLLBACK" "protected-define"
                                 (hash "id" (hash-ref (car xs) "id" "")
                                       "class" (hash-ref spec "class" "")
                                       "hot-node" (hash-ref spec "hot-node" "")))
            (hash-set! buf "memory"
                       (perf:neg-remember (hash-ref buf "memory" '())
                                          (hash-ref spec "class" "")
                                          (hash-ref spec "hot-node" "")
                                          (hash-ref (car xs) "id" "")
                                          "protected"))
            (hash-set! buf "refused"
                       (cons (hash-ref (car xs) "id" "")
                             (hash-ref buf "refused" '())))
            (hash-set! buf "results"
                       (append (hash-ref buf "results" '())
                               (list (hash "id" (hash-ref (car xs) "id" "")
                                           "target" (hash-ref (car xs) "target"
                                                              (hash-ref (car xs) "site" ""))
                                           "status" "refused"
                                           "checksum-ok" 1
                                           "mismatches" 0
                                           "heldout-ms" -1
                                           "fidelity" "not-tried"
                                           "live-unchanged" 1))))
            (loop (cdr xs)))))
    (let loop ((xs (hash-ref filtered "skipped" '())))
      (if (null? xs)
          #t
          (begin
            (perf:say buf (string-append "negative-skip "
                                         (hash-ref (car xs) "id" "?")
                                         " class=" (hash-ref spec "class" "")
                                         " hot-node=" (hash-ref spec "hot-node" "")))
            (loop (cdr xs)))))
    (perf:take (hash-ref filtered "ok" '()) k)))

(define (perf:choose-winner spec results best plan child hottest out buf baseline pct)
  (if best
      best
      (if (perf:any-infra? results)
          (begin
            (perf:say buf "strategy ROLLBACK reason=trial-infrastructure")
            (perf:bump buf "rollback")
            #f)
          (let ((failed (append (hash-ref buf "refused" '())
                                (perf:failed-ids results baseline pct))))
            (let ((next (perf:revise-order (perf:order-of plan) failed)))
              (let ((plan2 (perf:commit-strategy spec next buf)))
                (if (not plan2)
                    #f
                    (let ((cands2 (perf:round-candidates spec plan2 buf)))
                      (perf:say buf (string-append "round 2 candidates " (perf:ids cands2)))
                      (hash-set! buf "budget"
                                 (+ (hash-ref buf "budget" 0) (length cands2)))
                      (let ((results2 (perf:trial-round spec cands2 out buf baseline)))
                        (if (perf:any-infra? results2)
                            (begin
                              (perf:say buf "round 2 aborted: trial infrastructure")
                              #f)
                            (perf:best-passing results2 baseline pct)))))))))))

(define (perf:say-each buf lines)
  (let loop ((xs lines))
    (if (null? xs)
        #t
        (begin
          (perf:say buf (car xs))
          (loop (cdr xs))))))

(define (perf:run-kernel spec n)
  (let ((f (hash-ref spec "call"))
        (xs (perf:range n)))
    (f xs)
    (f xs)
    (f xs)))

(define (perf:confirm spec buf profile)
  (let ((bin (hash-ref (hash-ref profile "tools" (hash)) "perf" "missing"))
        (cmd (hash-ref spec "perf-after" "")))
    (if (or (< (hash-ref buf "keep" 0) 1)
            (not (string? bin)) (string=? bin "missing")
            (not (string? cmd)) (string=? cmd ""))
        #f
        (let* ((text (perf:stat-text bin cmd "/tmp/aura-perf-after.txt"))
               (counters (perf:parse-perf-stat text))
               (after-clock (hash-ref counters "task-clock" -1))
               (before-node (perf:cct-node (hash-ref profile "cct" (hash)) "bench-kernel"))
               (before-clock (if (hash? before-node)
                                 (hash-ref before-node "task-clock" -1)
                                 -1))
               (after-cct (perf:cct-build
                            (list (hash "name" "bench-kernel"
                                        "task-clock" after-clock
                                        "page-faults" (hash-ref counters "page-faults" 0)
                                        "stack" (list "bench-kernel")
                                        "calls" 1))))
               (rows (perf:cct-delta (hash-ref profile "cct" (hash)) after-cct))
               (live (perf:measure-live bin (lambda () (perf:run-kernel spec 4000)))))
          (perf:say buf (string-append "perf-before-task-clock-ms "
                                       (number->string before-clock)))
          (perf:say buf (string-append "perf-after-task-clock-ms "
                                       (number->string after-clock)))
          (let loop ((xs rows))
            (if (null? xs)
                #t
                (let ((h (car xs)))
                  (perf:say buf (string-append
                                  "cct-delta " (hash-ref h "id" "?")
                                  " before-ms=" (number->string (hash-ref h "before-ms" 0))
                                  " after-ms=" (number->string (hash-ref h "after-ms" 0))
                                  " delta-ms=" (number->string (hash-ref h "delta-ms" 0))))
                  (loop (cdr xs)))))
          (perf:say buf (string-append "perf-live-after-task-clock-ms "
                                       (number->string (hash-ref live "task-clock" -1))))
          (if (and (number? before-clock) (> before-clock 0)
                   (number? after-clock) (> after-clock 0)
                   (< after-clock before-clock))
              (perf:say buf "hypothesis-confirmed linear-scan lower-task-clock")
              (perf:say buf "hypothesis-unconfirmed"))))))

(define (perf:say-intend spec buf before-ms after-ms)
  (let* ((intend (hash-ref spec "intend" (hash)))
         (pct (hash-ref intend "min-faster-pct" 10))
         (met (perf:speedup-ok? before-ms after-ms pct)))
    (perf:say buf (string-append "intend min-faster-pct=" (number->string pct)
                                 " checksum=1 protected="
                                 (perf:join (hash-ref intend "protected" '()) ",")))
    (perf:say buf (string-append "intend-met " (if met "1" "0")))))

(define (perf:finish spec buf profile child out)
  (let ((after-profile (perf:collect ((hash-ref spec "regions-fn"))
                                     (hash "repeats" (hash-ref spec "profile-repeats" 3)))))
    (let ((delta (perf:delta profile after-profile)))
      (let ((after-ms (hash-ref buf "after-ms" -1)))
        (let ((before-ms (hash-ref buf "before-ms" -1)))
          (perf:say buf (string-append "after-heldout-ms " (number->string after-ms)
                                       " samples=" (perf:sample-text (hash-ref buf "after-samples" '()))))
          (perf:say buf (string-append "speedup-x " (perf:fmt-x before-ms after-ms)))
          (perf:confirm spec buf profile)
          (perf:say buf (string-append "budget-used " (number->string (hash-ref buf "budget" 0))))
          (perf:say-intend spec buf before-ms after-ms)
          (perf:say buf (string-append "profile-elapsed-before-ms "
                                       (number->string (hash-ref delta "elapsed-before-ms" 0))
                                       " profile-elapsed-after-ms "
                                       (number->string (hash-ref delta "elapsed-after-ms" 0))))
          (perf:say-each buf (let loop ((xs (hash-ref delta "hotspots" '())) (acc '()))
                               (if (null? xs)
                                   (reverse acc)
                                   (let ((h (car xs)))
                                     (loop (cdr xs)
                                           (cons (string-append
                                                   "delta " (hash-ref h "name" "?")
                                                   " before-ms=" (number->string (hash-ref h "before-ms" 0))
                                                   " after-ms=" (number->string (hash-ref h "after-ms" 0))
                                                   " delta-ms=" (number->string (hash-ref h "delta-ms" 0)))
                                                 acc))))))
          (perf:say buf (string-append "decisions KEEP=" (number->string (hash-ref buf "keep" 0))
                                       " ROLLBACK=" (number->string (hash-ref buf "rollback" 0))))
          (perf:say buf (string-append "mutation-records "
                                       (number->string (length (perf:mutation-records)))))
          (let ((logn (try (length (evo:records)) (catch (e) -1))))
            (perf:say buf (string-append "evo-records " (number->string logn))))
          (let ((verdict (string-append
                           "verdict intend-met=" (if (perf:speedup-ok? before-ms after-ms
                                                                      (hash-ref (perf:intend-seal spec) "min-faster-pct" 10))
                                                     "1" "0")
                           " KEEP=" (number->string (hash-ref buf "keep" 0))
                           " ROLLBACK=" (number->string (hash-ref buf "rollback" 0))
                           " speedup-x=" (perf:fmt-x before-ms after-ms)
                           "\n"
                           (perf:join (hash-ref buf "brief" '()) "\n")
                           "\n")))
            (perf:say buf "----")
            (display verdict)
            (perf:write-text (string-append out "/report.txt")
                             (string-append verdict (perf:join (hash-ref buf "lines" '()) "\n") "\n"))
            (perf:write-text (string-append out "/summary.json")
                             (json-encode (hash "before-ms" before-ms
                                                "after-ms" after-ms
                                                "keep" (hash-ref buf "keep" 0)
                                                "rollback" (hash-ref buf "rollback" 0)
                                                "hot-child" child
                                                "intend-met" (if (perf:speedup-ok? before-ms after-ms
                                                                                  (hash-ref (perf:intend-seal spec) "min-faster-pct" 10))
                                                                 1 0)
                                                "speedup-x" (perf:fmt-x before-ms after-ms))))
            (perf:write-text (string-append out "/evidence.json")
                             (json-encode (hash "before-ms" before-ms
                                                "after-ms" after-ms
                                                "class" (hash-ref spec "class" "")
                                                "hot-node" (hash-ref spec "hot-node" "")
                                                "prefix" (hash-ref spec "prefix" '())
                                                "cct" (hash-ref spec "profile-cct" (hash))
                                                "candidates" (hash-ref buf "results" '())
                                                "memory" (hash-ref buf "memory" '()))))))
          (if (not (eq? (hash-ref spec "require-success" #f) #t))
              buf
              (let ((expect (hash-ref spec "expect-child" "")))
                (if (and (or (string=? expect "") (string=? child expect))
                         (>= (hash-ref buf "keep" 0) 1)
                         (>= (hash-ref buf "rollback" 0) 1)
                         (perf:speedup-ok? before-ms after-ms 50))
                    buf
                    (error (string-append
                             "example did not meet the held-out bar: hot-child="
                             child
                             " keep=" (number->string (hash-ref buf "keep" 0))
                             " rollback=" (number->string (hash-ref buf "rollback" 0))
                             " before=" (number->string before-ms)
                             " after=" (number->string after-ms))))))))))

(define (perf:say-list buf lines)
  (let loop ((xs (if (list? lines) lines '())))
    (if (null? xs)
        #t
        (begin (perf:say buf (car xs)) (loop (cdr xs))))))

(define (perf:record-gene-rollbacks buf picked)
  (let loop ((xs (hash-ref picked "verdicts" '())))
    (if (null? xs)
        #t
        (let ((v (car xs)))
          (perf:say buf (string-append "strategy-gene " (hash-ref v "id" "?")
                                       " " (hash-ref v "decision" "?")
                                       " reason=" (hash-ref v "reason" "")))
          (if (string=? (hash-ref v "decision" "") "ROLLBACK")
              (begin
                (perf:bump buf "rollback")
                (perf:note buf "reject" (hash-ref v "id" "?") (hash-ref v "reason" ""))
                (perf:audit-decision "perf-strategy" "ROLLBACK"
                                     (hash-ref v "reason" "")
                                     (hash "id" (hash-ref v "id" ""))))
              #t)
          (loop (cdr xs))))))

(define (perf:install-mine spec profile gene seal)
  (let ((g (if (hash? gene) gene (hash "ratio" 2 "actionable-ms" 1 "per-round" 2)))
        (prot (hash-ref seal "protected" '())))
    (let ((mined (perf:mine-with profile g prot)))
      (hash-set! spec "profile" profile)
      (hash-set! spec "profile-cct" (hash-ref profile "cct" #f))
      (hash-set! spec "class" (hash-ref mined "class" ""))
      (hash-set! spec "hot-node" (hash-ref mined "hot-node" ""))
      (hash-set! spec "prefix" (hash-ref mined "prefix" '()))
      (hash-set! spec "gene-mine" (lambda (p) (perf:mine-with p g prot)))
      (hash-set! spec "strategy-per-round" (let ((n (hash-ref g "per-round" 2)))
                                             (if (and (number? n) (> n 0)) n 2)))
      mined)))

(define (perf:opening-plan spec buf profile seal)
  (let ((picked (perf:select-gene profile (hash-ref spec "genes" '()) seal)))
    (perf:record-gene-rollbacks buf picked)
    (let ((gene (hash-ref picked "winner" #f)))
      (perf:install-mine spec profile gene seal)
      (if (hash? gene)
          (let ((plan (perf:commit-strategy spec (hash-ref gene "order" '()) buf)))
            (if plan
                plan
                (perf-strategy (hash "profile" profile
                                     "mine" (hash-ref spec "gene-mine" perf:mine)
                                     "hot-child-fn" perf:hot-child))))
          (perf-strategy (hash "profile" profile
                               "mine" (hash-ref spec "gene-mine" perf:mine)
                               "hot-child-fn" perf:hot-child))))))

(define (perf:measure-screen spec buf)
  (let ((n (hash-ref spec "screen-n" 0)))
    (if (and (number? n) (> n 0))
        (let ((tm (perf:time-checked 1 (hash-ref spec "call") (perf:range n))))
          (hash-set! spec "screen-baseline-ms" (hash-ref tm "median" -1))
          (perf:say buf (string-append "screen-baseline-ms "
                                       (number->string (hash-ref tm "median" -1))
                                       " n=" (number->string n))))
        #f)))

(define (perf:say-machine buf)
  (let ((info (try (perf:sysinfo) (catch (e) #f))))
    (if (not (hash? info))
        (perf:say buf "machine skipped")
        (begin
          (hash-set! buf "machine" info)
          (perf:say-list buf (perf:take (perf:sysinfo-lines info) 3))
          (perf:say-list buf (perf:take (perf:advice-lines (perf:advice info (hash))) 1))))))

(define (perf:report-worldlines spec buf)
  (let ((ids (perf:cct-cleared (hash-ref buf "results" '())
                               (hash-ref spec "profile-cct" #f)
                               (hash-ref spec "prefix" '()))))
    (perf:say buf (string-append "cleared " (if (null? ids) "none" (perf:join ids ","))))
    (perf:say buf (string-append "negative-query class=" (hash-ref spec "class" "")
                                 " hot-node=" (hash-ref spec "hot-node" "")
                                 " blocked=" (perf:neg-ideas (hash-ref buf "memory" '())
                                                             (hash-ref spec "class" "")
                                                             (hash-ref spec "hot-node" ""))))
    (perf:say buf (string-append "negative-blocked same-hot="
                                 (if (perf:neg-blocked? (hash-ref buf "memory" '())
                                                        (hash-ref spec "class" "")
                                                        (hash-ref spec "hot-node" "")
                                                        "wrong-scale")
                                     "1" "0")
                                 " other-hot="
                                 (if (perf:neg-blocked? (hash-ref buf "memory" '())
                                                        (hash-ref spec "class" "")
                                                        "other-node"
                                                        "wrong-scale")
                                     "1" "0")))))

(define (perf:after-keep spec buf winner baseline out)
  (let ((q (perf:cct-worldline-query (hash-ref spec "profile-cct" #f)
                                     (if (hash? winner) (hash-ref winner "cct" #f) #f)
                                     (hash-ref spec "prefix" '()))))
    (perf:say buf (string-append "continue " (if (perf:should-continue? q) "1" "0")))
    (if (and (hash? winner)
             (= (hash-ref winner "prefix-removed" 0) 1)
             (= (hash-ref winner "cost-moved" 0) 0))
        (perf:say buf "hypothesis-confirmed prefix-cleared cost-stayed")
        #f)
    (if (not (perf:should-continue? q))
        #f
        (let ((mined (perf:mine-with (hash "cct" (hash-ref winner "cct" #f))
                                     (hash "ratio" 2 "actionable-ms" 1)
                                     (perf:protected spec))))
          (perf:say buf (string-append "continue-mined class=" (hash-ref mined "class" "")
                                       " hot-node=" (hash-ref mined "hot-node" "")
                                       " hypotheses=" (number->string (length (hash-ref mined "hypotheses" '())))))
          (if (or (null? (hash-ref mined "hypotheses" '()))
                  (<= (perf:budget-left spec buf) 0))
              #f
              (begin
                (hash-set! spec "class" (hash-ref mined "class" ""))
                (hash-set! spec "hot-node" (hash-ref mined "hot-node" ""))
                (hash-set! spec "prefix" (hash-ref mined "prefix" '()))
                (hash-set! spec "profile-cct" (hash-ref winner "cct" #f))
                (let* ((plan (hash "order" (let loop ((xs (hash-ref mined "hypotheses" '())) (acc '()))
                                             (if (null? xs)
                                                 (reverse acc)
                                                 (loop (cdr xs) (cons (hash-ref (car xs) "id" "") acc))))
                                   "per-round" 1))
                       (cands (perf:round-candidates spec plan buf)))
                  (perf:say buf (string-append "continue candidates " (perf:ids cands)))
                  (hash-set! buf "budget" (+ (hash-ref buf "budget" 0) (length cands)))
                  (perf:trial-round spec cands out buf baseline))))))))

(define (perf:optimize spec)
  (let ((buf (hash "lines" '() "brief" '() "memory" '() "results" '()
                   "keep" 0 "rollback" 0 "after-ms" -1 "budget" 0))
        (out (hash-ref spec "out-dir" "out")))
    (perf:ensure-dirs out)
    (hash-set! spec "min-speedup-pct"
               (perf:gate-pct (hash-ref spec "min-speedup-pct" 20)
                              (hash-ref (perf:intend-seal spec) "min-faster-pct" 10)))
    (if (not (perf:install-seed (hash-ref spec "seed-path")))
        (perf:say buf "error empty-seed")
        (let* ((profile (perf:collect ((hash-ref spec "regions-fn"))
                                      (hash "repeats" (hash-ref spec "profile-repeats" 3)
                                            "targets" (hash-ref spec "perf-targets" '()))))
               (child (perf:hot-child profile))
               (hottest (perf:hottest profile))
               (seal (perf:intend-seal spec))
               (plan (perf:opening-plan spec buf profile seal))
               (ctx (hash "plan" plan
                          "profile" profile
                          "hot-child" child
                          "hottest" hottest
                          "hotspots" (perf:hotspots profile)))
               (llm (perf:llm-propose ctx))
               (base (perf:baseline spec))
               (baseline (hash-ref base "median" -1))
               (pct (hash-ref spec "min-speedup-pct" 20)))
          (hash-set! buf "before-ms" baseline)
          (hash-set! buf "before-samples" (hash-ref base "samples" '()))
          (hash-set! buf "profile" profile)
          (perf:say buf "aura-perf sum-scan")
          (perf:say buf (perf:tool-line profile))
          (let loop ((xs (perf:note-lines profile)))
            (if (null? xs) #t (begin (perf:say buf (car xs)) (loop (cdr xs)))))
          (let loop ((xs (perf:hotspot-lines profile)))
            (if (null? xs) #t (begin (perf:say buf (car xs)) (loop (cdr xs)))))
          (let loop ((xs (perf:counter-lines profile)))
            (if (null? xs) #t (begin (perf:say buf (car xs)) (loop (cdr xs)))))
          (perf:say buf (string-append "hottest " hottest))
          (perf:say buf (string-append "hot-child " child))
          (let ((pinfo (hash-ref profile "perf" (hash))))
            (perf:say buf (string-append "perf-record-samples "
                                         (number->string (hash-ref pinfo "record-samples" -1))
                                         " event=" (hash-ref pinfo "record-event" ""))))
          (perf:say buf (string-append "mined class=" (hash-ref plan "class" "")
                                       " hot-node=" (hash-ref plan "hotspot" "")
                                       " site=" (hash-ref plan "site" "")))
          (perf:say buf (string-append "prefix " (perf:join (hash-ref spec "prefix" (hash-ref plan "prefix" '())) ">")))
          (perf:say buf (string-append "strategy-order"
                                       (perf:join (map (lambda (s) (string-append " " s))
                                                       (perf:order-of plan))
                                                  "")))
          (perf:say buf (string-append "llm-proposer " (hash-ref llm "error" "?")))
          (perf:say buf (string-append "baseline-heldout-ms " (number->string baseline)
                                       " samples=" (perf:sample-text (hash-ref base "samples" '()))))
          (perf:say-machine buf)
          (perf:measure-screen spec buf)
          (let ((bin (hash-ref (hash-ref profile "tools" (hash)) "perf" "missing")))
            (if (and (string? bin) (not (string=? bin "missing")))
                (let ((live (perf:measure-live bin (lambda () (perf:run-kernel spec 4000)))))
                  (perf:say buf (string-append "perf-live-before-task-clock-ms "
                                               (number->string (hash-ref live "task-clock" -1)))))
                #f))
          (let* ((cands (perf:round-candidates spec plan buf))
                 (results (begin
                            (perf:say buf (string-append "round 1 candidates " (perf:ids cands)))
                            (hash-set! buf "budget"
                                       (+ (hash-ref buf "budget" 0) (length cands)))
                            (perf:trial-round spec cands out buf baseline)))
                 (best (perf:best-passing results baseline pct)))
            (let ((winner (perf:choose-winner spec results best plan child hottest out buf baseline pct)))
              (if (not winner)
                  (perf:say buf "kernel unchanged")
                  (let ((entry (perf:entry (perf:catalog spec) (hash-ref winner "id" ""))))
                    (if entry
                        (perf:commit-kernel spec entry baseline buf)
                        (perf:say buf "kernel ROLLBACK reason=missing-catalog-entry"))))
              (perf:report-worldlines spec buf)
              (perf:after-keep spec buf winner baseline out)
              (perf:finish spec buf profile child out)))))))

; One entry. The caller supplies an intend and a target. The runtime
; mines, proposes, trials, and stops when the intend holds or the
; strategy has no remaining candidate.
(define (perf:autotune spec)
  (perf:optimize spec))
