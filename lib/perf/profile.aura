; Profiler evidence as Aura data.
; Live collection uses region timers (millisecond monotonic clock),
; /proc/self/stat ticks, and engine:metrics. Linux perf and gprof are
; used when they actually produce output; otherwise the tool status
; records why they were not used. Parsers also run on saved text so the
; perf/gprof path is testable without the binaries.
;
; A one-shot target is `perf stat -- <command>`. A live C server is a pid
; or a soname (`libaura_redis_core.so`): perf attaches, and the CCT node
; is that process's function, not the DSO filename and not an Aura
; interpreter symbol. Aura stays the runtime.

(export perf:parse-perf-report perf:parse-perf-stat perf:parse-gprof
        perf:parse-proc-stat perf:unsupported-events perf:record-samples
        perf:report-event perf:report-cct-rows perf:profile-targets
        perf:select-child perf:find-bin perf:tool-status perf:read-proc
        perf:engine-snap perf:collect perf:hottest perf:hot-child
        perf:measure-live perf:compile-snap perf:compile-delta
        perf:region-sample perf:statm-resident)

(require "std/string" all:)
(require "std/process" all:)
(require "std/engine-metrics" all:)
(require "lib/perf/util" all:)
(require "lib/perf/cct" all:)

(define perf-event-names
  (list "task-clock" "cpu-clock" "cycles" "instructions" "cache-references"
        "cache-misses" "branches" "branch-misses" "context-switches"
        "cpu-migrations" "page-faults" "minor-faults" "major-faults"))

(define (perf:event-name? t)
  (perf:member? perf-event-names t))

(define (perf:skip-report-line? line)
  (or (string=? line "")
      (string-prefix? (string-trim line) "#")))

; `[.]` / `[k]` annotation, or a bracketed kernel module.
(define (perf:bracket-token? t)
  (and (string? t)
       (>= (string-length t) 3)
       (= (perf:char-at t 0) 91)
       (= (perf:char-at t (- (string-length t) 1)) 93)))

; Shared object or kernel image. This is a column, not a CCT node.
(define (perf:so-name? t)
  (and (string? t)
       (or (string-contains? t ".so")
           (string-prefix? t "[kernel")
           (string=? t "[vdso]")
           (string=? t "[vsyscall]"))))

; Overhead and sample counts. `17.90%` parses as a number; so does `58`.
(define (perf:number-token? t)
  (and (string? t) (number? (perf:parse-number t))))

; A function token: letter or underscore, and not a DSO or annotation.
(define (perf:symbol-token? t)
  (and (string? t)
       (> (string-length t) 0)
       (not (perf:bracket-token? t))
       (not (perf:so-name? t))
       (not (perf:number-token? t))
       (let ((c (perf:char-at t 0)))
         (or (and (>= c 65) (<= c 90))
             (and (>= c 97) (<= c 122))
             (= c 95)))))

; `ar_entry_set_ex+0x20` is the function `ar_entry_set_ex`.
(define (perf:strip-offset name)
  (if (not (string? name))
      ""
      (let ((n (string-length name)))
        (let loop ((i 0))
          (if (> (+ i 2) (- n 1))
              name
              (if (and (= (perf:char-at name i) 43)
                       (= (perf:char-at name (+ i 1)) 48)
                       (or (= (perf:char-at name (+ i 2)) 120)
                           (= (perf:char-at name (+ i 2)) 88)))
                  (substring name 0 i)
                  (loop (+ i 1))))))))

; The interpreter binary is a column named `aura`, not a function.
(define (perf:interpreter-name? t)
  (and (string? t)
       (or (string=? t "aura")
           (string-suffix? t "/aura"))))

; Last function token. A trailing `aura` column is the interpreter
; binary (`-F symbol,dso` puts it after the symbol), so the previous
; function wins.
(define (perf:choose-symbol toks)
  (let loop ((xs (if (list? toks) toks '())) (prev #f) (last #f))
    (if (null? xs)
        (if (and (string? last) (perf:interpreter-name? last) (string? prev))
            prev
            last)
        (if (perf:symbol-token? (car xs))
            (loop (cdr xs) last (car xs))
            (loop (cdr xs) prev last)))))

(define (perf:find-so toks)
  (let loop ((xs (if (list? toks) toks '())))
    (if (null? xs)
        ""
        (if (perf:so-name? (car xs))
            (car xs)
            (loop (cdr xs))))))

; Default `perf report` prints `command  dso  [.]  symbol`. The DSO is the
; token before the annotation when it is not itself a `.so` (the `aura`
; interpreter binary). Field order `symbol,dso` puts the `.so` last; that
; path is perf:find-so.
(define (perf:dso-before-bracket toks)
  (let loop ((xs (if (list? toks) toks '())) (prev ""))
    (if (null? xs)
        ""
        (if (perf:bracket-token? (car xs))
            (if (and (string? prev)
                     (not (string=? prev ""))
                     (not (perf:number-token? prev))
                     (not (perf:bracket-token? prev)))
                prev
                "")
            (loop (cdr xs) (car xs))))))

(define (perf:find-interpreter toks)
  (let loop ((xs (if (list? toks) toks '())))
    (if (null? xs)
        ""
        (if (perf:interpreter-name? (car xs))
            (car xs)
            (loop (cdr xs))))))

(define (perf:row-dso toks)
  (let ((so (perf:find-so toks)))
    (if (not (string=? so ""))
        so
        (let ((bin (perf:find-interpreter toks)))
          (if (not (string=? bin ""))
              bin
              (perf:dso-before-bracket toks))))))

(define (perf:first-integer toks)
  (let loop ((xs (if (list? toks) toks '())))
    (if (null? xs)
        0
        (let ((t (car xs)))
          (if (and (perf:number-token? t)
                   (not (string-contains? t "."))
                   (not (string-contains? t "%")))
              (perf:parse-number t)
              (loop (cdr xs)))))))

; The name is the target function. A trailing DSO column is not the name.
; `self-ms` stays the overhead percent, matching the rows this parser
; already returned for the sum-scan fixture.
(define (perf:parse-perf-report text)
  (if (not (string? text))
      '()
      (let loop ((lines (string-split text "\n")) (acc '()))
        (if (null? lines)
            (reverse acc)
            (let ((line (car lines)))
              (if (perf:skip-report-line? line)
                  (loop (cdr lines) acc)
                  (let ((toks (perf:tokens line)))
                    (if (or (null? toks) (null? (cdr toks)))
                        (loop (cdr lines) acc)
                        (let ((pct (perf:parse-number (car toks)))
                              (raw (perf:choose-symbol toks)))
                          (if (and (number? pct) (string? raw))
                              (let ((name (perf:strip-offset raw)))
                                (if (string=? name "")
                                    (loop (cdr lines) acc)
                                    (loop (cdr lines)
                                          (cons (hash "name" name
                                                      "dso" (perf:row-dso toks)
                                                      "self-ms" pct
                                                      "incl-ms" pct
                                                      "samples" (perf:first-integer toks)
                                                      "calls" 0
                                                      "unit" "percent"
                                                      "source" "perf-report")
                                                acc))))
                              (loop (cdr lines) acc)))))))))))

; "# Samples: 324  of event 'cpu-clock'" -> cpu-clock. Header lines are
; skipped by the row parser; this scan keeps them.
(define (perf:trim-quotes s)
  (if (not (string? s))
      ""
      (let ((n (string-length s)))
        (let ((a (if (and (> n 0)
                          (or (= (perf:char-at s 0) 39)
                              (= (perf:char-at s 0) 34)))
                     1 0))
              (b (if (and (> n 1)
                          (or (= (perf:char-at s (- n 1)) 39)
                              (= (perf:char-at s (- n 1)) 34)))
                     (- n 1) n)))
          (if (>= b a) (substring s a b) s)))))

; Drop one trailing sentence period so a wrapped event name stays a token.
(define (perf:strip-trail-dot s)
  (if (and (string? s)
           (> (string-length s) 0)
           (= (perf:char-at s (- (string-length s) 1)) 46))
      (substring s 0 (- (string-length s) 1))
      s))

; Only the "# Samples: N of event '...'" line. Other lines can mention
; the word event (a comment, "Event count").
(define (perf:report-event text)
  (if (not (string? text))
      ""
      (let loop ((lines (string-split text "\n")))
        (if (null? lines)
            ""
            (if (not (string-contains? (car lines) "Samples:"))
                (loop (cdr lines))
                (let scan ((toks (perf:tokens (car lines))) (prev ""))
                  (cond ((null? toks) (loop (cdr lines)))
                        ((string=? prev "event")
                         (perf:strip-trail-dot (perf:trim-quotes (car toks))))
                        (else (scan (cdr toks) (car toks))))))))))

(define (perf:interpreter-dso? dso)
  (and (string? dso)
       (not (string=? dso ""))
       (or (string=? dso "aura")
           (string-suffix? dso "/aura")
           (string-contains? dso "ld-linux")
           (string-prefix? dso "[vdso]")
           (string=? dso "[vsyscall]"))))

(define (perf:system-dso? dso)
  (and (string? dso)
       (not (string=? dso ""))
       (or (string-contains? dso "libc.so")
           (string-contains? dso "libm.so")
           (string-contains? dso "libpthread")
           (string-contains? dso "libdl.so")
           (string-contains? dso "libstdc++")
           (string-contains? dso "libgcc_s")
           (string-prefix? dso "[kernel")
           (string=? dso "[vdso]")
           (string=? dso "[vsyscall]"))))

(define (perf:skip-symbol-name? name)
  (or (not (string? name))
      (string=? name "")
      (string=? name "aura")
      (string=? name "[unknown]")
      (string-prefix? name "[unknown]")
      (perf:so-name? name)))

; Keep the target program's functions. With a soname, only that object.
; Without one, drop the Aura interpreter binary, libc, and the kernel.
; An empty DSO (report without a DSO column) stays: the symbol is all
; the line gave us.
(define (perf:keep-symbol? row target)
  (let ((name (hash-ref row "name" ""))
        (dso (hash-ref row "dso" "")))
    (and (not (perf:skip-symbol-name? name))
         (if (and (string? target) (not (string=? target "")))
             (and (string? dso)
                  (not (string=? dso ""))
                  (string-contains? dso target))
             (and (not (perf:interpreter-dso? dso))
                  (not (perf:system-dso? dso)))))))

(define (perf:add-num! h key n)
  (let ((cur (hash-ref h key 0)))
    (hash-set! h key (+ (if (number? cur) cur 0) (if (number? n) n 0)))))

; One node per function. `ar_entry_set_ex` and `ar_entry_set_ex+0x20`
; already share a name; their overhead and samples add.
(define (perf:merge-symbol-rows rows)
  (let loop ((xs (if (list? rows) rows '())) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let* ((row (car xs))
               (name (hash-ref row "name" ""))
               (found (let scan ((ys acc))
                        (if (null? ys)
                            #f
                            (if (string=? (hash-ref (car ys) "name" "") name)
                                (car ys)
                                (scan (cdr ys)))))))
          (if (hash? found)
              (begin
                (perf:add-num! found "task-clock" (hash-ref row "task-clock" 0))
                (perf:add-num! found "calls" (hash-ref row "calls" 0))
                (perf:add-num! found "samples" (hash-ref row "samples" 0))
                (loop (cdr xs) acc))
              (loop (cdr xs) (cons row acc)))))))

; CCT rows from a perf report. `task-clock` holds the overhead percent so
; the miner can rank symbols with the same field as a sum-scan tree.
; `calls` holds the sample count. `native` marks a target-program symbol.
(define (perf:report-cct-rows text target)
  (let ((ev (perf:report-event text))
        (parsed (perf:parse-perf-report text))
        (want (if (string? target) target "")))
    (perf:merge-symbol-rows
      (let loop ((xs parsed) (acc '()))
        (if (null? xs)
            (reverse acc)
            (let ((row (car xs)))
              (if (not (perf:keep-symbol? row want))
                  (loop (cdr xs) acc)
                  (let ((name (hash-ref row "name" ""))
                        (samples (hash-ref row "samples" 0)))
                    (loop (cdr xs)
                          (cons (hash "name" name
                                      "dso" (hash-ref row "dso" "")
                                      "task-clock" (hash-ref row "self-ms" 0)
                                      "calls" (if (number? samples) samples 0)
                                      "samples" (if (number? samples) samples 0)
                                      "page-faults" 0
                                      "stack" (list name)
                                      "native" #t
                                      "source" "perf-report"
                                      "event" (if (string=? ev "") "cpu-clock" ev)
                                      "unit" "percent")
                                acc))))))))))

(define (perf:prev-number toks idx)
  (let loop ((i (- idx 1)))
    (if (< i 0)
        #f
        (let ((n (perf:parse-number (perf:nth toks i))))
          (if (number? n) n (loop (- i 1)))))))

(define (perf:parse-perf-stat text)
  (let ((h (hash)))
    (if (not (string? text))
        h
        (let loop ((lines (string-split text "\n")))
          (if (null? lines)
              h
              (let ((toks (perf:tokens (car lines))))
                (let scan ((i 0))
                  (if (< i (length toks))
                      (begin
                        (if (perf:event-name? (perf:nth toks i))
                            (let ((n (perf:prev-number toks i)))
                              (if (number? n)
                                  (hash-set! h (perf:nth toks i) n)
                                  #f))
                            #f)
                        (scan (+ i 1)))
                      #f))
                (loop (cdr lines))))))))

; Lines like "<not supported>      cycles". The wrapper splits on spaces,
; so the event name is the last token.
(define (perf:unsupported-events text)
  (if (not (string? text))
      '()
      (let loop ((lines (string-split text "\n")) (acc '()))
        (if (null? lines)
            (reverse acc)
            (let ((line (car lines)))
              (if (not (string-contains? line "not supported"))
                  (loop (cdr lines) acc)
                  (let ((toks (perf:tokens line)))
                    (let ((name (if (null? toks) "" (perf:nth toks (- (length toks) 1)))))
                      (if (and (string? name) (perf:event-name? name)
                               (not (perf:member? acc name)))
                          (loop (cdr lines) (append acc (list name)))
                          (loop (cdr lines) acc))))))))))

; "# Samples: 41  of event 'cpu-clock'"
; Skip "Total Lost Samples: 0", which also ends in Samples: <number>.
(define (perf:record-samples text)
  (if (not (string? text))
      -1
      (let loop ((lines (string-split text "\n")))
        (if (null? lines)
            -1
            (let scan ((toks (perf:tokens (car lines))) (prev ""))
              (cond ((null? toks) (loop (cdr lines)))
                    ((and (string=? (car toks) "Samples:")
                          (not (string=? prev "Lost"))
                          (pair? (cdr toks)))
                     (let ((n (perf:parse-number (car (cdr toks)))))
                       (if (number? n) n (loop (cdr lines)))))
                    (else (scan (cdr toks) (car toks)))))))))

; Among user defines that have a caller, the one with the largest
; perf task-clock is the hotspot the strategy should edit.
; Sum-scan children need a caller on the stack. A native symbol row is
; already the function to bind, so a one-frame stack still counts.
(define (perf:select-child rows)
  (let loop ((xs (if (list? rows) rows '())) (best "") (best-ms -1))
    (if (null? xs)
        best
        (let* ((h (car xs))
               (stack (hash-ref h "stack" '()))
               (ms (hash-ref h "task-clock" -1))
               (native (eq? (hash-ref h "native" #f) #t))
               (child (and (list? stack) (pair? stack) (pair? (cdr stack)))))
          (if (and (number? ms) (> ms best-ms) (or native child))
              (loop (cdr xs) (hash-ref h "name" "") ms)
              (loop (cdr xs) best best-ms))))))

(define (perf:header-tail? name)
  (or (string=? name "name")
      (string=? name "time")
      (string=? name "self")
      (string=? name "total")
      (string=? name "calls")))

(define (perf:symbol-start? name)
  (and (string? name)
       (> (string-length name) 0)
       (let ((c (perf:char-at name 0)))
         (or (and (>= c 65) (<= c 90))
             (and (>= c 97) (<= c 122))))))

(define (perf:parse-gprof text)
  (if (not (string? text))
      '()
      (let loop ((lines (string-split text "\n")) (acc '()))
        (if (null? lines)
            (reverse acc)
            (let ((toks (perf:tokens (car lines))))
              (if (or (null? toks) (null? (cdr toks)))
                  (loop (cdr lines) acc)
                  (let ((name (perf:nth toks (- (length toks) 1)))
                        (pct (perf:parse-number (car toks))))
                    (if (and (perf:symbol-start? name)
                             (not (perf:header-tail? name))
                             (not (perf:parse-number name))
                             (number? pct))
                        (loop (cdr lines)
                              (cons (hash "name" name
                                          "self-ms" pct
                                          "incl-ms" pct
                                          "calls" 0
                                          "unit" "percent"
                                          "source" "gprof")
                                    acc))
                        (loop (cdr lines) acc)))))))))

; /proc/self/stat: pid (comm) state ppid ... utime stime
; utime is the 12th field after the closing paren of comm (0-based index 11).
(define (perf:rparen text)
  (let ((n (string-length text)))
    (let loop ((i 0) (found -1))
      (if (>= i n)
          found
          (loop (+ i 1) (if (= (perf:char-at text i) 41) i found))))))

(define (perf:parse-proc-stat text)
  (if (not (string? text))
      #f
      (let ((rp (perf:rparen text)))
        (if (< rp 0)
            #f
            (let ((toks (perf:tokens (substring text (+ rp 1) (string-length text)))))
              (let ((u (perf:parse-number (perf:nth toks 11)))
                    (s (perf:parse-number (perf:nth toks 12))))
                (if (and (number? u) (number? s))
                    (hash "utime" u "stime" s)
                    #f)))))))

(define (perf:read-proc)
  (perf:parse-proc-stat (perf:read-text "/proc/self/stat")))

; std/string string-trim only strips ASCII space, not the newline read-file keeps.
(define (perf:trim-ws s)
  (if (not (string? s))
      ""
      (let ((n (string-length s)))
        (let lo ((i 0))
          (if (or (>= i n) (> (perf:char-at s i) 32))
              (let hi ((j n))
                (if (or (<= j i) (> (perf:char-at s (- j 1)) 32))
                    (substring s i j)
                    (hi (- j 1))))
              (lo (+ i 1)))))))

(define perf-stat-events
  "task-clock,cpu-clock,context-switches,cpu-migrations,page-faults,minor-faults,major-faults,cycles,instructions,cache-references,cache-misses,branches,branch-misses")

(define (perf:find-bin)
  (let ((out "/tmp/aura-perf-which.txt"))
    (shell (string-append "sh scripts/find-perf.sh > " out " 2>/dev/null"))
    (let ((s (perf:trim-ws (perf:read-text out))))
      (if (string=? s "") #f s))))

(define (perf:tool-status)
  (let ((perf-bin (perf:find-bin))
        (gprof-bin (which "gprof"))
        (gmon (perf:read-text "gmon.out"))
        (paranoid (perf:trim-ws (perf:read-text "/proc/sys/kernel/perf_event_paranoid"))))
    (hash "perf" (if (string? perf-bin) perf-bin "missing")
          "gprof" (if (and (string? gprof-bin) (not (string=? gprof-bin "")))
                      gprof-bin
                      "missing")
          "gmon" (if (string=? gmon "") "no-gmon" "present")
          "paranoid" paranoid)))

(define (perf:stat-text bin command outfile)
  (shell (string-append bin " stat -e " perf-stat-events
                        " -o " outfile " -- " command
                        " >/tmp/aura-perf-stat.stdout 2>/tmp/aura-perf-stat.stderr"))
  (perf:read-text outfile))

(define (perf:digits? s)
  (and (string? s)
       (> (string-length s) 0)
       (let ((n (string-length s)))
         (let loop ((i 0))
           (if (>= i n)
               #t
               (let ((c (perf:char-at s i)))
                 (and (>= c 48) (<= c 57) (loop (+ i 1)))))))))

; Soname spliced into a shell command. Dots and underscores only; no slash.
(define (perf:safe-soname? s)
  (and (string? s)
       (string-contains? s ".so")
       (let ((n (string-length s)))
         (and (> n 0)
              (let loop ((i 0))
                (if (>= i n)
                    #t
                    (let ((c (perf:char-at s i)))
                      (and (or (and (>= c 48) (<= c 57))
                               (and (>= c 65) (<= c 90))
                               (and (>= c 97) (<= c 122))
                               (= c 46) (= c 95) (= c 43) (= c 45))
                           (loop (+ i 1))))))))))

(define (perf:pid-string t)
  (let ((p (hash-ref t "pid" #f)))
    (cond ((and (number? p) (>= p 1))
           (let ((s (number->string p)))
             (if (perf:digits? s) s #f)))
          ((and (string? p) (perf:digits? p)) p)
          (else #f))))

(define (perf:target-dso t)
  (let ((d (hash-ref t "dso" "")))
    (if (perf:safe-soname? d)
        d
        (let ((s (hash-ref t "soname" "")))
          (if (perf:safe-soname? s)
              s
              (let ((n (hash-ref t "name" "")))
                (if (and (perf:safe-soname? n)
                         (not (string? (hash-ref t "command" #f))))
                    n
                    "")))))))

(define (perf:live-target? t)
  (or (string? (perf:pid-string t))
      (not (string=? (perf:target-dso t) ""))))

(define (perf:sample-seconds t)
  (let ((n (hash-ref t "seconds" 1)))
    (if (and (number? n) (>= n 1) (<= n 30) (perf:digits? (number->string n)))
        (number->string n)
        "1")))

(define (perf:pid-for-dso soname)
  (if (not (perf:safe-soname? soname))
      #f
      (begin
        (shell (string-append "sh scripts/find-pid-by-dso.sh " soname
                              " > /tmp/aura-perf-pid.txt 2>/dev/null"))
        (let ((s (perf:trim-ws (perf:read-text "/tmp/aura-perf-pid.txt"))))
          (if (perf:digits? s) s #f)))))

(define (perf:resolve-pid t)
  (let ((p (perf:pid-string t)))
    (if (string? p)
        p
        (perf:pid-for-dso (perf:target-dso t)))))

; Attach to a running process. `perf stat -- command` cannot see a server
; that is already listening. The report's symbol column, limited to the
; target soname, becomes the CCT rows.
(define (perf:attach-target bin t)
  (let ((pid (perf:resolve-pid t))
        (seconds (perf:sample-seconds t))
        (dso (perf:target-dso t)))
    (if (not (string? pid))
        (hash "rows" '() "unsupported" '() "counters" #f
              "samples" -1 "event" "" "error" "missing-pid")
        (begin
          (shell "rm -f out/perf.data out/perf-report.txt /tmp/aura-perf-stat-live.txt")
          (shell (string-append "mkdir -p out && " bin
                                " record -e cpu-clock -F 199 -p " pid
                                " -o out/perf.data -- sleep " seconds
                                " >/tmp/aura-perf-record.stdout 2>/tmp/aura-perf-record.stderr"))
          (shell (string-append bin
                                " report -i out/perf.data --stdio --no-children"
                                " -F overhead,sample,symbol,dso"
                                " > out/perf-report.txt 2>/tmp/aura-perf-report.stderr"))
          (shell (string-append bin " stat -p " pid " -e " perf-stat-events
                                " -o /tmp/aura-perf-stat-live.txt -- sleep " seconds
                                " >/tmp/aura-perf-stat.stdout 2>/tmp/aura-perf-stat.stderr"))
          (let ((text (perf:read-text "out/perf-report.txt"))
                (stat (perf:read-text "/tmp/aura-perf-stat-live.txt")))
            (hash "rows" (perf:report-cct-rows text dso)
                  "unsupported" (perf:unsupported-events stat)
                  "counters" (perf:parse-perf-stat stat)
                  "samples" (perf:record-samples text)
                  "event" (let ((ev (perf:report-event text)))
                            (if (string=? ev "") "cpu-clock" ev))
                  "error" ""))))))

(define (perf:push-rows rows more)
  (let loop ((ys (if (list? more) more '())) (acc rows))
    (if (null? ys)
        acc
        (loop (cdr ys) (cons (car ys) acc)))))

(define (perf:any-live? targets)
  (let loop ((xs (if (list? targets) targets '())))
    (if (null? xs)
        #f
        (if (perf:live-target? (car xs))
            #t
            (loop (cdr xs))))))

(define (perf:profile-targets bin targets)
  (let loop ((xs (if (list? targets) targets '()))
             (rows '()) (unsup '()) (bench #f)
             (samples -1) (event "") (err ""))
    (if (null? xs)
        (let ((ordered (reverse rows)))
          (if (perf:any-live? targets)
              (hash "rows" ordered
                    "child" (perf:select-child ordered)
                    "unsupported" unsup
                    "bench" bench
                    "record-samples" samples
                    "record-event" event
                    "attach-error" err)
              (let ((rec (perf:record-target bin targets)))
                (hash "rows" ordered
                      "child" (perf:select-child ordered)
                      "unsupported" unsup
                      "bench" bench
                      "record-samples" (hash-ref rec "samples" -1)
                      "record-event" (hash-ref rec "event" "")
                      "attach-error" ""))))
        (let ((t (car xs)))
          (if (perf:live-target? t)
              (let ((live (perf:attach-target bin t)))
                (loop (cdr xs)
                      (perf:push-rows rows (hash-ref live "rows" '()))
                      (perf:union-names unsup (hash-ref live "unsupported" '()))
                      (if (and (eq? (hash-ref t "workload" #f) #t)
                               (hash? (hash-ref live "counters" #f)))
                          (hash-ref live "counters")
                          bench)
                      (let ((n (hash-ref live "samples" -1)))
                        (if (and (number? n) (>= n 0)) n samples))
                      (let ((ev (hash-ref live "event" "")))
                        (if (string=? ev "") event ev))
                      (let ((e (hash-ref live "error" "")))
                        (if (string=? e "")
                            err
                            (if (string=? err "") e (string-append err "," e))))))
              (let* ((name (hash-ref t "name" "region"))
                     (outfile (string-append "/tmp/aura-perf-stat-" name ".txt"))
                     (text (perf:stat-text bin (hash-ref t "command" "true") outfile))
                     (counters (perf:parse-perf-stat text))
                     (row (hash "name" name
                                "task-clock" (hash-ref counters "task-clock" -1)
                                "cpu-clock" (hash-ref counters "cpu-clock" -1)
                                "page-faults" (hash-ref counters "page-faults" -1)
                                "stack" (hash-ref t "stack" (list name))
                                "calls" (hash-ref t "calls" 1)
                                "counters" counters)))
                (loop (cdr xs)
                      (cons row rows)
                      (perf:union-names unsup (perf:unsupported-events text))
                      (if (eq? (hash-ref t "workload" #f) #t) counters bench)
                      samples
                      event
                      err)))))))

(define (perf:union-names a b)
  (let loop ((xs (if (list? b) b '())) (acc (if (list? a) a '())))
    (if (null? xs)
        acc
        (if (perf:member? acc (car xs))
            (loop (cdr xs) acc)
            (loop (cdr xs) (append acc (list (car xs))))))))

(define (perf:record-target bin targets)
  (let ((cmd (let loop ((xs (if (list? targets) targets '())))
               (cond ((null? xs) #f)
                     ((eq? (hash-ref (car xs) "workload" #f) #t)
                      (hash-ref (car xs) "command" #f))
                     (else (loop (cdr xs)))))))
    (if (not (string? cmd))
        (hash "samples" -1 "event" "")
        (begin
          (shell (string-append "mkdir -p out && " bin
                                " record -e cpu-clock -F 199 -o out/perf.data -- "
                                cmd
                                " >/tmp/aura-perf-record.stdout 2>/tmp/aura-perf-record.stderr"))
          (shell (string-append bin
                                " report -i out/perf.data --stdio --no-children"
                                " -F overhead,sample,symbol,dso > out/perf-report.txt 2>/tmp/aura-perf-report.stderr"))
          (hash "samples" (perf:record-samples (perf:read-text "out/perf-report.txt"))
                "event" "cpu-clock")))))

; Attach perf stat to this process and run thunk while the window is open.
; task-clock is the target work's CPU time, not a fixed sleep.
(define (perf:measure-live bin thunk)
  (if (not (string? bin))
      (hash)
      (let ((pid (car (perf:tokens (perf:read-text "/proc/self/stat"))))
            (outf "/tmp/aura-perf-live.txt"))
        (shell (string-append "rm -f " outf "; " bin
                              " stat -p " pid
                              " -e task-clock,cpu-clock,page-faults,context-switches"
                              " -o " outf
                              " -- sleep 1.2 >/tmp/aura-perf-live.err 2>&1 &"))
        (shell "sleep 0.15")
        (try (thunk) (catch (e) #f))
        (shell "sleep 1.2")
        (perf:parse-perf-stat (perf:read-text outf)))))

(define (perf:engine-snap)
  (let ((ev (engine-metrics:group "eval"))
        (jt (engine-metrics:group "jit"))
        (mu (engine-metrics:group "mutate")))
    (hash "eval.hotpath_eval_flat_calls"
          (hash-ref ev "hotpath_eval_flat_calls" 0)
          "jit.jit_deopt_on_mutate_total"
          (hash-ref jt "jit_deopt_on_mutate_total" 0)
          "mutate.mutate_batches_started_total"
          (hash-ref mu "mutate_batches_started_total" 0))))

(define (perf:num h k)
  (let ((v (hash-ref h k 0)))
    (if (number? v) v 0)))

; Resident pages from /proc/self/statm (field 2). 0 when unreadable.
(define (perf:statm-resident)
  (let ((toks (perf:tokens (perf:read-text "/proc/self/statm"))))
    (let ((n (perf:parse-number (perf:nth toks 1))))
      (if (number? n) n 0))))

(define (perf:labeled-number text label)
  (if (not (string? text))
      #f
      (let loop ((lines (string-split text "\n")))
        (if (null? lines)
            #f
            (let ((toks (perf:tokens (car lines))))
              (if (and (pair? toks) (string=? (car toks) label) (pair? (cdr toks)))
                  (let ((n (perf:parse-number (car (cdr toks)))))
                    (if (number? n) n (loop (cdr lines))))
                  (loop (cdr lines))))))))

; A command is a fresh process. It prints `ms <median>` and `alloc <pages>`
; for the thunk only, so the parent's allocation history is not in the number.
(define (perf:region-command cmd)
  (let ((out "/tmp/aura-perf-region.out"))
    (shell (string-append cmd " > " out " 2>/tmp/aura-perf-region.err"))
    (let ((text (perf:read-text out))
          (ms (perf:labeled-number (perf:read-text out) "ms")))
      (hash "ms" (if (number? ms) ms -1)
            "alloc" (let ((a (perf:labeled-number text "alloc")))
                      (if (number? a) a 0))
            "measure" "fresh-child"))))

(define (perf:region-local region repeats)
  (let ((thunk (hash-ref region "thunk" #f))
        (n (if (and (number? repeats) (> repeats 0)) repeats 1))
        (before (perf:statm-resident)))
    (if (not thunk)
        (hash "ms" -1 "alloc" 0 "measure" "in-process")
        (begin
          (try (thunk) (catch (e) #f))
          (let loop ((i 0) (samples '()))
            (if (>= i n)
                (hash "ms" (perf:median-samples (reverse samples))
                      "alloc" (- (perf:statm-resident) before)
                      "measure" "in-process")
                (let ((t0 (monotonic-ms)))
                  (try (thunk) (catch (e) #f))
                  (loop (+ i 1) (cons (- (monotonic-ms) t0) samples)))))))))

; Prefer a fresh child when the region names a command. The in-process
; timer is the fallback and carries the resident-page delta.
(define (perf:region-sample region repeats)
  (let ((cmd (if (hash? region) (hash-ref region "command" #f) #f)))
    (if (and (string? cmd) (not (string=? cmd "")))
        (perf:region-command cmd)
        (perf:region-local (if (hash? region) region (hash)) repeats))))

(define (perf:region-time region repeats)
  (hash-ref (perf:region-sample region repeats) "ms" -1))

(define (perf:region-mode rows)
  (let loop ((xs (if (list? rows) rows '())) (saw-f #f) (saw-i #f))
    (if (null? xs)
        (cond ((and saw-f saw-i) "mixed")
              (saw-f "fresh-child")
              (else "in-process"))
        (let ((m (hash-ref (car xs) "measure" "in-process")))
          (loop (cdr xs)
                (or saw-f (string=? m "fresh-child"))
                (or saw-i (not (string=? m "fresh-child"))))))))

(define (perf:region-notes mode)
  (list
    (if (string=? mode "fresh-child")
        "regions: each region was timed in a fresh child, so the number is not this process's allocation history. alloc-pages is that child's resident delta."
        "regions: timed in this process. alloc-pages is the resident-page delta; a region after a large allocation measures the allocator as well as the thunk.")
    "held-out: timed in a trial child. Region times and held-out times come from different process states."))

(define (perf:median-samples samples)
  (if (null? samples)
      -1
      (let ((xs (sort samples <)))
        (list-ref xs (quotient (- (length xs) 1) 2)))))

(define (perf:sum-self hs)
  (let loop ((xs hs) (acc 0))
    (if (null? xs)
        acc
        (loop (cdr xs) (+ acc (hash-ref (car xs) "self-ms" 0))))))

(define (perf:with-share hs)
  (let ((total (perf:sum-self hs)))
    (let loop ((xs hs) (acc '()))
      (if (null? xs)
          (reverse acc)
          (let* ((h (car xs))
                 (ms (hash-ref h "self-ms" 0))
                 (share (if (> total 0) (quotient (* ms 100) total) 0)))
            (hash-set! h "share" share)
            (loop (cdr xs) (cons h acc)))))))

(define (perf:stacks-of hs)
  (let loop ((xs hs) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((h (car xs)))
          (loop (cdr xs)
                (cons (hash "frames" (hash-ref h "stack" (list (hash-ref h "name" "")))
                            "self-ms" (hash-ref h "self-ms" 0)
                            "name" (hash-ref h "name" ""))
                      acc))))))

(define (perf:counter-hash proc-before proc-after eng-before eng-after stat-counters)
  (let ((h (hash))
        (pb (if (hash? proc-before) proc-before (hash)))
        (pa (if (hash? proc-after) proc-after (hash))))
    (hash-set! h "proc.utime-ticks"
               (- (perf:num pa "utime") (perf:num pb "utime")))
    (hash-set! h "proc.stime-ticks"
               (- (perf:num pa "stime") (perf:num pb "stime")))
    (let loop ((ks (hash-keys eng-after)))
      (if (null? ks)
          #f
          (begin
            (hash-set! h (car ks)
                       (- (perf:num eng-after (car ks))
                          (perf:num eng-before (car ks))))
            (loop (cdr ks)))))
    (if (hash? stat-counters)
        (let loop2 ((ks (hash-keys stat-counters)))
          (if (null? ks)
              h
              (begin
                (hash-set! h (string-append "perf." (car ks))
                           (hash-ref stat-counters (car ks)))
                (loop2 (cdr ks)))))
        h)))

(define (perf:rows-native? rows)
  (let loop ((xs (if (list? rows) rows '())))
    (if (null? xs)
        #f
        (if (eq? (hash-ref (car xs) "native" #f) #t)
            #t
            (loop (cdr xs))))))

(define (perf:notes tools perf-info)
  (let ((perf-s (hash-ref tools "perf" "missing"))
        (gprof-s (hash-ref tools "gprof" "missing"))
        (gmon (hash-ref tools "gmon" "no-gmon"))
        (unsup (if (hash? perf-info) (hash-ref perf-info "unsupported" '()) '())))
    (let ((lines
            (list
              (if (string=? perf-s "missing")
                  "perf: no usable binary (the /usr/bin/perf wrapper often rejects a newer kernel). Target hotspots fall back to region timers."
                  (string-append "perf: using " perf-s " on the target program, not on the Aura interpreter"))
              (if (string=? perf-s "missing")
                  "perf: hardware counters were not read"
                  (if (null? unsup)
                      "perf: requested hardware events were accepted"
                      (string-append "perf: events not supported on this kernel: " (perf:join unsup ","))))
              (if (string=? gprof-s "missing")
                  "gprof: binary not on PATH"
                  (if (string=? gmon "no-gmon")
                      "gprof: binary present, no gmon.out; gprof was not applied to this run"
                      "gprof: gmon.out present"))
              "hotspots: user defines of the target program. When perf stat ran, the callee with the highest task-clock is the one the strategy edits."
              "stacks: caller chains of those defines. perf record samples confirm the target process was sampled; interpreter frames are not used as hotspot names.")))
      (let ((err (if (hash? perf-info) (hash-ref perf-info "attach-error" "") ""))
            (native (perf:rows-native? (if (hash? perf-info) (hash-ref perf-info "rows" '()) '()))))
        (if (and (string? err) (not (string=? err "")))
            (append lines (list (string-append "perf: attach failed: " err)))
            (if native
                (append lines
                        (list "hotspots: attached process. CCT nodes are target-program symbols; the DSO filename is not a node."))
                lines))))))

(define (perf:maybe-gprof tools)
  (if (and (string=? (hash-ref tools "gmon" "") "present")
           (not (string=? (hash-ref tools "gprof" "") "missing")))
      (let ((path (string-append "/tmp/aura-perf-gprof-" (number->string (monotonic-ms)) ".txt"))
            (code (shell (string-append (hash-ref tools "gprof") " > " path " 2>/tmp/aura-perf-gprof.err"))))
        (if (= code 0)
            (perf:parse-gprof (perf:read-text path))
            '()))
      '()))

(define (perf:region-rows raw)
  (let loop ((xs (if (list? raw) raw '())) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((h (car xs)))
          (loop (cdr xs)
                (cons (hash "name" (hash-ref h "name" "")
                            "task-clock" (hash-ref h "self-ms" 0)
                            "calls" (hash-ref h "calls" 1)
                            "page-faults" 0
                            "stack" (hash-ref h "stack" (list (hash-ref h "name" ""))))
                      acc))))))

(define (perf:collect regions opts)
  (let* ((o (if (hash? opts) opts (hash)))
         (repeats (let ((n (hash-ref o "repeats" 3)))
                    (if (and (number? n) (> n 0)) n 3)))
         (tools (perf:tool-status))
         (eng-before (perf:engine-snap))
         (proc-before (perf:read-proc))
         (t0 (monotonic-ms))
         (raw (let loop ((xs (if (list? regions) regions '())) (acc '()))
                (if (null? xs)
                    (reverse acc)
                    (let* ((r (car xs))
                           (sample (perf:region-sample r repeats)))
                      (loop (cdr xs)
                            (cons (hash "name" (hash-ref r "name" "region")
                                        "self-ms" (hash-ref sample "ms" -1)
                                        "incl-ms" 0
                                        "calls" (hash-ref r "calls" 1)
                                        "stack" (hash-ref r "stack" (list (hash-ref r "name" "region")))
                                        "unit" "ms"
                                        "source" "region-timer"
                                        "alloc-pages" (hash-ref sample "alloc" 0)
                                        "measure" (hash-ref sample "measure" "in-process")
                                        "workload" (eq? (hash-ref r "workload" #f) #t))
                                  acc))))))
         (t1 (monotonic-ms))
         (eng-after (perf:engine-snap))
         (proc-after (perf:read-proc))
         (hs (perf:with-share raw))
         (gprof-hs (perf:maybe-gprof tools))
         (region-hs (if (null? gprof-hs) hs (append hs gprof-hs)))
         (bin (hash-ref tools "perf" "missing"))
         (targets (hash-ref o "targets" '()))
         (pinfo (if (and (string? bin) (not (string=? bin "missing")) (pair? targets))
                    (perf:profile-targets bin targets)
                    (hash "rows" '() "child" "" "unsupported" '() "bench" #f
                          "record-samples" -1 "record-event" "")))
         (cct (let ((built (perf:cct-build (hash-ref pinfo "rows" '()))))
                (if (null? (hash-ref built "nodes" '()))
                    (perf:cct-build (perf:region-rows raw))
                    built)))
         (phs (perf:perf-hotspots (hash-ref pinfo "rows" '())))
         (merged (append region-hs phs)))
    (let loop ((xs merged))
      (if (null? xs)
          #f
          (begin
            (hash-set! (car xs) "incl-ms" (hash-ref (car xs) "self-ms" 0))
            (loop (cdr xs)))))
    (hash "kind" "perf-profile"
          "tool" (if (string=? (hash-ref pinfo "child" "") "")
                     "region-timer"
                     "perf-stat")
          "tools" tools
          "hotspots" merged
          "stacks" (perf:stacks-of merged)
          "counters" (perf:counter-hash proc-before proc-after eng-before eng-after
                                       (hash-ref pinfo "bench" #f))
          "elapsed-ms" (- t1 t0)
          "perf-child" (hash-ref pinfo "child" "")
          "cct" cct
          "perf" pinfo
          "region-measure" (perf:region-mode raw)
          "notes" (append (perf:notes tools pinfo)
                          (perf:region-notes (perf:region-mode raw))))))

(define (perf:perf-hotspots rows)
  (let loop ((xs (if (list? rows) rows '())) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((r (car xs)))
          (loop (cdr xs)
                (cons (hash "name" (hash-ref r "name" "")
                            "self-ms" (hash-ref r "task-clock" 0)
                            "incl-ms" (hash-ref r "task-clock" 0)
                            "calls" (hash-ref r "calls" 1)
                            "share" 0
                            "stack" (hash-ref r "stack" '())
                            "unit" "ms"
                            "source" "perf-stat")
                      acc))))))

(define (perf:hottest profile)
  (let ((hs (if (hash? profile) (hash-ref profile "hotspots" '()) '())))
    (let loop ((xs hs) (best "") (best-ms -1))
      (if (null? xs)
          best
          (let* ((h (car xs))
                 (ms (hash-ref h "self-ms" 0)))
            (if (and (string=? (hash-ref h "source" "") "region-timer")
                     (> ms best-ms))
                (loop (cdr xs) (hash-ref h "name" "") ms)
                (loop (cdr xs) best best-ms)))))))

; Hottest region whose declared stack has a caller. This is the child
; the strategy uses to pick a mutation family.
; engine:metrics after set-code aborts when the sandbox is restricted.
; The example exports AURA_SANDBOX=off. Otherwise the snap says unavailable.
(define (perf:compile-snap)
  (let ((s (getenv "AURA_SANDBOX")))
    (if (not (and (string? s) (string=? s "off")))
        (hash "available" 0)
        (let ((g (try (engine-metrics:group "compile") (catch (e) #f))))
          (if (not (hash? g))
              (hash "available" 0)
              (hash "available" 1
                    "relower-full" (hash-ref g "relower_full_called_count" 0)
                    "partial-funcs" (hash-ref g "relower_partial_funcs_saved_total" 0)
                    "cascade-full" (hash-ref g "cascade_full_count" 0)
                    "body-only" (hash-ref g "cascade_body_only_count" 0)
                    "dirty-recompiles" (hash-ref g "module_dirty_recompiles" 0)))))))

(define (perf:compile-sub after before key)
  (- (hash-ref after key 0) (hash-ref before key 0)))

(define (perf:compile-delta before after)
  (if (or (not (hash? before)) (not (hash? after))
          (not (= (hash-ref before "available" 0) 1))
          (not (= (hash-ref after "available" 0) 1)))
      (hash "available" 0 "world-rebuilt" -1
            "cascade-full" 0 "body-only" 0 "relower-full" 0 "dirty-recompiles" 0)
      (let ((cf (perf:compile-sub after before "cascade-full"))
            (dr (perf:compile-sub after before "dirty-recompiles")))
        (hash "available" 1
              "cascade-full" cf
              "body-only" (perf:compile-sub after before "body-only")
              "relower-full" (perf:compile-sub after before "relower-full")
              "partial-funcs" (perf:compile-sub after before "partial-funcs")
              "dirty-recompiles" dr
              "world-rebuilt" (if (or (> cf 0) (> dr 0)) 1 0)))))

(define (perf:hot-child profile)
  (let ((chosen (if (hash? profile) (hash-ref profile "perf-child" "") "")))
    (if (and (string? chosen) (not (string=? chosen "")))
        chosen
        (let ((hs (if (hash? profile) (hash-ref profile "hotspots" '()) '())))
          (let loop ((xs hs) (best "") (best-ms -1))
            (if (null? xs)
                best
                (let* ((h (car xs))
                       (stack (hash-ref h "stack" '()))
                       (ms (hash-ref h "self-ms" 0)))
                  (if (and (string=? (hash-ref h "source" "") "region-timer")
                           (list? stack) (pair? stack) (pair? (cdr stack))
                           (> ms best-ms))
                      (loop (cdr xs) (hash-ref h "name" "") ms)
                      (loop (cdr xs) best best-ms)))))))))
