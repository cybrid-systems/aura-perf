; Profiler evidence as Aura data.
; Live collection uses region timers (millisecond monotonic clock),
; /proc/self/stat ticks, and engine:metrics. Linux perf and gprof are
; used when they actually produce output; otherwise the tool status
; records why they were not used. Parsers also run on saved text so the
; perf/gprof path is testable without the binaries.

(export perf:parse-perf-report perf:parse-perf-stat perf:parse-gprof
        perf:parse-proc-stat perf:unsupported-events perf:record-samples
        perf:select-child perf:find-bin perf:tool-status perf:read-proc
        perf:engine-snap perf:collect perf:hottest perf:hot-child
        perf:measure-live perf:compile-snap perf:compile-delta)

(require "std/string" all:)
(require "std/process" all:)
(require "std/engine-metrics" all:)
(require "lib/perf/util" all:)
(require "lib/perf/cct" all:)

(define perf-event-names
  (list "task-clock" "cpu-clock" "cycles" "instructions" "cache-references"
        "cache-misses" "branches" "branch-misses" "context-switches"
        "cpu-migrations" "page-faults" "minor-faults" "major-faults"))

(define (perf:event-name? t)
  (perf:member? perf-event-names t))

(define (perf:skip-report-line? line)
  (or (string=? line "")
      (string-prefix? (string-trim line) "#")))

(define (perf:parse-perf-report text)
  (if (not (string? text))
      '()
      (let loop ((lines (string-split text "\n")) (acc '()))
        (if (null? lines)
            (reverse acc)
            (let ((line (car lines)))
              (if (perf:skip-report-line? line)
                  (loop (cdr lines) acc)
                  (let ((toks (perf:tokens line)))
                    (if (or (null? toks) (null? (cdr toks)))
                        (loop (cdr lines) acc)
                        (let ((pct (perf:parse-number (car toks)))
                              (name (perf:nth toks (- (length toks) 1))))
                          (if (and (number? pct) (string? name)
                                   (not (perf:parse-number name)))
                              (loop (cdr lines)
                                    (cons (hash "name" name
                                                "self-ms" pct
                                                "incl-ms" pct
                                                "calls" 0
                                                "unit" "percent"
                                                "source" "perf-report")
                                          acc))
                              (loop (cdr lines) acc)))))))))))

(define (perf:prev-number toks idx)
  (let loop ((i (- idx 1)))
    (if (< i 0)
        #f
        (let ((n (perf:parse-number (perf:nth toks i))))
          (if (number? n) n (loop (- i 1)))))))

(define (perf:parse-perf-stat text)
  (let ((h (hash)))
    (if (not (string? text))
        h
        (let loop ((lines (string-split text "\n")))
          (if (null? lines)
              h
              (let ((toks (perf:tokens (car lines))))
                (let scan ((i 0))
                  (if (< i (length toks))
                      (begin
                        (if (perf:event-name? (perf:nth toks i))
                            (let ((n (perf:prev-number toks i)))
                              (if (number? n)
                                  (hash-set! h (perf:nth toks i) n)
                                  #f))
                            #f)
                        (scan (+ i 1)))
                      #f))
                (loop (cdr lines))))))))

; Lines like "<not supported>      cycles". The wrapper splits on spaces,
; so the event name is the last token.
(define (perf:unsupported-events text)
  (if (not (string? text))
      '()
      (let loop ((lines (string-split text "\n")) (acc '()))
        (if (null? lines)
            (reverse acc)
            (let ((line (car lines)))
              (if (not (string-contains? line "not supported"))
                  (loop (cdr lines) acc)
                  (let ((toks (perf:tokens line)))
                    (let ((name (if (null? toks) "" (perf:nth toks (- (length toks) 1)))))
                      (if (and (string? name) (perf:event-name? name)
                               (not (perf:member? acc name)))
                          (loop (cdr lines) (append acc (list name)))
                          (loop (cdr lines) acc))))))))))

; "# Samples: 41  of event 'cpu-clock'"
; Skip "Total Lost Samples: 0", which also ends in Samples: <number>.
(define (perf:record-samples text)
  (if (not (string? text))
      -1
      (let loop ((lines (string-split text "\n")))
        (if (null? lines)
            -1
            (let scan ((toks (perf:tokens (car lines))) (prev ""))
              (cond ((null? toks) (loop (cdr lines)))
                    ((and (string=? (car toks) "Samples:")
                          (not (string=? prev "Lost"))
                          (pair? (cdr toks)))
                     (let ((n (perf:parse-number (car (cdr toks)))))
                       (if (number? n) n (loop (cdr lines)))))
                    (else (scan (cdr toks) (car toks)))))))))

; Among user defines that have a caller, the one with the largest
; perf task-clock is the hotspot the strategy should edit.
(define (perf:select-child rows)
  (let loop ((xs (if (list? rows) rows '())) (best "") (best-ms -1))
    (if (null? xs)
        best
        (let* ((h (car xs))
               (stack (hash-ref h "stack" '()))
               (ms (hash-ref h "task-clock" -1)))
          (if (and (list? stack) (pair? stack) (pair? (cdr stack))
                   (number? ms) (> ms best-ms))
              (loop (cdr xs) (hash-ref h "name" "") ms)
              (loop (cdr xs) best best-ms))))))

(define (perf:header-tail? name)
  (or (string=? name "name")
      (string=? name "time")
      (string=? name "self")
      (string=? name "total")
      (string=? name "calls")))

(define (perf:symbol-start? name)
  (and (string? name)
       (> (string-length name) 0)
       (let ((c (perf:char-at name 0)))
         (or (and (>= c 65) (<= c 90))
             (and (>= c 97) (<= c 122))))))

(define (perf:parse-gprof text)
  (if (not (string? text))
      '()
      (let loop ((lines (string-split text "\n")) (acc '()))
        (if (null? lines)
            (reverse acc)
            (let ((toks (perf:tokens (car lines))))
              (if (or (null? toks) (null? (cdr toks)))
                  (loop (cdr lines) acc)
                  (let ((name (perf:nth toks (- (length toks) 1)))
                        (pct (perf:parse-number (car toks))))
                    (if (and (perf:symbol-start? name)
                             (not (perf:header-tail? name))
                             (not (perf:parse-number name))
                             (number? pct))
                        (loop (cdr lines)
                              (cons (hash "name" name
                                          "self-ms" pct
                                          "incl-ms" pct
                                          "calls" 0
                                          "unit" "percent"
                                          "source" "gprof")
                                    acc))
                        (loop (cdr lines) acc)))))))))

; /proc/self/stat: pid (comm) state ppid ... utime stime
; utime is the 12th field after the closing paren of comm (0-based index 11).
(define (perf:rparen text)
  (let ((n (string-length text)))
    (let loop ((i 0) (found -1))
      (if (>= i n)
          found
          (loop (+ i 1) (if (= (perf:char-at text i) 41) i found))))))

(define (perf:parse-proc-stat text)
  (if (not (string? text))
      #f
      (let ((rp (perf:rparen text)))
        (if (< rp 0)
            #f
            (let ((toks (perf:tokens (substring text (+ rp 1) (string-length text)))))
              (let ((u (perf:parse-number (perf:nth toks 11)))
                    (s (perf:parse-number (perf:nth toks 12))))
                (if (and (number? u) (number? s))
                    (hash "utime" u "stime" s)
                    #f)))))))

(define (perf:read-proc)
  (perf:parse-proc-stat (perf:read-text "/proc/self/stat")))

; std/string string-trim only strips ASCII space, not the newline read-file keeps.
(define (perf:trim-ws s)
  (if (not (string? s))
      ""
      (let ((n (string-length s)))
        (let lo ((i 0))
          (if (or (>= i n) (> (perf:char-at s i) 32))
              (let hi ((j n))
                (if (or (<= j i) (> (perf:char-at s (- j 1)) 32))
                    (substring s i j)
                    (hi (- j 1))))
              (lo (+ i 1)))))))

(define perf-stat-events
  "task-clock,cpu-clock,context-switches,cpu-migrations,page-faults,minor-faults,major-faults,cycles,instructions,cache-references,cache-misses,branches,branch-misses")

(define (perf:find-bin)
  (let ((out "/tmp/aura-perf-which.txt"))
    (shell (string-append "sh scripts/find-perf.sh > " out " 2>/dev/null"))
    (let ((s (perf:trim-ws (perf:read-text out))))
      (if (string=? s "") #f s))))

(define (perf:tool-status)
  (let ((perf-bin (perf:find-bin))
        (gprof-bin (which "gprof"))
        (gmon (perf:read-text "gmon.out"))
        (paranoid (perf:trim-ws (perf:read-text "/proc/sys/kernel/perf_event_paranoid"))))
    (hash "perf" (if (string? perf-bin) perf-bin "missing")
          "gprof" (if (and (string? gprof-bin) (not (string=? gprof-bin "")))
                      gprof-bin
                      "missing")
          "gmon" (if (string=? gmon "") "no-gmon" "present")
          "paranoid" paranoid)))

(define (perf:stat-text bin command outfile)
  (shell (string-append bin " stat -e " perf-stat-events
                        " -o " outfile " -- " command
                        " >/tmp/aura-perf-stat.stdout 2>/tmp/aura-perf-stat.stderr"))
  (perf:read-text outfile))

(define (perf:profile-targets bin targets)
  (let loop ((xs (if (list? targets) targets '())) (rows '()) (unsup '()) (bench #f))
    (if (null? xs)
        (let* ((child (perf:select-child rows))
               (rec (perf:record-target bin targets)))
          (hash "rows" (reverse rows)
                "child" child
                "unsupported" unsup
                "bench" bench
                "record-samples" (hash-ref rec "samples" -1)
                "record-event" (hash-ref rec "event" "")))
        (let* ((t (car xs))
               (name (hash-ref t "name" "region"))
               (outfile (string-append "/tmp/aura-perf-stat-" name ".txt"))
               (text (perf:stat-text bin (hash-ref t "command" "true") outfile))
               (counters (perf:parse-perf-stat text))
               (row (hash "name" name
                          "task-clock" (hash-ref counters "task-clock" -1)
                          "cpu-clock" (hash-ref counters "cpu-clock" -1)
                          "page-faults" (hash-ref counters "page-faults" -1)
                          "stack" (hash-ref t "stack" (list name))
                          "calls" (hash-ref t "calls" 1)
                          "counters" counters)))
          (loop (cdr xs)
                (cons row rows)
                (perf:union-names unsup (perf:unsupported-events text))
                (if (eq? (hash-ref t "workload" #f) #t) counters bench))))))

(define (perf:union-names a b)
  (let loop ((xs (if (list? b) b '())) (acc (if (list? a) a '())))
    (if (null? xs)
        acc
        (if (perf:member? acc (car xs))
            (loop (cdr xs) acc)
            (loop (cdr xs) (append acc (list (car xs))))))))

(define (perf:record-target bin targets)
  (let ((cmd (let loop ((xs (if (list? targets) targets '())))
               (cond ((null? xs) #f)
                     ((eq? (hash-ref (car xs) "workload" #f) #t)
                      (hash-ref (car xs) "command" #f))
                     (else (loop (cdr xs)))))))
    (if (not (string? cmd))
        (hash "samples" -1 "event" "")
        (begin
          (shell (string-append "mkdir -p out && " bin
                                " record -e cpu-clock -F 199 -o out/perf.data -- "
                                cmd
                                " >/tmp/aura-perf-record.stdout 2>/tmp/aura-perf-record.stderr"))
          (shell (string-append bin
                                " report -i out/perf.data --stdio --no-children"
                                " -F overhead,sample > out/perf-report.txt 2>/tmp/aura-perf-report.stderr"))
          (hash "samples" (perf:record-samples (perf:read-text "out/perf-report.txt"))
                "event" "cpu-clock")))))

; Attach perf stat to this process and run thunk while the window is open.
; task-clock is the target work's CPU time, not a fixed sleep.
(define (perf:measure-live bin thunk)
  (if (not (string? bin))
      (hash)
      (let ((pid (car (perf:tokens (perf:read-text "/proc/self/stat"))))
            (outf "/tmp/aura-perf-live.txt"))
        (shell (string-append "rm -f " outf "; " bin
                              " stat -p " pid
                              " -e task-clock,cpu-clock,page-faults,context-switches"
                              " -o " outf
                              " -- sleep 1.2 >/tmp/aura-perf-live.err 2>&1 &"))
        (shell "sleep 0.15")
        (try (thunk) (catch (e) #f))
        (shell "sleep 1.2")
        (perf:parse-perf-stat (perf:read-text outf)))))

(define (perf:engine-snap)
  (let ((ev (engine-metrics:group "eval"))
        (jt (engine-metrics:group "jit"))
        (mu (engine-metrics:group "mutate")))
    (hash "eval.hotpath_eval_flat_calls"
          (hash-ref ev "hotpath_eval_flat_calls" 0)
          "jit.jit_deopt_on_mutate_total"
          (hash-ref jt "jit_deopt_on_mutate_total" 0)
          "mutate.mutate_batches_started_total"
          (hash-ref mu "mutate_batches_started_total" 0))))

(define (perf:num h k)
  (let ((v (hash-ref h k 0)))
    (if (number? v) v 0)))

(define (perf:region-time region repeats)
  (let ((thunk (hash-ref region "thunk" #f))
        (n (if (and (number? repeats) (> repeats 0)) repeats 1)))
    (if (not thunk)
        -1
        (begin
          (try (thunk) (catch (e) #f))
          (let loop ((i 0) (samples '()))
            (if (>= i n)
                (perf:median-samples (reverse samples))
                (let ((t0 (monotonic-ms)))
                  (try (thunk) (catch (e) #f))
                  (loop (+ i 1) (cons (- (monotonic-ms) t0) samples)))))))))

(define (perf:median-samples samples)
  (if (null? samples)
      -1
      (let ((xs (sort samples <)))
        (list-ref xs (quotient (- (length xs) 1) 2)))))

(define (perf:sum-self hs)
  (let loop ((xs hs) (acc 0))
    (if (null? xs)
        acc
        (loop (cdr xs) (+ acc (hash-ref (car xs) "self-ms" 0))))))

(define (perf:with-share hs)
  (let ((total (perf:sum-self hs)))
    (let loop ((xs hs) (acc '()))
      (if (null? xs)
          (reverse acc)
          (let* ((h (car xs))
                 (ms (hash-ref h "self-ms" 0))
                 (share (if (> total 0) (quotient (* ms 100) total) 0)))
            (hash-set! h "share" share)
            (loop (cdr xs) (cons h acc)))))))

(define (perf:stacks-of hs)
  (let loop ((xs hs) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((h (car xs)))
          (loop (cdr xs)
                (cons (hash "frames" (hash-ref h "stack" (list (hash-ref h "name" "")))
                            "self-ms" (hash-ref h "self-ms" 0)
                            "name" (hash-ref h "name" ""))
                      acc))))))

(define (perf:counter-hash proc-before proc-after eng-before eng-after stat-counters)
  (let ((h (hash))
        (pb (if (hash? proc-before) proc-before (hash)))
        (pa (if (hash? proc-after) proc-after (hash))))
    (hash-set! h "proc.utime-ticks"
               (- (perf:num pa "utime") (perf:num pb "utime")))
    (hash-set! h "proc.stime-ticks"
               (- (perf:num pa "stime") (perf:num pb "stime")))
    (let loop ((ks (hash-keys eng-after)))
      (if (null? ks)
          #f
          (begin
            (hash-set! h (car ks)
                       (- (perf:num eng-after (car ks))
                          (perf:num eng-before (car ks))))
            (loop (cdr ks)))))
    (if (hash? stat-counters)
        (let loop2 ((ks (hash-keys stat-counters)))
          (if (null? ks)
              h
              (begin
                (hash-set! h (string-append "perf." (car ks))
                           (hash-ref stat-counters (car ks)))
                (loop2 (cdr ks)))))
        h)))

(define (perf:notes tools perf-info)
  (let ((perf-s (hash-ref tools "perf" "missing"))
        (gprof-s (hash-ref tools "gprof" "missing"))
        (gmon (hash-ref tools "gmon" "no-gmon"))
        (unsup (if (hash? perf-info) (hash-ref perf-info "unsupported" '()) '())))
    (list
      (if (string=? perf-s "missing")
          "perf: no usable binary (the /usr/bin/perf wrapper often rejects a newer kernel). Target hotspots fall back to region timers."
          (string-append "perf: using " perf-s " on the target program, not on the Aura interpreter"))
      (if (string=? perf-s "missing")
          "perf: hardware counters were not read"
          (if (null? unsup)
              "perf: requested hardware events were accepted"
              (string-append "perf: events not supported on this kernel: " (perf:join unsup ","))))
      (if (string=? gprof-s "missing")
          "gprof: binary not on PATH"
          (if (string=? gmon "no-gmon")
              "gprof: binary present, no gmon.out; gprof was not applied to this run"
              "gprof: gmon.out present"))
      "hotspots: user defines of the target program. When perf stat ran, the callee with the highest task-clock is the one the strategy edits."
      "stacks: caller chains of those defines. perf record samples confirm the target process was sampled; interpreter frames are not used as hotspot names.")))

(define (perf:maybe-gprof tools)
  (if (and (string=? (hash-ref tools "gmon" "") "present")
           (not (string=? (hash-ref tools "gprof" "") "missing")))
      (let ((path (string-append "/tmp/aura-perf-gprof-" (number->string (monotonic-ms)) ".txt"))
            (code (shell (string-append (hash-ref tools "gprof") " > " path " 2>/tmp/aura-perf-gprof.err"))))
        (if (= code 0)
            (perf:parse-gprof (perf:read-text path))
            '()))
      '()))

(define (perf:region-rows raw)
  (let loop ((xs (if (list? raw) raw '())) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((h (car xs)))
          (loop (cdr xs)
                (cons (hash "name" (hash-ref h "name" "")
                            "task-clock" (hash-ref h "self-ms" 0)
                            "calls" (hash-ref h "calls" 1)
                            "page-faults" 0
                            "stack" (hash-ref h "stack" (list (hash-ref h "name" ""))))
                      acc))))))

(define (perf:collect regions opts)
  (let* ((o (if (hash? opts) opts (hash)))
         (repeats (let ((n (hash-ref o "repeats" 3)))
                    (if (and (number? n) (> n 0)) n 3)))
         (tools (perf:tool-status))
         (eng-before (perf:engine-snap))
         (proc-before (perf:read-proc))
         (t0 (monotonic-ms))
         (raw (let loop ((xs (if (list? regions) regions '())) (acc '()))
                (if (null? xs)
                    (reverse acc)
                    (let ((r (car xs)))
                      (loop (cdr xs)
                            (cons (hash "name" (hash-ref r "name" "region")
                                        "self-ms" (perf:region-time r repeats)
                                        "incl-ms" 0
                                        "calls" (hash-ref r "calls" 1)
                                        "stack" (hash-ref r "stack" (list (hash-ref r "name" "region")))
                                        "unit" "ms"
                                        "source" "region-timer"
                                        "workload" (eq? (hash-ref r "workload" #f) #t))
                                  acc))))))
         (t1 (monotonic-ms))
         (eng-after (perf:engine-snap))
         (proc-after (perf:read-proc))
         (hs (perf:with-share raw))
         (gprof-hs (perf:maybe-gprof tools))
         (region-hs (if (null? gprof-hs) hs (append hs gprof-hs)))
         (bin (hash-ref tools "perf" "missing"))
         (targets (hash-ref o "targets" '()))
         (pinfo (if (and (string? bin) (not (string=? bin "missing")) (pair? targets))
                    (perf:profile-targets bin targets)
                    (hash "rows" '() "child" "" "unsupported" '() "bench" #f
                          "record-samples" -1 "record-event" "")))
         (cct (let ((built (perf:cct-build (hash-ref pinfo "rows" '()))))
                (if (null? (hash-ref built "nodes" '()))
                    (perf:cct-build (perf:region-rows raw))
                    built)))
         (phs (perf:perf-hotspots (hash-ref pinfo "rows" '())))
         (merged (append region-hs phs)))
    (let loop ((xs merged))
      (if (null? xs)
          #f
          (begin
            (hash-set! (car xs) "incl-ms" (hash-ref (car xs) "self-ms" 0))
            (loop (cdr xs)))))
    (hash "kind" "perf-profile"
          "tool" (if (string=? (hash-ref pinfo "child" "") "")
                     "region-timer"
                     "perf-stat")
          "tools" tools
          "hotspots" merged
          "stacks" (perf:stacks-of merged)
          "counters" (perf:counter-hash proc-before proc-after eng-before eng-after
                                       (hash-ref pinfo "bench" #f))
          "elapsed-ms" (- t1 t0)
          "perf-child" (hash-ref pinfo "child" "")
          "cct" cct
          "perf" pinfo
          "notes" (perf:notes tools pinfo))))

(define (perf:perf-hotspots rows)
  (let loop ((xs (if (list? rows) rows '())) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((r (car xs)))
          (loop (cdr xs)
                (cons (hash "name" (hash-ref r "name" "")
                            "self-ms" (hash-ref r "task-clock" 0)
                            "incl-ms" (hash-ref r "task-clock" 0)
                            "calls" (hash-ref r "calls" 1)
                            "share" 0
                            "stack" (hash-ref r "stack" '())
                            "unit" "ms"
                            "source" "perf-stat")
                      acc))))))

(define (perf:hottest profile)
  (let ((hs (if (hash? profile) (hash-ref profile "hotspots" '()) '())))
    (let loop ((xs hs) (best "") (best-ms -1))
      (if (null? xs)
          best
          (let* ((h (car xs))
                 (ms (hash-ref h "self-ms" 0)))
            (if (and (string=? (hash-ref h "source" "") "region-timer")
                     (> ms best-ms))
                (loop (cdr xs) (hash-ref h "name" "") ms)
                (loop (cdr xs) best best-ms)))))))

; Hottest region whose declared stack has a caller. This is the child
; the strategy uses to pick a mutation family.
; engine:metrics after set-code aborts when the sandbox is restricted.
; The example exports AURA_SANDBOX=off. Otherwise the snap says unavailable.
(define (perf:compile-snap)
  (let ((s (getenv "AURA_SANDBOX")))
    (if (not (and (string? s) (string=? s "off")))
        (hash "available" 0)
        (let ((g (try (engine-metrics:group "compile") (catch (e) #f))))
          (if (not (hash? g))
              (hash "available" 0)
              (hash "available" 1
                    "relower-full" (hash-ref g "relower_full_called_count" 0)
                    "partial-funcs" (hash-ref g "relower_partial_funcs_saved_total" 0)
                    "cascade-full" (hash-ref g "cascade_full_count" 0)
                    "body-only" (hash-ref g "cascade_body_only_count" 0)
                    "dirty-recompiles" (hash-ref g "module_dirty_recompiles" 0)))))))

(define (perf:compile-sub after before key)
  (- (hash-ref after key 0) (hash-ref before key 0)))

(define (perf:compile-delta before after)
  (if (or (not (hash? before)) (not (hash? after))
          (not (= (hash-ref before "available" 0) 1))
          (not (= (hash-ref after "available" 0) 1)))
      (hash "available" 0 "world-rebuilt" -1
            "cascade-full" 0 "body-only" 0 "relower-full" 0 "dirty-recompiles" 0)
      (let ((cf (perf:compile-sub after before "cascade-full"))
            (dr (perf:compile-sub after before "dirty-recompiles")))
        (hash "available" 1
              "cascade-full" cf
              "body-only" (perf:compile-sub after before "body-only")
              "relower-full" (perf:compile-sub after before "relower-full")
              "partial-funcs" (perf:compile-sub after before "partial-funcs")
              "dirty-recompiles" dr
              "world-rebuilt" (if (or (> cf 0) (> dr 0)) 1 0)))))

(define (perf:hot-child profile)
  (let ((chosen (if (hash? profile) (hash-ref profile "perf-child" "") "")))
    (if (and (string? chosen) (not (string=? chosen "")))
        chosen
        (let ((hs (if (hash? profile) (hash-ref profile "hotspots" '()) '())))
          (let loop ((xs hs) (best "") (best-ms -1))
            (if (null? xs)
                best
                (let* ((h (car xs))
                       (stack (hash-ref h "stack" '()))
                       (ms (hash-ref h "self-ms" 0)))
                  (if (and (string=? (hash-ref h "source" "") "region-timer")
                           (list? stack) (pair? stack) (pair? (cdr stack))
                           (> ms best-ms))
                      (loop (cdr xs) (hash-ref h "name" "") ms)
                      (loop (cdr xs) best best-ms)))))))))
