; Re-score a saved run against the intend and strategy genes that
; are in the workspace now. No perf, no rebind, no child process.

(export perf:recheck perf:recheck-lines)

(require "lib/perf/util" all:)
(require "lib/perf/gate" all:)
(require "lib/perf/cct" all:)
(require "lib/perf/gene" all:)
(require "lib/perf/memory" all:)

(define (perf:on? v)
  (or (eq? v #t) (eq? v 1)))

(define (perf:recheck-one cand seal before-ms)
  (let ((id (hash-ref cand "id" "?"))
        (site (hash-ref cand "target" (hash-ref cand "site" "")))
        (pct (hash-ref seal "min-faster-pct" 10)))
    (cond ((perf:member? (hash-ref seal "protected" '()) site)
           (hash "id" id "decision" "reject" "reason" "protected"))
          ((string=? (hash-ref cand "status" "") "refused")
           (hash "id" id "decision" "reject" "reason" "not-tried"))
          ((or (string=? (hash-ref cand "fidelity" "") "checksum")
               (not (perf:on? (hash-ref cand "checksum-ok" 0)))
               (and (number? (hash-ref cand "mismatches" 0))
                    (> (hash-ref cand "mismatches" 0) 0)))
           (hash "id" id "decision" "reject" "reason" "checksum"))
          ((string=? (hash-ref cand "fidelity" "") "screen-pruned")
           (hash "id" id "decision" "reject" "reason" "screen-pruned"))
          ((not (string=? (hash-ref cand "status" "") "ok"))
           (hash "id" id "decision" "reject" "reason" "trial-error"))
          ((not (perf:speedup-ok? before-ms (hash-ref cand "heldout-ms" -1) pct))
           (hash "id" id "decision" "reject" "reason" "intend"))
          (else
           (hash "id" id "decision" "keep" "reason" "gate-pass")))))

(define (perf:recheck evidence intend genes)
  (if (not (hash? evidence))
      (hash "ok" #f "reason" "no-evidence" "lines" '("verdict no-evidence")
            "keep" 0 "rollback" 0 "intend-met" 0)
      (let* ((spec (hash "intend" (if (hash? intend) intend (hash))
                         "min-speedup-pct" (hash-ref (if (hash? intend) intend (hash))
                                                     "min-faster-pct" 10)))
             (seal (perf:intend-seal spec))
             (pct (hash-ref seal "min-faster-pct" 10))
             (before-ms (hash-ref evidence "before-ms" -1))
             (after-ms (hash-ref evidence "after-ms" -1))
             (profile (hash "cct" (hash-ref evidence "cct" (hash))))
             (picked (perf:select-gene profile
                                       (if (list? genes) genes '())
                                       seal))
             (cands (hash-ref evidence "candidates" '()))
             (scored (let loop ((xs (if (list? cands) cands '())) (acc '()))
                       (if (null? xs)
                           (reverse acc)
                           (loop (cdr xs)
                                 (cons (perf:recheck-one (car xs) seal before-ms) acc)))))
             (met (and (number? before-ms) (number? after-ms)
                       (perf:speedup-ok? before-ms after-ms pct))))
        (let score ((xs (append (hash-ref picked "verdicts" '()) scored))
                    (k 0) (r 0) (lines '()))
          (if (null? xs)
              (hash "ok" #t
                    "intend-met" (if met 1 0)
                    "keep" k
                    "rollback" r
                    "speedup-x" (perf:fmt-x before-ms after-ms)
                    "lines" (reverse lines)
                    "seal" seal)
              (let* ((v (car xs))
                     (kind (hash-ref v "decision" "reject"))
                     (keep? (or (string=? kind "KEEP") (string=? kind "keep")))
                     (word (if keep? "keep" "reject")))
                (score (cdr xs)
                       (+ k (if keep? 1 0))
                       (+ r (if keep? 0 1))
                       (cons (string-append word " "
                                            (hash-ref v "id" "?") " "
                                            (hash-ref v "reason" ""))
                             lines))))))))

(define (perf:recheck-lines evidence intend genes)
  (let ((r (perf:recheck evidence intend genes)))
    (if (not (eq? (hash-ref r "ok" #f) #t))
        (hash-ref r "lines" '())
        (cons (string-append "recheck intend-met="
                             (number->string (hash-ref r "intend-met" 0))
                             " KEEP=" (number->string (hash-ref r "keep" 0))
                             " ROLLBACK=" (number->string (hash-ref r "rollback" 0))
                             " " (perf:verdict-speedup
                                   (hash-ref evidence "before-ms" -1)
                                   (hash-ref evidence "after-ms" -1)
                                   (hash-ref evidence "before-samples" '())
                                   (hash-ref evidence "after-samples" '())))
              (hash-ref r "lines" '())))))
