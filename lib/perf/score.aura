; Reference oracle, held-out timing, and checksum checks.
; The oracle lives in this module, outside the mutable workspace, so a
; candidate cannot rewrite the function it is compared against.

(export perf:range perf:sum-ref perf:median perf:percentile perf:distribution
        perf:check-inputs perf:check-kernel perf:time-checked)

(require "lib/perf/sched" all:)

; Nearest-rank percentile. Samples are milliseconds; a tail reading is
; still a reading, not a reason to drop the sample.
(define (perf:percentile samples p)
  (if (or (not (list? samples)) (null? samples)
          (not (number? p)) (< p 0) (> p 100))
      -1
      (let* ((xs (sort (let loop ((ys samples) (acc '()))
                         (if (null? ys)
                             (reverse acc)
                             (loop (cdr ys) (cons (car ys) acc))))
                       <))
             (n (length xs))
             (rank (quotient (+ (* p n) 99) 100))
             (i (max 0 (min (- n 1) (- rank 1)))))
        (list-ref xs i))))

(define (perf:distribution samples)
  (if (or (not (list? samples)) (null? samples))
      (hash "n" 0 "p50" -1 "p90" -1 "p99" -1
            "min" -1 "max" -1 "spread" -1)
      (let* ((xs (sort (let loop ((ys samples) (acc '()))
                         (if (null? ys)
                             (reverse acc)
                             (loop (cdr ys) (cons (car ys) acc))))
                       <))
             (lo (car xs))
             (hi (list-ref xs (- (length xs) 1))))
        (hash "n" (length xs)
              "p50" (perf:percentile xs 50)
              "p90" (perf:percentile xs 90)
              "p99" (perf:percentile xs 99)
              "min" lo
              "max" hi
              "spread" (- hi lo)))))

(define (perf:range n)
  (if (or (not (number? n)) (<= n 0))
      '()
      (let loop ((i (- n 1)) (acc '()))
        (if (< i 0)
            acc
            (loop (- i 1) (cons i acc))))))

(define (perf:sum-ref xs)
  (let loop ((ys (if (list? xs) xs '())) (acc 0))
    (if (null? ys)
        acc
        (loop (cdr ys) (+ acc (car ys))))))

(define (perf:copy xs)
  (let loop ((ys xs) (acc '()))
    (if (null? ys) (reverse acc) (loop (cdr ys) (cons (car ys) acc)))))

(define (perf:median samples)
  (if (or (not (list? samples)) (null? samples))
      -1
      (let ((xs (sort (perf:copy samples) <)))
        (list-ref xs (quotient (- (length xs) 1) 2)))))

(define perf-check-inputs
  (list '()
        (list 4)
        (list 1 2 3)
        (list 1 -2 3)
        (list 10 0 10)))

(define (perf:check-inputs) perf-check-inputs)

; Optional trailing oracle. The default sums the input, which is the
; sum-scan target. A kernel that returns something else passes its own
; procedure; it stays outside the mutable workspace.
(define (perf:oracle-of rest)
  (if (and (pair? rest) (procedure? (car rest)))
      (car rest)
      perf:sum-ref))

(define (perf:check-kernel kernel cases . rest)
  (let ((oracle (perf:oracle-of rest)))
    (let loop ((cs (if (list? cases) cases '())) (bad 0) (n 0))
      (if (null? cs)
          (hash "ok" (= bad 0) "mismatches" bad "cases" n)
          (let* ((xs (car cs))
                 (got (try (kernel xs) (catch (e) 'perf-error)))
                 (exp (oracle xs)))
            (loop (cdr cs)
                  (+ bad (if (equal? got exp) 0 1))
                  (+ n 1)))))))

; Warm up once, then time `repeats` calls. Every sample must equal the oracle.
(define (perf:time-checked repeats kernel xs . rest)
  (let ((oracle (perf:oracle-of rest)))
    (let ((exp (oracle xs))
          (n (if (and (number? repeats) (> repeats 0)) repeats 1)))
      (try (kernel xs) (catch (e) #f))
      (let loop ((i 0) (samples '()) (bad 0) (scheds '()))
        (if (>= i n)
            (let ((ss (reverse samples)))
              (hash "median" (perf:median ss)
                    "samples" ss
                    "mismatches" bad
                    "expected" exp
                    "dist" (perf:distribution ss)
                    "sched" (perf:sched-summary (reverse scheds))))
            (let ((s0 (perf:sched-now))
                  (t0 (monotonic-ms)))
              (let ((got (try (kernel xs) (catch (e) 'perf-error))))
                (loop (+ i 1)
                      (cons (- (monotonic-ms) t0) samples)
                      (+ bad (if (equal? got exp) 0 1))
                      (cons (perf:sched-delta s0 (perf:sched-now)) scheds)))))))))
