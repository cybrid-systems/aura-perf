; Reference oracle, held-out timing, and checksum checks.
; The oracle lives in this module, outside the mutable workspace, so a
; candidate cannot rewrite the function it is compared against.

(export perf:range perf:sum-ref perf:median perf:check-inputs
        perf:check-kernel perf:time-checked)

(define (perf:range n)
  (if (or (not (number? n)) (<= n 0))
      '()
      (let loop ((i (- n 1)) (acc '()))
        (if (< i 0)
            acc
            (loop (- i 1) (cons i acc))))))

(define (perf:sum-ref xs)
  (let loop ((ys (if (list? xs) xs '())) (acc 0))
    (if (null? ys)
        acc
        (loop (cdr ys) (+ acc (car ys))))))

(define (perf:copy xs)
  (let loop ((ys xs) (acc '()))
    (if (null? ys) (reverse acc) (loop (cdr ys) (cons (car ys) acc)))))

(define (perf:median samples)
  (if (or (not (list? samples)) (null? samples))
      -1
      (let ((xs (sort (perf:copy samples) <)))
        (list-ref xs (quotient (- (length xs) 1) 2)))))

(define perf-check-inputs
  (list '()
        (list 4)
        (list 1 2 3)
        (list 1 -2 3)
        (list 10 0 10)))

(define (perf:check-inputs) perf-check-inputs)

(define (perf:check-kernel kernel cases)
  (let loop ((cs (if (list? cases) cases '())) (bad 0) (n 0))
    (if (null? cs)
        (hash "ok" (= bad 0) "mismatches" bad "cases" n)
        (let* ((xs (car cs))
               (got (try (kernel xs) (catch (e) 'perf-error)))
               (exp (perf:sum-ref xs)))
          (loop (cdr cs)
                (+ bad (if (equal? got exp) 0 1))
                (+ n 1))))))

; Warm up once, then time `repeats` calls. Every sample must equal the oracle.
(define (perf:time-checked repeats kernel xs)
  (let ((exp (perf:sum-ref xs))
        (n (if (and (number? repeats) (> repeats 0)) repeats 1)))
    (try (kernel xs) (catch (e) #f))
    (let loop ((i 0) (samples '()) (bad 0))
      (if (>= i n)
          (let ((ss (reverse samples)))
            (hash "median" (perf:median ss)
                  "samples" ss
                  "mismatches" bad
                  "expected" exp))
          (let ((t0 (monotonic-ms)))
            (let ((got (try (kernel xs) (catch (e) 'perf-error))))
              (loop (+ i 1)
                    (cons (- (monotonic-ms) t0) samples)
                    (+ bad (if (equal? got exp) 0 1)))))))))
