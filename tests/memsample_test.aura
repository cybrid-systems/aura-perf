(require "std/string" all:)
(require "lib/perf/memsample" all:)

(define (check label ok)
  (if ok #t (error (string-append "mem: " label))))

(define text "# Samples: 12K of event 'cpu/mem-loads,ldlat=30/P'\n# Overhead  Samples  Symbol\n# ........  .......  ......\n    12.34%     1234  foo\n     5.00%      500  [.] bar\n")
(define v (perf:mem-parse text))
(check "samples" (= (hash-ref v "samples" -1) 12000))
(check "event" (string=? (hash-ref v "event" "") "cpu/mem-loads,ldlat=30/P"))
(define rows (hash-ref v "rows" '()))
(check "two rows" (= (length rows) 2))
(check "first symbol" (string=? (hash-ref (car rows) "symbol" "") "foo"))
(check "first samples" (= (hash-ref (car rows) "samples" -1) 1234))
(check "first pct" (= (hash-ref (car rows) "overhead-pct" -1) 12.34))
(check "lines" (and (= (length (perf:mem-lines v)) 3)
                    (string-contains? (car (perf:mem-lines v)) "samples=12000")))
(display "mem ok")
(newline)
