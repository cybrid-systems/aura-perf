(require "lib/perf/util" all:)
(require "lib/perf/profile" all:)
(require "lib/perf/audit" all:)

(define (show v)
  (display v)
  (newline))

(define report (perf:parse-perf-report (perf:read-text "tests/fixtures/perf-report.txt")))
(define stat (perf:parse-perf-stat (perf:read-text "tests/fixtures/perf-stat.txt")))
(define gprof (perf:parse-gprof (perf:read-text "tests/fixtures/gprof.txt")))
(define gprof-real (perf:parse-gprof (perf:read-text "tests/fixtures/gprof-real.txt")))
(define proc (perf:parse-proc-stat (perf:read-text "tests/fixtures/proc-stat.txt")))
(define audit (perf:parse-audit-line (perf:read-text "tests/fixtures/audit-line.txt")))

(show (list (hash-ref (car report) "name")
            (hash-ref (car (cdr report)) "name")
            (hash-ref (car (cdr (cdr report))) "name")))
(show (list (hash-ref stat "task-clock")
            (hash-ref stat "cycles")
            (hash-ref stat "instructions")))
(show (list (hash-ref (car gprof) "name")
            (hash-ref (car (cdr gprof)) "name")
            (length gprof-real)
            (hash-ref (car gprof-real) "name")))
(show (list (hash-ref proc "utime") (hash-ref proc "stime")))
(show (list (hash-ref audit "op")
            (hash-ref audit "seq")
            (hash-ref audit "kind")))
(show (perf:record-samples
        "# Total Lost Samples: 0\n# Samples: 57  of event 'cpu-clock'\n"))
