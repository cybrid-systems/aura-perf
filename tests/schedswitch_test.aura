; sched_switch trace text -> per-task on/off-CPU values.
(require "std/string" all:)
(require "lib/perf/schedswitch" all:)

(define (check label ok)
  (if ok #t (error (string-append "schedswitch: " label))))

(define text "          <...>-1     [000] d..2  100.000000: sched_switch: prev_comm=aura prev_pid=1 prev_prio=120 prev_state=R ==> next_comm=worker next_pid=2 next_prio=120\n          <...>-2     [000] d..2  100.005000: sched_switch: prev_comm=worker prev_pid=2 prev_prio=120 prev_state=S ==> next_comm=aura next_pid=1 next_prio=120\n          <...>-1     [000] d..2  100.012000: sched_switch: prev_comm=aura prev_pid=1 prev_prio=120 prev_state=S ==> next_comm=idle next_pid=0 next_prio=120\n")
(define p (perf:schedswitch-parse text))
(check "event count" (= (hash-ref p "events" 0) 3))
(check "window" (= (hash-ref p "window-us" -1) 12000))
(define rows (hash-ref p "rows" '()))
(check "three tasks" (= (length rows) 3))
(define (row name)
  (let loop ((xs rows))
    (cond ((null? xs) #f)
          ((string=? (hash-ref (car xs) "task" "") name) (car xs))
          (else (loop (cdr xs))))))
(define aura (row "aura"))
(define worker (row "worker"))
(check "aura on" (= (hash-ref aura "on-ms" -1) 7))
(check "aura off" (= (hash-ref aura "off-ms" -1) 5))
(check "aura max off" (= (hash-ref aura "max-off-ms" -1) 5))
(check "aura switches" (= (hash-ref aura "switches" -1) 3))
(check "worker on" (= (hash-ref worker "on-ms" -1) 5))
(check "worker off" (= (hash-ref worker "off-ms" -1) 7))
(check "open task" (and aura (= (hash-ref aura "open" 0) 1)))
(check "line" (string-contains? (car (perf:schedswitch-lines rows)) "off-ms="))
(check "top by off" (string=? (hash-ref (car (perf:schedswitch-top rows 1)) "task" "") "worker"))
(display "schedswitch ok")
(newline)
