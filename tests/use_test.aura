; USE method: utilization, saturation and errors from /proc fixtures.
(require "std/string" all:)
(require "lib/perf/use" all:)

(define (check label ok)
  (if ok #t (error (string-append "use: " label))))

(define stat-a "cpu  10 0 5 80 5 0 0 0 0 0\ncpu0 5 0 2 40 3 0 0 0 0 0\ncpu1 5 0 3 40 2 0 0 0 0 0\nprocs_running 1\nprocs_blocked 0\n")
(define stat-b "cpu  30 0 10 150 10 0 0 0 0 0\ncpu0 15 0 5 75 5 0 0 0 0 0\ncpu1 15 0 5 75 5 0 0 0 0 0\nprocs_running 4\nprocs_blocked 2\n")
(define mem "MemTotal:       1000 kB\nMemAvailable:    200 kB\nSwapTotal:       100 kB\nSwapFree:          0 kB\n")
(define cpu (perf:use-cpu stat-a))
(check "cpu total" (= (hash-ref cpu "total" -1) 100))
(check "cpu idle" (= (hash-ref cpu "idle" -1) 85))
(check "cpu count" (= (perf:use-cpu-count stat-a) 2))
(check "procs running" (= (perf:use-proc-field stat-b "procs_running") 4))
(check "procs blocked" (= (perf:use-proc-field stat-b "procs_blocked") 2))
(check "mem available" (= (perf:use-mem-field mem "MemAvailable") 200))
(check "psi" (> (perf:use-psi "some avg10=12.50 avg60=3.00 total=42") 12))
(check "load" (= (hash-ref (perf:use-load "1.50 1.20 0.90 4/200 123") "runnable" -1) 4))

(define a (hash "cpu" (hash "total" 100 "busy" 15)
                 "cpus" 2 "running" 1 "blocked" 0 "load1" 1
                 "psi-cpu10" 1 "mem-total-kib" 1000 "mem-available-kib" 500
                 "swap-total-kib" 0 "swap-free-kib" 0
                 "psi-mem10" 0 "psi-io10" 1
                 "vm-swap-in" 0 "vm-swap-out" 0 "vm-scan-direct" 0
                 "vm-allocstall" 0))
(define b (hash "cpu" (hash "total" 200 "busy" 40)
                 "cpus" 2 "running" 4 "blocked" 2 "load1" 3
                 "psi-cpu10" 1 "mem-total-kib" 1000 "mem-available-kib" 200
                 "swap-total-kib" 100 "swap-free-kib" 0
                 "psi-mem10" 0 "psi-io10" 1
                 "vm-swap-in" 0 "vm-swap-out" 2 "vm-scan-direct" 0
                 "vm-allocstall" 0))
(define d (perf:use-delta a b))
(check "delta available" (= (hash-ref d "available" 0) 1))
(check "delta cpu util" (= (hash-ref (hash-ref d "cpu") "util-pct" -1) 25))
(check "cpu saturation is the runqueue" (string=? (hash-ref (hash-ref d "cpu") "sat" "") "saturated"))
(check "memory saturation is swap activity" (string=? (hash-ref (hash-ref d "memory") "sat" "") "saturated"))
(check "scheduler saturation is blocked" (string=? (hash-ref (hash-ref d "scheduler") "sat" "") "saturated"))
(check "live sample is a hash" (hash? (perf:use-sample)))
(check "USE lines" (and (= (length (perf:use-lines d)) 4)
                        (string? (car (perf:use-lines d)))))
(display "use ok")
(newline)
